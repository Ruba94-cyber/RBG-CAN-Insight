<Window x:Class="RbgCanInsight.App.SignalDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        xmlns:common="clr-namespace:RbgCanInsight.App.Common"
        xmlns:local="clr-namespace:RbgCanInsight.App"
        x:Name="Root"
        Title="Signal detail"
        Width="920"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <Window.Resources>
    <common:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <common:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding SignalName}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DatabaseName, StringFormat='DBC: {0}'}" Style="{StaticResource MutedText}" FontSize="11" />
          <TextBlock Style="{StaticResource MutedText}">
            <Run Text="{Binding Transmitter, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding MessageName, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding ChannelText, Mode=OneWay}" />
            <Run Text=" · ID 0x" />
            <Run Text="{Binding IdentifierHex, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding SampleCount, Mode=OneWay, StringFormat='{}{0:N0} samples'}" />
          </TextBlock>
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
          <Button x:Name="PlayPauseButton" Content="▶ Play" Click="OnPlayPauseClick" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="quickplot.playback"
                  MinWidth="72" ToolTip="Replay this signal window from the current time" />
          <Button Content="⏮" Click="OnHeadClick" Margin="0,0,4,0" ToolTip="Jump to trace start"
                  AutomationProperties.AutomationId="quickplot.head"
                  AutomationProperties.Name="Jump to trace start" />
          <Button Content="◀" Click="OnPreviousClick" Margin="0,0,4,0" ToolTip="Step back one window"
                  AutomationProperties.Name="Step back one window" />
          <Button Content="▶" Click="OnNextClick" Margin="0,0,4,0" ToolTip="Step forward one window"
                  AutomationProperties.Name="Step forward one window" />
          <Button Content="⏭" Click="OnTailClick" Margin="0,0,8,0" ToolTip="Jump to trace end"
                  AutomationProperties.AutomationId="quickplot.tail"
                  AutomationProperties.Name="Jump to trace end" />
          <TextBlock Text="Speed" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Width="76" Margin="0,0,8,0"
                    ItemsSource="{x:Static local:SignalDetailWindow.PlaybackSpeedChoices}"
                    SelectedItem="{Binding DetailPlaybackSpeed, ElementName=Root}"
                    ToolTip="Playback speed — shared with Trace, Signals &amp; Plot and Byte Matrix"
                    AutomationProperties.Name="Playback speed" />
          <Button Content="Fit" Click="OnFitClick" Margin="0,0,4,0" />
          <Button Content="10s" Click="OnPresetClick" Tag="10" Margin="0,0,4,0" />
          <Button Content="30s" Click="OnPresetClick" Tag="30" Margin="0,0,4,0" />
          <Button Content="60s" Click="OnPresetClick" Tag="60" Margin="0,0,8,0" />
          <CheckBox Content="Linear (visual)" IsChecked="{Binding DetailLinearInterpolation, ElementName=Root}"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="quickplot.linearInterpolation"
                    ToolTip="Visual straight-line interpolation only. Off = hold the last actually recorded CAN sample until the next frame." />
          <CheckBox Content="Cumulative" IsChecked="{Binding DetailCumulativeReveal, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Reveal this signal from the first sample up to the current playback time" />
          <TextBlock Text="Window" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBox Width="68" Text="{Binding DetailTimeWindowSeconds, ElementName=Root, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"
                   AutomationProperties.Name="Time window seconds" />
          <Button Content="Source frame" Click="OnOpenInTraceClick" Margin="0,0,4,0"
                  AutomationProperties.AutomationId="quickplot.sourceFrame"
                  AutomationProperties.Name="Open original recorded CAN source frame"
                  ToolTip="Open the original CAN frame supporting the value at the cursor in Trace. No future samples are inferred." />
          <ToggleButton x:Name="DetailsToggle" Content="Details" Margin="0,0,8,0"
                        IsChecked="{Binding DetailsExpanded, ElementName=Root}"
                        ToolTip="Show DBC description, scaling, value table and observed statistics" />
          <Button Content="Close" Click="OnCloseClick" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <controls:SignalPlotControl x:Name="Plot"
                                      AutomationProperties.AutomationId="quickplot.chart"
                                      AutomationProperties.Name="Quick Plot of the selected recorded signal"
                                      AutomationProperties.HelpText="Click to select X1; Shift-click or right-click for X2; mouse wheel zooms and Shift-wheel pans."
                                      IgnorePlottedFilter="True"
                                      LinearInterpolation="{Binding DetailLinearInterpolation, ElementName=Root}"
                                      TimeWindowSeconds="{Binding DetailTimeWindowSeconds, ElementName=Root}"
                                      WindowEndTimestampNanoseconds="{Binding DetailWindowEndNanoseconds, ElementName=Root}"
                                      CumulativeReveal="{Binding DetailCumulativeReveal, ElementName=Root}" />
        </Border>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <Slider DockPanel.Dock="Right"
                  Width="260"
                  Minimum="0"
                  Maximum="100"
                  Value="{Binding DetailTimelinePercent, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.AutomationId="quickplot.timeline"
                  ToolTip="Scrub the signal timeline"
                  AutomationProperties.Name="Scrub the signal timeline" />
          <TextBlock Text="{Binding DetailNavigationText, ElementName=Root}"
                     Style="{StaticResource MutedText}"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Grid>

      <Border Grid.Column="1" Width="300" Margin="10,0,0,0" Style="{StaticResource Card}" Padding="14"
              Visibility="{Binding DetailsExpanded, ElementName=Root, Converter={StaticResource VisibleWhenTrue}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="AT CURSOR" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Physical" Style="{StaticResource MutedText}" Margin="0,0,8,3" />
              <TextBlock Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="quickplot.cursor.physical" Text="{Binding DetailPhysicalText, ElementName=Root}" FontWeight="SemiBold" Margin="0,0,0,3" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Raw" Style="{StaticResource MutedText}" Margin="0,0,8,3" />
              <TextBlock Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="quickplot.cursor.raw" Text="{Binding DetailRawText, ElementName=Root}" Margin="0,0,0,3" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="State" Style="{StaticResource MutedText}" Margin="0,0,8,0" />
              <TextBlock Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="quickplot.cursor.state" Text="{Binding DetailStateText, ElementName=Root}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Source" Style="{StaticResource MutedText}" Margin="0,4,8,0" />
              <TextBlock Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="quickplot.cursor.source"
                         Text="{Binding DetailSourceAgeText, ElementName=Root}"
                         FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="DESCRIPTION" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding HasComment, Converter={StaticResource VisibleWhenTrue}}" />
            <TextBlock Text="No DBC comment for this signal." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding HasComment, Converter={StaticResource VisibleWhenFalse}}" />

            <TextBlock Text="SCALING &amp; BIT LAYOUT" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,12,0,6" />
            <TextBlock Text="{Binding ScalingText}" TextWrapping="Wrap" Margin="0,0,0,2" />
            <TextBlock Text="{Binding BitLayoutText}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />

            <TextBlock Text="RANGE" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,12,0,6" />
            <TextBlock Margin="0,0,0,2">
              <Run Text="Declared: " Foreground="{DynamicResource TextSecondaryBrush}" />
              <Run Text="{Binding DeclaredRangeText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock>
              <Run Text="Observed: " Foreground="{DynamicResource TextSecondaryBrush}" />
              <Run Text="{Binding ObservedRangeText, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="VALUE TABLE" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,12,0,6"
                       Visibility="{Binding HasValueTable, Converter={StaticResource VisibleWhenTrue}}" />
            <TextBlock Text="{Binding ValueTableText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                       Visibility="{Binding HasValueTable, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
