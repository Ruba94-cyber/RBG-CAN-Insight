<Window x:Class="RbgCanInsight.App.CompareDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        Title="Compare signal"
        Width="880" Height="560"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Close" Click="OnCloseClick" VerticalAlignment="Top" />
      </Grid>
    </Border>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <controls:CompareDiffChartControl x:Name="Chart" />
    </Border>
  </DockPanel>
</Window>
