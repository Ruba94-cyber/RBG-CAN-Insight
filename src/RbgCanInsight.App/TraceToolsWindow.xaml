<Window x:Class="RbgCanInsight.App.TraceToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trace tools"
        Width="640" Height="740" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Trace tools" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="Original files are never modified. Every result is written to a new file you choose." />
        <TextBlock x:Name="SourceText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                   AutomationProperties.AutomationId="traceTools.source" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="SaveButton" Content="Save as…" Click="OnSaveClick" Margin="0,0,8,0"
              AutomationProperties.AutomationId="traceTools.saveAs" AutomationProperties.Name="Save result as"
              ToolTip="Write the result to a new ASC, CSV, TRC, BLF or MF4 file" />
      <Button Content="Close" Click="OnCloseClick"
              AutomationProperties.AutomationId="traceTools.close" AutomationProperties.Name="Close trace tools" />
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="14">
      <!-- Scrolls when the window is smaller than the form so the Preview section is never cut off. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Operation" FontWeight="SemiBold" Margin="0,0,0,4" />
        <RadioButton x:Name="CutRadio" Content="Cut (keep a time range)" IsChecked="True" Checked="OnInputChanged"
                     AutomationProperties.AutomationId="traceTools.op.cut" AutomationProperties.Name="Cut" />
        <Grid Margin="22,4,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="From (s) " VerticalAlignment="Center" />
          <TextBox x:Name="FromBox" Grid.Column="1" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.cut.from" AutomationProperties.Name="Cut from seconds" />
          <TextBlock Grid.Column="2" Text="  To (s) " VerticalAlignment="Center" />
          <TextBox x:Name="ToBox" Grid.Column="3" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.cut.to" AutomationProperties.Name="Cut to seconds" />
        </Grid>

        <RadioButton x:Name="ShiftRadio" Content="Shift time" Checked="OnInputChanged"
                     AutomationProperties.AutomationId="traceTools.op.shift" AutomationProperties.Name="Shift time" />
        <StackPanel Orientation="Horizontal" Margin="22,4,0,10">
          <TextBlock Text="Shift by (s) " VerticalAlignment="Center" />
          <TextBox x:Name="ShiftBox" Width="90" Text="0" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.shift.seconds" AutomationProperties.Name="Shift seconds" />
          <TextBlock Text="  (negative moves earlier)" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>

        <RadioButton x:Name="SplitRadio" Content="Split at gaps" Checked="OnInputChanged"
                     AutomationProperties.AutomationId="traceTools.op.split" AutomationProperties.Name="Split at gaps" />
        <StackPanel Orientation="Horizontal" Margin="22,4,0,10">
          <TextBlock Text="Gap of at least (s) " VerticalAlignment="Center" />
          <TextBox x:Name="GapBox" Width="90" Text="1" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.split.gap" AutomationProperties.Name="Split gap seconds" />
        </StackPanel>

        <RadioButton x:Name="RemapRadio" Content="Remap channel" Checked="OnInputChanged"
                     AutomationProperties.AutomationId="traceTools.op.remap" AutomationProperties.Name="Remap channel" />
        <StackPanel Orientation="Horizontal" Margin="22,4,0,10">
          <TextBlock Text="From CAN " VerticalAlignment="Center" />
          <TextBox x:Name="ChFromBox" Width="50" Text="1" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.remap.from" AutomationProperties.Name="Remap from channel" />
          <TextBlock Text="  to CAN " VerticalAlignment="Center" />
          <TextBox x:Name="ChToBox" Width="50" Text="2" TextChanged="OnInputChanged"
                   AutomationProperties.AutomationId="traceTools.remap.to" AutomationProperties.Name="Remap to channel" />
        </StackPanel>

        <Separator Margin="0,4,0,8" />
        <TextBlock Text="Preview" FontWeight="SemiBold" />
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.AutomationId="traceTools.preview" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource MutedText}"
                   AutomationProperties.AutomationId="traceTools.result" />
      </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
