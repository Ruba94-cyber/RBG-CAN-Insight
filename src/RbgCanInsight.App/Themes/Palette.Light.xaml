<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== RBG CAN Insight brand tokens — Light ===== -->
  <!-- Accent/Warning/Error/Teal are deepened from the original brand hues (hue/saturation
       unchanged, only lightness) so each reaches >= 4.5:1 against the darkest surface this theme
       actually draws them on (the raised-panel/toast SurfaceRaisedColor below) — the previous
       values read as low as ~2.5:1 there, which ThemeContrastTests now guards against. -->
  <Color x:Key="BackgroundColor">#F2F4F7</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceRaisedColor">#E7EBF1</Color>
  <Color x:Key="SurfaceInputColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#D3D9E1</Color>
  <Color x:Key="AccentColor">#156BB6</Color>
  <Color x:Key="AccentSoftColor">#DCEEFF</Color>
  <Color x:Key="TealColor">#0A775A</Color>
  <Color x:Key="WarningColor">#8E600B</Color>
  <Color x:Key="ErrorColor">#BD3935</Color>
  <Color x:Key="TextPrimaryColor">#1B2029</Color>
  <Color x:Key="TextSecondaryColor">#5B6577</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentContrastTextBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#EAF0F7" />
  <SolidColorBrush x:Key="AlternateRowBrush" Color="#F5F7FA" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CBD6" />
  <SolidColorBrush x:Key="ChangedRowHighlightBrush" Color="#FFF3C4" />
  <SolidColorBrush x:Key="ChangedByteHighlightBrush" Color="#FDE9CC" />
  <SolidColorBrush x:Key="ChangedSignalHighlightBrush" Color="#D7F5EA" />
  <SolidColorBrush x:Key="ChangedByteMatrixCellBrush" Color="#FCE2B8" />

  <!-- Plot series palette: the same 8 hues as the dark theme, stepped for a white canvas, in a
       fixed order validated for colorblind-safe adjacent separation (Machado CVD dE >= 9.1,
       normal-vision dE >= 19.6). Slots 3/4/5 sit below 3:1 on white — acceptable because the
       plot always direct-labels every series in its persistent legend. -->
  <SolidColorBrush x:Key="PlotSeries1Brush" Color="#2A78D6" />
  <SolidColorBrush x:Key="PlotSeries2Brush" Color="#008300" />
  <SolidColorBrush x:Key="PlotSeries3Brush" Color="#E87BA4" />
  <SolidColorBrush x:Key="PlotSeries4Brush" Color="#EDA100" />
  <SolidColorBrush x:Key="PlotSeries5Brush" Color="#1BAF7A" />
  <SolidColorBrush x:Key="PlotSeries6Brush" Color="#EB6834" />
  <SolidColorBrush x:Key="PlotSeries7Brush" Color="#4A3AA7" />
  <SolidColorBrush x:Key="PlotSeries8Brush" Color="#E34948" />

  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#E4E8EE" />
  <SolidColorBrush x:Key="CanvasTextBrush" Color="#1F2733" />
  <!-- Paired UDS / CAN traces are rendered on the light evidence canvas even
       in dark theme. Use contrast-checked, differentiated dark hues rather
       than the low-contrast orange previously hard-coded in the plot. -->
  <SolidColorBrush x:Key="CorrelationDidBrush" Color="#1555A5" />
  <SolidColorBrush x:Key="CorrelationCanBrush" Color="#995100" />
  <SolidColorBrush x:Key="CanvasLabelBrush" Color="#F0F2F5" />

</ResourceDictionary>
