<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== RBG CAN Insight brand tokens — High Contrast ===== -->
  <Color x:Key="BackgroundColor">#000000</Color>
  <Color x:Key="SurfaceColor">#0A0A0A</Color>
  <Color x:Key="SurfaceRaisedColor">#161616</Color>
  <Color x:Key="SurfaceInputColor">#000000</Color>
  <Color x:Key="BorderColor">#E0E0E0</Color>
  <Color x:Key="AccentColor">#FFD400</Color>
  <Color x:Key="AccentSoftColor">#4D4100</Color>
  <Color x:Key="TealColor">#00E5C4</Color>
  <Color x:Key="WarningColor">#FF9900</Color>
  <Color x:Key="ErrorColor">#FF4040</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#D0D0D0</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentContrastTextBrush" Color="#000000" />

  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#262626" />
  <SolidColorBrush x:Key="AlternateRowBrush" Color="#121212" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#808080" />
  <SolidColorBrush x:Key="ChangedRowHighlightBrush" Color="#4D4100" />
  <SolidColorBrush x:Key="ChangedByteHighlightBrush" Color="#3D2A00" />
  <SolidColorBrush x:Key="ChangedSignalHighlightBrush" Color="#003D33" />
  <SolidColorBrush x:Key="ChangedByteMatrixCellBrush" Color="#3D2A00" />

  <!-- Same validated hue order as the other themes; the canvas is white in every theme, with
       pure black ink here for maximum contrast. -->
  <SolidColorBrush x:Key="PlotSeries1Brush" Color="#2A78D6" />
  <SolidColorBrush x:Key="PlotSeries2Brush" Color="#008300" />
  <SolidColorBrush x:Key="PlotSeries3Brush" Color="#E87BA4" />
  <SolidColorBrush x:Key="PlotSeries4Brush" Color="#EDA100" />
  <SolidColorBrush x:Key="PlotSeries5Brush" Color="#1BAF7A" />
  <SolidColorBrush x:Key="PlotSeries6Brush" Color="#EB6834" />
  <SolidColorBrush x:Key="PlotSeries7Brush" Color="#9283FF" />
  <SolidColorBrush x:Key="PlotSeries8Brush" Color="#E34948" />

  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#000000" />
  <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#5C5C5C" />
  <SolidColorBrush x:Key="CanvasTextBrush" Color="#FFFFFF" />
  <!-- Paired UDS / CAN traces are rendered on the light evidence canvas even
       in dark theme. Use contrast-checked, differentiated dark hues rather
       than the low-contrast orange previously hard-coded in the plot. -->
  <SolidColorBrush x:Key="CorrelationDidBrush" Color="#6CB6FF" />
  <SolidColorBrush x:Key="CorrelationCanBrush" Color="#FFAA4D" />
  <SolidColorBrush x:Key="CanvasLabelBrush" Color="#161616" />

</ResourceDictionary>
