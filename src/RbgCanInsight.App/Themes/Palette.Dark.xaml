<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== RBG CAN Insight brand tokens — Dark (default) ===== -->
  <Color x:Key="BackgroundColor">#0E1319</Color>
  <Color x:Key="SurfaceColor">#151C25</Color>
  <Color x:Key="SurfaceRaisedColor">#1B242F</Color>
  <Color x:Key="SurfaceInputColor">#10161E</Color>
  <Color x:Key="BorderColor">#273140</Color>
  <Color x:Key="AccentColor">#2EA8FF</Color>
  <Color x:Key="AccentSoftColor">#1A3A55</Color>
  <Color x:Key="TealColor">#22D3A7</Color>
  <Color x:Key="WarningColor">#F5C842</Color>
  <Color x:Key="ErrorColor">#FF6868</Color>
  <Color x:Key="TextPrimaryColor">#E8EDF4</Color>
  <Color x:Key="TextSecondaryColor">#9DABBF</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentContrastTextBrush" Color="#08111B" />

  <!-- Secondary surface tones used ad hoc across views (hover states, alternating rows, scroll
       thumbs, changed-value highlights). Keyed so every theme can supply its own tuned value
       instead of a hardcoded hex baked into a single dark look. -->
  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#1A2430" />
  <SolidColorBrush x:Key="AlternateRowBrush" Color="#131A23" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33465C" />
  <SolidColorBrush x:Key="ChangedRowHighlightBrush" Color="#2E2A16" />
  <SolidColorBrush x:Key="ChangedByteHighlightBrush" Color="#3A2D15" />
  <SolidColorBrush x:Key="ChangedSignalHighlightBrush" Color="#20352E" />
  <SolidColorBrush x:Key="ChangedByteMatrixCellBrush" Color="#4A3517" />

  <!-- Plot series palette: 8 hues in a fixed order validated for colorblind-safe adjacent
       separation on the light canvas below (Machado CVD dE >= 9.1, normal-vision dE >= 19.6).
       Assign in order, never cycle or re-shuffle. -->
  <SolidColorBrush x:Key="PlotSeries1Brush" Color="#2A78D6" />
  <SolidColorBrush x:Key="PlotSeries2Brush" Color="#008300" />
  <SolidColorBrush x:Key="PlotSeries3Brush" Color="#E87BA4" />
  <SolidColorBrush x:Key="PlotSeries4Brush" Color="#EDA100" />
  <SolidColorBrush x:Key="PlotSeries5Brush" Color="#1BAF7A" />
  <SolidColorBrush x:Key="PlotSeries6Brush" Color="#EB6834" />
  <SolidColorBrush x:Key="PlotSeries7Brush" Color="#9283FF" />
  <SolidColorBrush x:Key="PlotSeries8Brush" Color="#E34948" />

  <!-- Overview/plot canvas chrome (custom-drawn controls resolve these via TryFindResource).
       Canvases follow the theme: a dark surface with light axis/legend ink in Dark and
       High Contrast (no glaring white blocks); the Light theme keeps white paper. -->
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#0B1117" />
  <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#2B3746" />
  <SolidColorBrush x:Key="CanvasTextBrush" Color="#D5DDE8" />
  <!-- Paired UDS / CAN traces use lighter hues here so they stay legible on the dark canvas. -->
  <SolidColorBrush x:Key="CorrelationDidBrush" Color="#5BA8FF" />
  <SolidColorBrush x:Key="CorrelationCanBrush" Color="#FFAA4D" />
  <SolidColorBrush x:Key="CanvasLabelBrush" Color="#1B242F" />

</ResourceDictionary>
