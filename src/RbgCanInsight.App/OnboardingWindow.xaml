<Window x:Class="RbgCanInsight.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBG CAN Insight — Quick tour"
        Width="560" Height="640"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
  <DockPanel Margin="20">

    <!-- Footer: skip · progress · back/next -->
    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="SkipButton" AutomationProperties.AutomationId="onboarding.skip" Content="Skip tour" Style="{StaticResource SubtleButton}"
              Click="OnSkipClick" ToolTip="Close the tour (Esc). You can reopen it any time with the Quick tour button in the left rail." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ItemsControl x:Name="StepDots">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <Button Grid.Column="2" x:Name="BackButton" AutomationProperties.AutomationId="onboarding.back" Content="◀ Back" Click="OnBackClick" Margin="0,0,8,0" MinWidth="86" />
      <Button Grid.Column="3" x:Name="NextButton" AutomationProperties.AutomationId="onboarding.next" Content="Next ▶" Style="{StaticResource AccentButton}"
              Click="OnNextClick" MinWidth="110" />
    </Grid>

    <!-- Step content -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="StepKicker" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="StepBody" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <Border x:Name="ExampleCard" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
          <StackPanel>
            <TextBlock x:Name="ExampleTitle" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock x:Name="ExampleBody" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" />
          </StackPanel>
        </Border>

        <Border x:Name="TipCard" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Margin="0,10,0,0" Padding="12,10">
          <TextBlock x:Name="TipBody" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <TextBlock x:Name="LiveHint" Style="{StaticResource MutedText}" FontSize="11.5" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="The main window behind this tour has switched to the workspace being described — feel free to click around in it while the tour is open." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
