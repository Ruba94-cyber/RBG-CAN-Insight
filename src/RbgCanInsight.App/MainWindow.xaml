<Window x:Class="RbgCanInsight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:RbgCanInsight.App.Common"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        xmlns:views="clr-namespace:RbgCanInsight.App.Views"
        xmlns:vm="clr-namespace:RbgCanInsight.App.ViewModels"
        Title="RBG CAN Insight — Offline CAN Trace Analysis Studio"
        Width="1480" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AllowDrop="True"
        Drop="OnFileDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <Window.Resources>
    <common:IntEqualsToVisibilityConverter x:Key="NavVisibility" />
    <common:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <common:IsNullConverter x:Key="IsNull" />
    <common:MiddleEllipsisConverter x:Key="MiddleEllipsis" />
    <common:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
    <common:CollapsibleRowHeightConverter x:Key="CollapsibleRowHeight" />
    <!-- Separate instance (not the shared default above) so the Byte Matrix decoded-signal panel
         can remember the last height the user dragged it to, independently of any other
         collapsible panel in the app. -->
    <common:CollapsibleRowHeightConverter x:Key="ByteMatrixDecodedHeight" />
    <common:ActivityToBrushConverter x:Key="ActivityBrush" />
    <common:ConfidenceToWidthConverter x:Key="ConfidenceWidth" />
    <common:CandidateLabelConverter x:Key="CandidateLabel" />
    <common:StatusToBrushConverter x:Key="StatusBrush" />
    <common:ExpandGlyphConverter x:Key="ExpandGlyph" />
    <common:SingleSeriesToArrayConverter x:Key="SingleSeries" />
    <common:SignalAtPlotCursorConverter x:Key="SignalAtPlotCursor" />
    <common:SignalSourceAgeAtPlotCursorConverter x:Key="SignalSourceAgeAtPlotCursor" />

    <!-- Collapsible-section header toggle (e.g. bookmark rules) — mirrors the SubtleButton look
         but targets ToggleButton, since a Button-targeted style cannot be applied to one. -->
    <Style x:Key="SectionToggleButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenTraceCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding LoadDbcCommand}" />
    <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportReportCommand}" />
    <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="0" />
    <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="1" />
    <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="2" />
    <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="3" />
    <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="4" />
    <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="5" />
    <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="6" />
    <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="7" />
    <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="8" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Navigation rail ===== -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <!-- The brand, theme switch and workspace list scroll on their own; the occasional-use
           "Session & tools" expander below is pinned to the bottom with its own capped scroller, so
           opening it can never push the workspace list off screen. -->
      <Grid x:Name="NavRailGrid" SizeChanged="OnNavRailSizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/RbgCanInsight.png" Width="30" Height="30" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="RBG CAN" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="INSIGHT" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,-4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="NavTagline" Text="Offline CAN analysis studio" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
          <Button Content="🔍 Search everywhere" Click="OnGlobalSearchClick" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="globalSearch.open" ToolTip="Find any recorded signal, source CAN channel, DBC message, frame identifier or DID (Ctrl+K)" />
          <Button x:Name="NavHelpButton" Content="Help &amp; quick tour  ·  F1" Click="OnQuickTourClick" Margin="0,6,0,0"
                  Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="onboarding.quickHelp"
                  ToolTip="Open the interactive workspace guide. Press F1 at any time." />
          <DockPanel Margin="0,8,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Theme" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeIndex}"
                      ToolTip="Dark, Light or High Contrast — applies immediately and is remembered next time"
                      AutomationProperties.Name="Theme" AutomationProperties.AutomationId="settings.theme" />
          </DockPanel>
        </StackPanel>

        <!-- The main views are what analysts switch between constantly, so navigation always gets
             its full natural height (sized to its items, never squeezed) docked right below the
             logo. Save/load/export/theme are occasional-use utilities — they live in the scrollable
             remainder below the list instead of guaranteeing themselves space ahead of navigation. -->
        <StackPanel x:Name="WorkspaceNavPanel" DockPanel.Dock="Top" Margin="0,8,0,8"
                    AllowDrop="True" PreviewMouseLeftButtonDown="OnWorkspaceNavMouseDown"
                    PreviewMouseMove="OnWorkspaceNavMouseMove" DragOver="OnWorkspaceNavDragOver"
                    Drop="OnWorkspaceNavDrop" ToolTip="Drag workspace buttons to reorder them">
          <RadioButton Style="{StaticResource NavButton}" Tag="⌂" Content="Dashboard"
                       IsChecked="True" ToolTip="Overview: load files and jump into any workspace"
                       Checked="OnNavChecked" x:Name="NavDashboard" AutomationProperties.AutomationId="nav.dashboard" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="≣" Content="Trace"
                       ToolTip="Frame-by-frame trace table with search, bookmarks and replay"
                       Checked="OnNavChecked" x:Name="NavTrace" AutomationProperties.AutomationId="nav.trace" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="▥" Content="Data Studio"
                       ToolTip="Guided data analysis: Datasets, Analysis tabs, Results and Compare in separate sections"
                       Checked="OnNavChecked" x:Name="NavDataStudio" AutomationProperties.AutomationId="nav.dataStudio" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="⚕" Content="UDS Analysis"
                       ToolTip="Reassembled ISO-TP transactions, requests/responses, DTCs, routines and CDD/ODX values"
                       Checked="OnNavChecked" x:Name="NavUds" AutomationProperties.AutomationId="nav.uds" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="▤" Content="DBC Manager"
                       ToolTip="Loaded CAN databases, per-database matching options and unmatched-ID diagnostics"
                       Checked="OnNavChecked" x:Name="NavDbcManager" AutomationProperties.AutomationId="nav.dbc" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="∿" Content="Signals &amp; Plot"
                       ToolTip="Find recorded DBC signals, plot them, compare exact CAN channels and inspect source-frame values at any trace time"
                       Checked="OnNavChecked" x:Name="NavSignals" AutomationProperties.AutomationId="nav.signals" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="◫" Content="Change Matrix"
                       ToolTip="Every decoded signal ranked by activity, with its change history"
                       Checked="OnNavChecked" x:Name="NavMatrix" AutomationProperties.AutomationId="nav.matrix" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="▦" Content="Byte Matrix"
                       ToolTip="Per-ID payload state over time, byte by byte, with decoded signals for the selected ID"
                       Checked="OnNavChecked" x:Name="NavByteMatrix" AutomationProperties.AutomationId="nav.byteMatrix" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="Σ" Content="Statistics"
                       ToolTip="Per-ID rate, period and jitter statistics, plus trace-to-trace comparison"
                       Checked="OnNavChecked" x:Name="NavStatistics" AutomationProperties.AutomationId="nav.statistics" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="⇄" Content="DID ↔ CAN Mapping"
                       ToolTip="Correlate diagnostic DIDs (CDD/ODX) to CAN signals, review and save the mapping"
                       Checked="OnNavChecked" x:Name="NavMapping" AutomationProperties.AutomationId="nav.mapping" GroupName="Nav" />
          <RadioButton Style="{StaticResource NavButton}" Tag="◨" Content="CAN Explorer"
                       ToolTip="Start with a simple CANalyzer-style observed signal list and trend. Search related signals; advanced synchronized panes are optional."
                       Checked="OnNavChecked" x:Name="NavInvestigation" AutomationProperties.AutomationId="nav.investigation" GroupName="Nav" />
        </StackPanel>

      </DockPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,0" />

        <Expander x:Name="UtilityPanelExpander" AutomationProperties.AutomationId="utilities.panel" Header="Session &amp; tools" IsExpanded="False"
                  Expanded="OnUtilityPanelExpansionChanged" Collapsed="OnUtilityPanelExpansionChanged"
                  ToolTip="Show or hide session, preset, report, layout, theme and application tools">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260">
        <StackPanel Margin="16,10,16,14">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Save session" AutomationProperties.AutomationId="utilities.saveSession" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                    Command="{Binding SaveSessionCommand}" Margin="0,0,6,0"
                    ToolTip="Save everything needed to pick this analysis back up: the trace, DBC/ARXML, CDD/ODX, reviewed DID map, filters, watch list and plotted signals" />
            <Button Content="Load session" AutomationProperties.AutomationId="utilities.loadSession" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                    Command="{Binding LoadSessionCommand}"
                    ToolTip="Reopen a saved session: reloads every file it references and restores filters, watch list and plotted signals" />
          </StackPanel>
          <Button Content="Save analysis configuration…" AutomationProperties.AutomationId="utilities.saveAnalysisConfiguration" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnSaveNativeAnalysisConfigurationClick" Margin="0,4,0,0"
                  ToolTip="Save plotted and watched signals and plot settings for reuse with another recording. Trace files are not included." />
          <Button Content="Load analysis configuration…" AutomationProperties.AutomationId="utilities.loadAnalysisConfiguration" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnLoadNativeAnalysisConfigurationClick" Margin="0,4,0,8"
                  ToolTip="Review exact, missing and ambiguous signal matches before applying a saved analysis configuration." />
          <Button Content="Save preset" AutomationProperties.AutomationId="utilities.savePreset" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Command="{Binding SavePresetCommand}"
                  ToolTip="UI settings only (view, playback speed, theme) — use Save session instead to also remember which files were loaded" />
          <Button Content="Load preset" AutomationProperties.AutomationId="utilities.loadPreset" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnLoadPresetClick" Margin="0,4,0,8"
                  ToolTip="Reopen a previously saved UI preset (does not load any files) — shows named presets you've saved before" />
          <Button Content="Export report" AutomationProperties.AutomationId="utilities.exportReport" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Command="{Binding ExportReportCommand}" Margin="0,0,0,8"
                  ToolTip="Package a ZIP analysis report: summary, statistics, top movers, coverage, mapping and comparisons" />
          <Button Content="Columns..." AutomationProperties.AutomationId="utilities.columns" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnColumnsClick" Margin="0,0,0,8"
                  ToolTip="Show/hide columns of the table in the current view" />
          <WrapPanel Margin="0,0,0,4">
            <Button Content="Export layout" AutomationProperties.AutomationId="utilities.exportLayout" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                    Click="OnExportLayoutClick" Margin="0,0,6,0"
                    ToolTip="Save all table column widths/order/visibility and the current view to a file" />
            <Button Content="Import layout" AutomationProperties.AutomationId="utilities.importLayout" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                    Click="OnImportLayoutClick"
                    ToolTip="Load a previously exported UI layout file" />
          </WrapPanel>
          <Button Content="Reset window position" AutomationProperties.AutomationId="utilities.resetWindow" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnResetWindowPositionClick" Margin="0,0,0,8"
                  ToolTip="Move this window back onto the primary monitor at its default size — use this if the window ever opens off-screen or on a disconnected monitor" />
          <Button Content="Quick tour" AutomationProperties.AutomationId="onboarding.open" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Click="OnQuickTourClick" Margin="0,0,0,4"
                  ToolTip="Replay the interactive first-launch tour of every workspace" />
          <Button Content="About" AutomationProperties.AutomationId="utilities.about" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                  Command="{Binding AboutCommand}" ToolTip="Version and credits" />
          <TextBlock Text="{Binding DesignerCredit}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        </ScrollViewer>
        </Expander>
      </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Content host ===== -->
    <Grid x:Name="ContentHost" Grid.Column="1" Grid.Row="0">

      <!-- Dedicated, independently navigable Data Studio. It shares the existing
           frame and notebook engines but owns its own four-step UI surface. -->
      <views:DataStudioView Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=10}"
                            AutomationProperties.AutomationId="studio.workspace"/>

      <!-- ============ DASHBOARD ============ -->
      <ScrollViewer Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=0}"
                    VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
          <TextBlock Text="Welcome to RBG CAN Insight" FontSize="24" FontWeight="Bold" Margin="0,4,0,2" />
          <TextBlock Text="Load a trace, decode it with your DBC, find what changed, and map diagnostic DIDs to CAN signals — fully offline."
                     Style="{StaticResource MutedText}" Margin="0,0,0,18" />

          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="1 · CAN TRACE" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding TraceName, TargetNullValue='—', FallbackValue='—'}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TraceSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="{Binding TraceWorkspaceSummary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                <Button Content="Open trace…" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        Command="{Binding OpenTraceCommand}" />
                <TextBlock Text="ASC · BLF · TRC · CSV · LOG · MF4" Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="2 · DBC DATABASES" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding DbcSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DecodeCoverageSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Load DBC…" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Command="{Binding LoadDbcCommand}" Margin="0,0,8,0" />
                  <Button Content="Manage →" HorizontalAlignment="Left"
                          Command="{Binding NavigateCommand}" CommandParameter="2" />
                </StackPanel>
                <TextBlock Text="Counts, coverage, unmatched IDs and per-DBC options live in the DBC Manager."
                           Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="3 · DIAGNOSTIC DATA" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding Mapping.CatalogSummary}" FontSize="13" Margin="0,6,0,10" TextWrapping="Wrap" />
                <Button Content="Load CDD / ODX / DTC…" HorizontalAlignment="Left" Command="{Binding Mapping.LoadCatalogCommand}" />
                <TextBlock Text="Then correlate DIDs to CAN signals in the Mapping view." Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,12">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Text="START AN INVESTIGATION" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Right" Text="Offline · read-only · no ECU transmissions"
                           Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="Choose a question; Insight opens the right tools and applies the necessary focus automatically."
                         Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <WrapPanel>
                <Button Content="Guided Data Studio" Style="{StaticResource AccentButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="10"
                        ToolTip="Four easy steps: choose datasets, save analyses, inspect results, compare recordings"
                        AutomationProperties.AutomationId="dashboard.dataStudio" Margin="0,0,8,8"/>
                <Button Content="Investigate DTC conditions" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="dashboard.dtcConditions"
                        Click="OnOpenDtcConditionsFromDashboardClick" Margin="0,0,8,8"
                        ToolTip="Choose a recorded DTC lifecycle event; inspect source-backed CAN signal changes and CDD/ODX snapshot conditions" />
                <Button Content="Find UDS failures" Style="{StaticResource ToolButton}"
                        Command="{Binding StartInvestigationCommand}" CommandParameter="uds"
                        ToolTip="Open diagnostic transactions filtered to negative responses, no replies and malformed messages"
                        AutomationProperties.Name="Investigate UDS failures" AutomationProperties.AutomationId="dashboard.udsFailures" Margin="0,0,8,8" />
                <Button Content="What changed?" Style="{StaticResource ToolButton}"
                        Command="{Binding StartInvestigationCommand}" CommandParameter="changes"
                        ToolTip="Inspect the changed-payload lens in the raw frame trace"
                        AutomationProperties.Name="Investigate changing CAN frames" Margin="0,0,8,8" />
                <Button Content="Find unknown CAN IDs" Style="{StaticResource ToolButton}"
                        Command="{Binding StartInvestigationCommand}" CommandParameter="unmatched"
                        ToolTip="Find received CAN identifiers missing from the loaded DBC/ARXML profiles"
                        AutomationProperties.Name="Find CAN identifiers without a DBC" Margin="0,0,8,8" />
                <Button Content="Start: signals + trend" Style="{StaticResource AccentButton}"
                        Click="OnOpenSignalsTrendClick" Margin="0,0,8,8"
                        AutomationProperties.AutomationId="dashboard.signalsTrend"
                        ToolTip="Observed CAN signals at left, shared source-backed time chart at right" />
                <Button Content="Discover related signal groups" Style="{StaticResource AccentButton}"
                        Click="OnDiscoverSignalGroupsClick" Margin="0,0,8,8"
                        AutomationProperties.AutomationId="dashboard.signalMap"
                        ToolTip="No selected signal or DTC required: automatically find source-backed co-variation and ordered changes from an original CAN recording" />
                <Button Content="Find signals related to the selected one" Style="{StaticResource ToolButton}"
                        Click="OnOpenSimpleSignalViewClick" Margin="0,0,8,8"
                        AutomationProperties.AutomationId="dashboard.relatedSignals"
                        ToolTip="Open simple CAN signal explorer; select a signal and find correlated/leading/following physical observations" />
                <Button Content="Compare signal curves" Style="{StaticResource ToolButton}"
                        Command="{Binding StartInvestigationCommand}" CommandParameter="signals"
                        ToolTip="Navigate directly to decoded signal plots and watch values"
                        AutomationProperties.Name="Explore decoded signal plots" Margin="0,0,8,8" />
                <Button Content="Correlate DID to CAN" Style="{StaticResource ToolButton}"
                        Command="{Binding StartInvestigationCommand}" CommandParameter="mapping"
                        ToolTip="Review DID-to-signal candidates, ECU identity and observed evidence"
                        AutomationProperties.Name="Correlate diagnostic DIDs to CAN signals" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Top changing signals" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Highest change counts in the loaded trace — jump straight to the Change Matrix for details."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                <ItemsControl x:Name="TopMoversList" ItemsSource="{Binding TopMovers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding SignalName, Mode=OneWay}" />
                          <Run Text="{Binding MessageName, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ChangeCount, Mode=OneWay, StringFormat='{}{0:N0} changes'}"
                                   Style="{StaticResource MutedText}" FontSize="11" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,4,0,0" Padding="12,10" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceRaisedBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=TopMoversList}" Value="False">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="No data yet" FontWeight="SemiBold" />
                    <TextBlock Text="Open a CAN trace to rank the signals that change the most." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <Button Content="Open trace…" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Command="{Binding OpenTraceCommand}"
                            AutomationProperties.Name="Open trace from empty top changing signals card" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Recent files" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="RecentFilesList" ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <StackPanel ToolTip="{Binding Path}">
                          <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="10.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,10,0,0" Padding="12,10" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaisedBrush}">
                  <StackPanel>
                    <TextBlock Text="Drag &amp; drop trace and DBC files anywhere in the window" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Recent files will be listed here once you have opened some.">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentFiles.Count}" Value="0">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Open project…" Click="OnProjectOpenClick" Margin="0,0,6,0"
                          AutomationProperties.AutomationId="project.open" AutomationProperties.Name="Open project"
                          ToolTip="Reload the trace, DBCs and catalogs of a saved analysis project (files are checked for changes)" />
                  <Button Content="Save project…" Click="OnProjectSaveClick"
                          AutomationProperties.AutomationId="project.save" AutomationProperties.Name="Save project"
                          ToolTip="Save the loaded files, filters and notes as a portable project (paths relative, SHA-256 recorded)" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ TRACE ============ -->
      <Grid x:Name="TraceRootGrid" SizeChanged="OnTraceRootSizeChanged" Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="TraceOverviewRow" Height="48" MinHeight="36" MaxHeight="520" />
          <RowDefinition Height="6" />
          <RowDefinition Height="*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- Everything above the frame-density strip lives in one top zone. It never exceeds the space
             left over after the grid's minimum height (MaxHeight is set in code), so toolbar rows can no
             longer overlap or push the frame grid out of view; the scrollbar only appears on very small
             windows or when the optional analysis tools are expanded. -->
        <ScrollViewer x:Name="TraceTopScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <!-- A tab strip for open recordings, with a collapsible source explorer below. -->
        <StackPanel Margin="0,0,0,8">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        Visibility="{Binding HasMultipleTraceSources, Converter={StaticResource VisibleWhenTrue}}"
                        Margin="0,0,0,3" AutomationProperties.AutomationId="trace.sourceTabs">
            <ItemsControl ItemsSource="{Binding TraceWorkspaceEntries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TraceWorkspaceEntry}">
                  <Button Content="{Binding DisplayName}" ToolTip="{Binding Description}"
                          AutomationProperties.AutomationId="trace.sourceTab"
                          Command="{Binding DataContext.ViewTraceSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" Padding="12,6" Margin="0,0,5,0"
                          MinWidth="80" MaxWidth="240">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- Notebook-like named analysis tabs: saved Trace view recipes, not
               cloned recordings or a falsely independent UDS/DBC workspace. -->
          <Border x:Name="TraceNotebookPanel" Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="7" Padding="7,5" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
              <DockPanel LastChildFill="True" Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Content="Save session…"
                        Command="{Binding SaveSessionCommand}"
                        IsEnabled="{Binding IsTraceLoaded}"
                        AutomationProperties.AutomationId="trace.notebookSaveSession"
                        ToolTip="Save the recordings, databases and all named analysis tabs together in .rbgsession"
                        Padding="8,3" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="+ New analysis"
                        Command="{Binding Notebook.NewCommand}"
                        IsEnabled="{Binding IsTraceLoaded}"
                        AutomationProperties.AutomationId="trace.notebookNew"
                        ToolTip="Keep the current Trace filter, source focus and view mode in a named analysis tab"
                        Margin="8,0,0,0" Padding="8,3" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="trace.notebookTabs">
                  <ItemsControl ItemsSource="{Binding Notebook.Tabs}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:TraceNotebookTabRow}">
                        <Button Content="{Binding Title}" ToolTip="{Binding Description}"
                                AutomationProperties.AutomationId="trace.notebookOpen"
                                Command="{Binding DataContext.Notebook.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" Padding="10,4" Margin="0,0,5,0"
                                MinWidth="80" MaxWidth="210">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                              <Setter Property="BorderThickness" Value="1" />
                              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
              <Expander Header="{Binding Notebook.Summary}" IsExpanded="False"
                        AutomationProperties.AutomationId="trace.notebookEditor"
                        ToolTip="Named Trace tabs remember query, physical logger, view mode, clock display and notes; save a session to keep them">
                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,6,4,4">
                  <WrapPanel Margin="0,0,0,6">
                    <TextBox Width="210" MaxLength="80" VerticalContentAlignment="Center"
                             Text="{Binding Notebook.TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Notebook.HasActive}"
                             AutomationProperties.AutomationId="trace.notebookTitle"
                             common:PlaceholderService.Text="Analysis tab title"
                             Margin="0,0,6,0" />
                    <Button Content="Rename" Command="{Binding Notebook.RenameCommand}"
                            IsEnabled="{Binding Notebook.HasActive}"
                            AutomationProperties.AutomationId="trace.notebookRename"
                            Margin="0,0,6,0" Padding="8,3" />
                    <Button Content="Update view" Command="{Binding Notebook.UpdateCommand}"
                            IsEnabled="{Binding Notebook.HasActive}"
                            AutomationProperties.AutomationId="trace.notebookUpdate"
                            ToolTip="Save the current Trace query, source and presentation in this tab"
                            Margin="0,0,6,0" Padding="8,3" />
                    <Button Content="Duplicate" Command="{Binding Notebook.DuplicateCommand}"
                            IsEnabled="{Binding Notebook.HasActive}"
                            AutomationProperties.AutomationId="trace.notebookDuplicate"
                            Margin="0,0,6,0" Padding="8,3" />
                    <Button Content="Close tab" Command="{Binding Notebook.CloseCommand}"
                            IsEnabled="{Binding Notebook.HasActive}"
                            AutomationProperties.AutomationId="trace.notebookClose"
                            Margin="0,0,6,0" Padding="8,3" />
                  </WrapPanel>
                  <TextBox Text="{Binding Notebook.NotesDraft, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" MaxLength="8192"
                           Height="52" IsEnabled="{Binding Notebook.HasActive}"
                           AutomationProperties.AutomationId="trace.notebookNotes"
                           common:PlaceholderService.Text="Investigation notes for this saved Trace view"
                           ToolTip="Notes are stored in the .rbgsession file; update or switch tabs to capture them" />
                  <TextBlock Text="Press Update view to save a changed filter or source. Tabs affect Trace only; UDS, DBC and plots stay on the combined recording."
                             Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                </ScrollViewer>
              </Expander>
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,0,0,6"
                     Visibility="{Binding Trace.HasSourceScope, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding Trace.SourceScopeLabel}" Style="{StaticResource MutedText}"
                       MaxWidth="620" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                       AutomationProperties.AutomationId="trace.sourceFocusStatus"/>
            <Button Content="Clear focus" Command="{Binding ClearTraceSourceFocusCommand}"
                    AutomationProperties.AutomationId="trace.sourceFocusClear"
                    ToolTip="Show frames from every source in the combined trace without importing again"
                    Padding="8,3"/>
          </WrapPanel>
          <Expander x:Name="TraceFilesExpander" Header="{Binding TraceWorkspaceSummary}" IsEnabled="{Binding HasTraceWorkspace}"
                    IsExpanded="False" Margin="0,0,0,6"
                    AutomationProperties.AutomationId="trace.workspaceFiles"
                    ToolTip="Manage all source files in this analysis. View one trace or all traces without removing other sources.">
            <StackPanel Margin="8,6,8,8">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Add traces…" Command="{Binding AddTraceFilesCommand}"
                        AutomationProperties.AutomationId="trace.workspaceAdd"
                        ToolTip="Add source files to this session and rebuild the combined analysis"
                        Margin="0,0,10,0" />
                <TextBlock Text="Focus filters Trace rows instantly; View opens one file for independent analysis."
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" MaxWidth="470"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ScrollViewer x:Name="TraceWorkspaceFilesScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding TraceWorkspaceEntries}"
                              AutomationProperties.AutomationId="trace.workspaceEntries">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TraceWorkspaceEntry}">
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5">
                        <DockPanel LastChildFill="True">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{Binding FocusLabel}"
                                    IsEnabled="{Binding DataContext.CanFocusTraceSource, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.AutomationId="trace.sourceFocus"
                                    Command="{Binding DataContext.FocusTraceSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" MinWidth="65" Margin="6,0,0,0" Padding="8,3"
                                    ToolTip="Filter only the Trace grid by physical source; no reload, other analysis stays combined"/>
                            <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanView}"
                                    AutomationProperties.AutomationId="trace.workspaceView"
                                    Command="{Binding DataContext.ViewTraceSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" MinWidth="70" Margin="6,0,0,0" Padding="8,3" />
                            <Button Content="Remove" IsEnabled="{Binding CanRemove}"
                                    AutomationProperties.AutomationId="trace.workspaceRemove"
                                    Command="{Binding DataContext.RemoveTraceSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Margin="6,0,0,0" Padding="8,3" />
                          </StackPanel>
                          <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     AutomationProperties.Name="{Binding DisplayName}" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Expander>
          <WrapPanel Margin="0,0,0,0">
          <Button DockPanel.Dock="Left" Content="Open trace…" AutomationProperties.AutomationId="trace.open" Style="{StaticResource AccentButton}"
                  Command="{Binding OpenTraceCommand}" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="Load DBC…" Command="{Binding LoadDbcCommand}" Margin="0,0,8,0" />
          <Button Content="Compare files…" Click="OnCompareSourcesClick"
                  IsEnabled="{Binding CanCompareTraceSources}"
                  AutomationProperties.AutomationId="trace.sourceCompare"
                  ToolTip="Compare physical CAN channel/ID coverage and frame counts across all source recordings"
                  Margin="0,0,8,0" />
          <Button Content="Find original frame" Command="{Binding OpenOriginalTraceSourceCommand}"
                  IsEnabled="{Binding CanOpenOriginalSource}"
                  ToolTip="Verify the selected combined frame against its original recording"
                  AutomationProperties.AutomationId="trace.openOriginal"
                  Margin="0,0,14,0" />
          <TextBlock DockPanel.Dock="Left" Text="View" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox DockPanel.Dock="Left" MinWidth="140" SelectedIndex="{Binding Trace.ViewModeIndex}"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    ToolTip="How trace rows are listed"
                    AutomationProperties.Name="Trace view mode">
            <ComboBoxItem Content="All frames" />
            <ComboBoxItem Content="Latest per ID" />
            <ComboBoxItem Content="Changes only" />
          </ComboBox>
          <TextBlock DockPanel.Dock="Left" Text="Time" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox DockPanel.Dock="Left" MinWidth="150" ItemsSource="{Binding Trace.TimeDisplayModeChoices}"
                    SelectedIndex="{Binding Trace.TimeDisplayModeIndex}"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    ToolTip="How the Time column reads each row's timestamp"
                    AutomationProperties.Name="Time column mode" />
          <Grid Width="480" Margin="0,0,10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TraceSearchBox" AutomationProperties.AutomationId="trace.search"
                     common:PlaceholderService.Text="🔍 Search / filter frames — ID, message, ch1, payload:AABB, uds, -ch2 to exclude · Enter = filter, F3 = find"
                     Text="{Binding Trace.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="One search box, two behaviours:&#10;• Enter — filter rows (hex ID, message name, ch1, payload:AABB; space = AND)&#10;• uds — only diagnostic frames; uds:vin / uds:neg / uds:f190 — only matching UDS text&#10;• A leading - excludes instead of requires: -ch2, -payload:AA, -uds, -EngineTemp&#10;• F3 / Shift+F3 or ▲▼ — find next/previous match without hiding rows&#10;• Esc — clear"
                     AutomationProperties.Name="Search or filter trace frames"
                     KeyDown="OnTraceSearchKeyDown" />
            <Button Grid.Column="1" Content="▲" Command="{Binding Trace.FindPreviousCommand}" Margin="6,0,0,0" Padding="8,6"
                    ToolTip="Find previous (Shift+F3)" AutomationProperties.Name="Find previous" />
            <Button Grid.Column="2" Content="▼" Command="{Binding Trace.FindNextCommand}" Margin="4,0,0,0" Padding="8,6"
                    ToolTip="Find next (F3)" AutomationProperties.Name="Find next" />
            <Button Grid.Column="3" Content="✕" Command="{Binding Trace.ClearFilterCommand}" Margin="4,0,0,0" Padding="8,6"
                    ToolTip="Clear search and filter (Esc)" AutomationProperties.Name="Clear search and filter" AutomationProperties.AutomationId="trace.clearFilter" />
          </Grid>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Trace.RowCountText}" Style="{StaticResource MutedText}"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
          <TextBlock Text="{Binding Trace.NavigationText}" Style="{StaticResource MutedText}"
                     VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="220"
                     TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="trace.navigationStatus"
                     AutomationProperties.Name="{Binding Trace.NavigationText}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                      Visibility="{Binding Trace.IsFiltering, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding Trace.FilterProgressText}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button Content="Cancel" Command="{Binding Trace.CancelFilterCommand}" Margin="8,0,0,0" Padding="8,2"
                    ToolTip="Stop building this filter and keep the current view"
                    AutomationProperties.Name="Cancel filter" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Trace.FindStatus}" Style="{StaticResource MutedText}"
                     VerticalAlignment="Center" Margin="10,0,0,0" />

          </WrapPanel>
        </StackPanel>

        <!-- Keep secondary replay and marker controls available in one group without consuming the default table height. -->
        <WrapPanel Margin="0,0,0,8">
          <Expander Header="Replay &amp; markers" IsExpanded="False" Margin="0,0,8,4"
                    AutomationProperties.AutomationId="trace.replayTools"
                    ToolTip="Playback, replay speed, frame markers and timeline navigation">
            <StackPanel Margin="4,6,4,4">
              <WrapPanel Margin="0,0,0,4">
                <Border Style="{StaticResource ToolGroup}" Margin="0,0,10,0" IsEnabled="{Binding IsTraceLoaded}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Replay" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="⏮" Command="{Binding Trace.HeadCommand}" ToolTip="Head" Margin="0,0,2,0" AutomationProperties.Name="Head" AutomationProperties.AutomationId="trace.head" />
                    <Button Style="{StaticResource ToolButton}" Content="◀" Command="{Binding Trace.PreviousCommand}" ToolTip="Step back" Margin="0,0,2,0" AutomationProperties.Name="Step back" AutomationProperties.AutomationId="trace.previous" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding Trace.TogglePlaybackCommand}" MinWidth="52" Margin="0,0,2,0"
                            ToolTip="Play / stop replay — resumes from the current position, or restarts from the head once the end is reached">
                      <Button.Content><Binding Path="Trace.PlaybackButtonText" /></Button.Content>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="▶" Command="{Binding Trace.NextCommand}" ToolTip="Step forward" Margin="0,0,2,0" AutomationProperties.Name="Step forward" AutomationProperties.AutomationId="trace.next" />
                    <Button Style="{StaticResource ToolButton}" Content="⏭" Command="{Binding Trace.TailCommand}" ToolTip="Tail" AutomationProperties.Name="Tail" AutomationProperties.AutomationId="trace.tail" />
                    <Button Style="{StaticResource ToolButton}" Content="Run to match" Command="{Binding Trace.RunToNextMatchCommand}" Margin="6,0,0,0"
                            ToolTip="Replay forward until a frame matches the condition in the search box, then stop on it (Ctrl+F9; Ctrl+Shift+F9 = previous).&#10;Keys: F7 step, F8 animate, F9 run, Esc break. Example conditions: d0=5A, d1&amp;0F=05, id:100..1FF OR ch2, t:1.5..3"
                            AutomationProperties.Name="Run to match" AutomationProperties.AutomationId="trace.runToMatch" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Speed" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="76" ItemsSource="{Binding Trace.PlaybackSpeedChoices}"
                          SelectedItem="{Binding Trace.PlaybackSpeed}" ToolTip="Replay speed multiplier"
                          Margin="0,0,10,0" IsEnabled="{Binding IsTraceLoaded}" AutomationProperties.Name="Replay speed" />
                <Border Style="{StaticResource ToolGroup}" Margin="0,0,10,0" IsEnabled="{Binding IsTraceLoaded}"
                        ToolTip="Markers: pick a category, toggle on the selected row, jump between marked rows">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Markers" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <ComboBox Width="88" Margin="0,0,6,0" ItemsSource="{Binding Trace.MarkerCategoryChoices}"
                              SelectedItem="{Binding Trace.SelectedMarkerCategory}"
                              ToolTip="Category applied to the next marker: manual, timing, diagnostic or range finding"
                              AutomationProperties.Name="Marker category" />
                    <Button Style="{StaticResource ToolButton}" Content="🔖" Command="{Binding Trace.ToggleMarkerCommand}" ToolTip="Mark / unmark selected row, using the category above" Margin="0,0,2,0" AutomationProperties.Name="Mark or unmark selected row" AutomationProperties.AutomationId="trace.markerToggle" />
                    <Button Style="{StaticResource ToolButton}" Content="◀🔖" Command="{Binding Trace.PreviousMarkerCommand}" ToolTip="Previous marker" Margin="0,0,2,0" AutomationProperties.Name="Previous marker" AutomationProperties.AutomationId="trace.previousMarker" />
                    <Button Style="{StaticResource ToolButton}" Content="🔖▶" Command="{Binding Trace.NextMarkerCommand}" ToolTip="Next marker" AutomationProperties.Name="Next marker" AutomationProperties.AutomationId="trace.nextMarker" />
                  </StackPanel>
                </Border>
              </WrapPanel>
              <DockPanel>
                <Slider Minimum="0" Maximum="100" VerticalAlignment="Center" MinWidth="140" Width="360"
                        IsEnabled="{Binding IsTraceLoaded}" Value="{Binding Trace.TimelinePercent, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Scrub the trace timeline" AutomationProperties.Name="Scrub the trace timeline" />
              </DockPanel>
            </StackPanel>
          </Expander>
          <Button x:Name="TraceSecondaryToggleButton" Content="Tabs &amp; focus ▾" Click="OnToggleTraceSecondaryClick" Margin="10,0,0,0"
                  AutomationProperties.AutomationId="trace.secondaryToggle" AutomationProperties.Name="Analysis tabs and quick focus"
                  ToolTip="Show or hide the analysis tabs and quick focus / jump-to-time bar." />
          <Button DockPanel.Dock="Right" Content="Analysis tools ▾" Click="OnToggleAnalysisToolsClick" Margin="10,0,0,0"
                  AutomationProperties.AutomationId="trace.analysisTools" AutomationProperties.Name="Analysis tools"
                  ToolTip="Show or hide the analysis tools: J1939, OBD-II, counters and checksums, bus load, DBC suggestion, E2E check, merge, trace tools and notes" />
          <Button DockPanel.Dock="Right" Content="Export visible…" AutomationProperties.AutomationId="trace.exportVisible" Command="{Binding Trace.ExportVisibleCommand}" Margin="10,0,0,0" IsEnabled="{Binding IsTraceLoaded}"
                  ToolTip="Export the currently visible (filtered) rows to ASC, CSV, TRC, BLF or MF4" />
          <Button DockPanel.Dock="Right" Content="Tools in window ↗" Click="OnPopOutTraceToolsClick"
                  AutomationProperties.AutomationId="trace.popOutTools"
                  ToolTip="Move optional J1939, OBD, health, rule and evidence controls to a separate resizable window so the raw trace table stays large on 13-inch displays"
                  Margin="6,0,0,0" />
          <Button DockPanel.Dock="Right" x:Name="TraceQueryBuilderButton" AutomationProperties.AutomationId="trace.queryBuilder" Content="Query builder…" Click="OnQueryBuilderClick" Margin="10,0,0,0"
                  ToolTip="Build a filter from conditions, hide noise, and save reusable queries"
                  AutomationProperties.Name="Open query builder" />
          <Button DockPanel.Dock="Right" Content="Health…" AutomationProperties.AutomationId="trace.health" Click="OnTraceHealthClick" Margin="10,0,0,0" IsEnabled="{Binding IsTraceLoaded}"
                  ToolTip="Open aggregate timing and missing-frame warnings for this trace" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding Trace.SelectedSourceByteEvidenceText}"
                     AutomationProperties.AutomationId="trace.sourceByteEvidence"
                     AutomationProperties.Name="{Binding Trace.SelectedSourceByteEvidenceText}"
                     Style="{StaticResource MutedText}" FontWeight="SemiBold"
                     MaxWidth="280" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     Visibility="{Binding Trace.HasSelectedSourceByteEvidence, Converter={StaticResource VisibleWhenTrue}}"
                     ToolTip="Selected original CAN payload bytes for the verified DID subparameter" />
        </WrapPanel>

        <!-- Quick analysis: always-visible, one-click offline lenses and direct time jump.
             Inspired by the efficient Trace/Data/Graphics workflow, not the Vector UI artwork. -->
        <!-- The tool area scrolls (MaxHeight is set in code from the window height) so expanded analysis
             tools can never push the frame table out of view. -->
        <StackPanel x:Name="TraceToolsPanel" Margin="0,0,0,8">
          <Border x:Name="TraceQuickFocusPanel" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="7,5" Margin="0,0,0,6" Visibility="Collapsed"
                  ToolTip="Quick analysis changes only the local Trace view. The original BLF/ASC capture is never altered.">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Time [s]" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TraceGoTimeBox" AutomationProperties.AutomationId="trace.goTime" Width="90" Height="29" Padding="6,4"
                         common:PlaceholderService.Text="12.345"
                         ToolTip="Jump to a trace timestamp (seconds); Relative time mode uses seconds since trace start. Ctrl+G."
                         AutomationProperties.Name="Jump to timestamp in seconds" KeyDown="OnTraceGoTimeKeyDown"/>
                <Button Content="Go" Style="{StaticResource ToolButton}" Margin="4,0,8,0"
                        Command="{Binding Trace.GoToTimeCommand}" CommandParameter="{Binding Text, ElementName=TraceGoTimeBox}"
                        ToolTip="Navigate directly to the nearest recorded frame at or after this time (Ctrl+G)"
                        AutomationProperties.Name="Go to timestamp" AutomationProperties.AutomationId="trace.jumpTime"/>
                <Button Content="UDS ↔ CAN pairs" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                        Command="{Binding ShowSelectedTraceFrameCorrelationsCommand}"
                        AutomationProperties.AutomationId="trace.relatedPairs"
                        ToolTip="Show observed DID/CAN pairs containing this exact recorded frame; the shortlist is not an automatically verified mapping"
                        AutomationProperties.Name="Find UDS to CAN correlation evidence for selected trace frame" />
                <Button Content="DBC bits" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                        Command="{Binding InspectSelectedTraceDbcCommand}"
                        ToolTip="Open the matched DBC message and show bit layout, scaling and enum meaning for its signals"
                        AutomationProperties.Name="Inspect selected frame in DBC manager"/>
                <Button Content="Inspect UDS" Style="{StaticResource AccentButton}" Padding="10,6"
                        Command="{Binding InspectSelectedTraceUdsCommand}"
                        ToolTip="Find the ISO-TP/UDS transaction containing the selected raw trace frame and show its request, response and decoded DID data"
                        AutomationProperties.Name="Inspect selected trace frame as UDS transaction"/>
              </StackPanel>
              <WrapPanel VerticalAlignment="Center">
                  <TextBlock Text="FOCUS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold"
                             VerticalAlignment="Center" Margin="2,0,8,0"/>
                  <Button Content="All" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="all"
                          ToolTip="Show all recorded frames again" AutomationProperties.Name="Show all frames"/>
                  <Button Content="UDS" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="uds"
                          ToolTip="Show UDS/ISO-TP traffic only, including learned diagnostic IDs" AutomationProperties.Name="Show UDS frames"/>
                  <Button Content="NRC" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="nrc"
                          ToolTip="Show negative UDS responses (NRC codes)" AutomationProperties.Name="Show negative UDS responses"/>
                  <Button Content="CAN errors" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="errors"
                          ToolTip="Only recorded CAN error frames, not diagnostic NRCs" AutomationProperties.Name="Show CAN error frames"/>
                  <Button Content="CAN FD" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="fd"
                          ToolTip="Focus on CAN FD frames" AutomationProperties.Name="Show CAN FD frames"/>
                  <Button Content="Changes" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="changes"
                          ToolTip="Show changes in message data rather than every cyclic frame" AutomationProperties.Name="Show changed payloads"/>
                  <Button Content="No DBC" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="unmatched"
                          ToolTip="Frames not decoded by any currently loaded DBC/ARXML, respecting bus assignment" AutomationProperties.Name="Show frames without database mapping"/>
                  <Button Content="Remote" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding Trace.QuickAnalysisCommand}" CommandParameter="remote"
                          ToolTip="Remote (RTR) CAN frames" AutomationProperties.Name="Show remote CAN frames"/>
                  <Button Content="UDS problems…" Style="{StaticResource ToolButton}" Margin="0,0,4,4"
                          Command="{Binding ShowUdsProblemsCommand}"
                          ToolTip="Open the diagnostic workspace with failed, missing and malformed UDS transactions"
                          AutomationProperties.Name="Investigate UDS problems"/>
                  <TextBlock Text="{Binding Trace.QuickLensLabel, StringFormat=' · {0}'}"
                             Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0"/>
                </WrapPanel>
            </DockPanel>
          </Border>
          <!-- File-health evidence is collapsed by default to preserve Trace
               working space on smaller Windows laptops. -->
          <Expander x:Name="TraceAnalysisToolsExpander" Header="Analysis tools — J1939 · OBD-II · counters/checksums · bus load · DBC suggestion · health · A/B measure · bookmarks" IsExpanded="False" Margin="0,0,0,6"
                    AutomationProperties.AutomationId="trace.moreTools">
          <StackPanel>
            <WrapPanel Margin="0,0,0,8">
              <Button Content="J1939 messages…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="j1939"
                      AutomationProperties.AutomationId="tools.j1939"
                      ToolTip="Reassembled multi-packet J1939 messages (BAM, RTS/CTS), DM1/DM2 fault codes and address claims, with source frames" />
              <Button Content="J1939 signals…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="j1939signals"
                      AutomationProperties.AutomationId="tools.j1939signals"
                      ToolTip="Decoded engine speed, vehicle speed, temperatures and other well-known J1939 parameters per source address, with min, max and not-available counts" />
              <Button Content="XCP / CCP…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="xcp"
                      AutomationProperties.AutomationId="tools.xcp"
                      ToolTip="Decode XCP-on-CAN (including CAN-FD) and CCP commands, responses, error codes and DAQ packets. The identifier pair is auto-detected from CONNECT handshakes, with confidence and evidence frames" />
              <Button Content="XCP + A2L…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="xcpa2l"
                      AutomationProperties.AutomationId="tools.xcpA2l"
                      ToolTip="Pick an optional A2L (ASAP2) file: SET_MTA, UPLOAD, DOWNLOAD and WRITE_DAQ addresses resolve to variable names, A2L XCP_ON_CAN identifiers are used, and DAQ lists configured in the trace are decoded" />
              <Button Content="OBD-II…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="obd"
                      AutomationProperties.AutomationId="tools.obd"
                      ToolTip="Decode OBD-II requests and responses (modes 01-0A) with PID values, DTCs and VIN" />
              <Button Content="Counters &amp; checksums…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="candidates"
                      AutomationProperties.AutomationId="tools.candidates"
                      ToolTip="Candidate rolling counters and checksum/CRC bytes for undocumented IDs (evidence only, never a definition)" />
              <Button Content="Bus load timeline…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="busload"
                      AutomationProperties.AutomationId="tools.busload"
                      ToolTip="Estimated per-second bus load per channel from the bitrate set in Statistics (nominal bits, no bit stuffing; never auto-detected). Statistics shows the whole-trace average." />
              <Button Content="E2E check…" Margin="0,0,6,4" Click="OnE2eCheckClick"
                      AutomationProperties.AutomationId="tools.e2e" AutomationProperties.Name="E2E check"
                      ToolTip="Check the AUTOSAR E2E counter and CRC (profiles 1, 2, 5) of one CAN ID in the loaded trace" />
              <Button Content="Trace tools…" Margin="0,0,6,4" Click="OnTraceToolsClick"
                      AutomationProperties.AutomationId="tools.traceTools" AutomationProperties.Name="Trace tools"
                      ToolTip="Cut, shift, split or remap channels and save as a new file (the original is never modified)" />
              <Button Content="Notes…" Margin="0,0,6,4" Click="OnNotesClick"
                      AutomationProperties.AutomationId="tools.annotations" AutomationProperties.Name="Notes"
                      ToolTip="Analyst notes attached to frames or time ranges, saved with the project and exportable" />
              <Button Content="Merge traces…" Margin="0,0,6,4" Click="OnMergeTracesClick"
                      AutomationProperties.AutomationId="tools.merge"
                      ToolTip="Merge several trace files (by time, sequential or separate channels) into a new file (originals are never modified)" />
              <Button Content="LIN frames…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="linframes"
                      AutomationProperties.AutomationId="tools.linFrames"
                      ToolTip="Recorded LIN frames with PID parity and classic/enhanced checksum verification (LIN is read from BLF)" />
              <Button Content="LIN timing…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="lintiming"
                      AutomationProperties.AutomationId="tools.linTiming"
                      ToolTip="Observed period, minimum, maximum and jitter per LIN frame ID" />
              <Button Content="LIN diagnostics…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="lindiag"
                      AutomationProperties.AutomationId="tools.linDiag"
                      ToolTip="LIN node configuration and UDS-on-LIN messages reassembled from frames 0x3C and 0x3D" />
              <Button Content="LIN signals (LDF)…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="linsignals"
                      AutomationProperties.AutomationId="tools.linSignals"
                      ToolTip="Choose a LIN Description File and decode its signals from the recorded LIN frames" />
              <Button Content="FlexRay matrix…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="flexray"
                      AutomationProperties.AutomationId="tools.flexray"
                      ToolTip="FlexRay slot and cycle matrix with inferred missing slots and recorder-flagged errors (FlexRay is read from BLF)" />
              <Button Content="CAN XL frames…" Margin="0,0,6,4" Click="OnBusReportClick" Tag="canxl"
                      AutomationProperties.AutomationId="tools.canxl"
                      ToolTip="CAN XL frame list: priority ID, VCID, SDT, SEC, acceptance field and payload" />
              <Button Content="Suggest best DBC…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="suggest"
                      AutomationProperties.AutomationId="tools.suggestDbc"
                      ToolTip="Rank the loaded DBCs per channel by how well they explain this trace" />
              <Button Content="DBC coverage…" Margin="0,0,6,4" Click="OnProtocolReportClick" Tag="dbccoverage"
                      AutomationProperties.AutomationId="tools.dbcCoverage"
                      ToolTip="Unmatched CAN IDs, payload bytes no signal covers and out-of-range physical values for each loaded DBC" />
            </WrapPanel>
          <Border Style="{StaticResource Card}" Padding="9,5" Margin="0,0,0,6">
            <StackPanel>
              <DockPanel>
                <ToggleButton x:Name="TraceImportHealthToggle" DockPanel.Dock="Left"
                              Style="{StaticResource SectionToggleButton}"
                              ToolTip="Show source import status, accepted CAN channels and rejected or skipped records"
                              AutomationProperties.Name="Show or hide CAN trace import quality">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▸" Margin="0,0,6,0"
                               Visibility="{Binding IsChecked, ElementName=TraceImportHealthToggle, Converter={StaticResource VisibleWhenFalse}}"/>
                    <TextBlock Text="▾" Margin="0,0,6,0"
                               Visibility="{Binding IsChecked, ElementName=TraceImportHealthToggle, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBlock Text="IMPORT HEALTH" Style="{StaticResource SectionTitle}" FontSize="11"/>
                  </StackPanel>
                </ToggleButton>
                <TextBlock Text="{Binding ImportHealthSummary}"
                           Style="{StaticResource MutedText}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                           ToolTip="{Binding ImportHealthSummary}"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <Grid Margin="0,8,0,2"
                    Visibility="{Binding IsChecked, ElementName=TraceImportHealthToggle, Converter={StaticResource VisibleWhenTrue}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" MinWidth="220"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="1.4*" MinWidth="250"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="ACCEPTED PHYSICAL CAN CHANNELS"
                             Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="10.5"
                             Margin="0,0,0,5"/>
                  <DataGrid x:Name="TraceImportChannelsGrid" ItemsSource="{Binding ImportChannelRows}" IsReadOnly="True"
                            AutoGenerateColumns="False" MaxHeight="165" CanUserSortColumns="True"
                            EnableRowVirtualization="True" FontSize="11"
                            AutomationProperties.Name="Imported CAN frames by bus">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Bus" Binding="{Binding ChannelText}" Width="72"/>
                      <DataGridTextColumn Header="Frames" Binding="{Binding Frames}" Width="*"/>
                      <DataGridTextColumn Header="FD" Binding="{Binding CanFdFrames}" Width="54"/>
                      <DataGridTextColumn Header="RTR" Binding="{Binding RemoteFrames}" Width="54"/>
                      <DataGridTextColumn Header="Error" Binding="{Binding ErrorFrames}" Width="57"/>
                      <DataGridTextColumn Header="Time order" Binding="{Binding OutOfOrderTimestamps}" Width="75"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="SKIPPED / INVALID RECORD EXAMPLES (BOUNDED)"
                             Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="10.5"
                             Margin="0,0,0,5"/>
                  <DataGrid x:Name="TraceImportIssuesGrid" ItemsSource="{Binding ImportIssueRows}" IsReadOnly="True"
                            AutoGenerateColumns="False" MaxHeight="165" CanUserSortColumns="True"
                            EnableRowVirtualization="True" FontSize="11"
                            AutomationProperties.Name="CAN trace import diagnostic examples">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="87"/>
                      <DataGridTextColumn Header="Reason" Binding="{Binding Code}" Width="155"/>
                      <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="65"/>
                      <DataGridTextColumn Header="Byte offset" Binding="{Binding ByteOffset}" Width="90"/>
                      <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="Only bounded diagnostic examples are shown. All aggregate counts remain available in the report; raw bytes and source lines are not copied into this panel."
                             Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap"
                             Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <!-- A/B measurement stays available across filters and does not modify bookmarks. -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                  ToolTip="Compare timestamps of any two selected frames. A and B remain pinned when you filter the trace.">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="MEASURE" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Set A" Style="{StaticResource ToolButton}" Padding="8,3" Margin="0,0,4,0"
                        Command="{Binding Trace.SetMeasurementCommand}" CommandParameter="a"
                        ToolTip="Pin measurement point A to the selected raw CAN frame"
                        AutomationProperties.Name="Set A measurement marker"/>
                <Button Content="Set B" Style="{StaticResource ToolButton}" Padding="8,3" Margin="0,0,4,0"
                        Command="{Binding Trace.SetMeasurementCommand}" CommandParameter="b"
                        ToolTip="Pin measurement point B to the selected raw CAN frame"
                        AutomationProperties.Name="Set B measurement marker"/>
                <Button Content="Clear A/B" Style="{StaticResource SubtleButton}" Padding="8,3"
                        Command="{Binding Trace.SetMeasurementCommand}" CommandParameter="clear"
                        ToolTip="Reset the two measurement points without deleting trace bookmarks"
                        AutomationProperties.Name="Clear measurement markers"/>
              </StackPanel>
              <TextBlock Text="{Binding Trace.MeasurementSummaryText}" Style="{StaticResource MutedText}"
                         FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Trace.MeasurementSummaryText}"/>
            </DockPanel>
          </Border>
          <!-- Bookmark rules remain optional; do not force advanced expression editing on first-time users. -->
          <Border Style="{StaticResource Card}" Padding="10,6">
          <StackPanel>
            <DockPanel>
              <ToggleButton x:Name="BookmarkRulesToggle" DockPanel.Dock="Left" Style="{StaticResource SectionToggleButton}"
                            ToolTip="Show/hide the bookmark rules panel"
                            AutomationProperties.Name="Show or hide bookmark rules">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="▸" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsChecked, ElementName=BookmarkRulesToggle, Converter={StaticResource VisibleWhenFalse}}" />
                  <TextBlock Text="▾" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsChecked, ElementName=BookmarkRulesToggle, Converter={StaticResource VisibleWhenTrue}}" />
                  <TextBlock Text="Bookmark rules" Style="{StaticResource SectionTitle}" FontSize="12" />
                </StackPanel>
              </ToggleButton>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedText}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                         Text="Mark every frame that matches one or more rules, e.g. id:18FEF100 · payload:62F190 · VehicleSpeed &gt; 20" />
            </DockPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0"
                       Visibility="{Binding IsChecked, ElementName=BookmarkRulesToggle, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
              <StackPanel Margin="0,0,10,4" VerticalAlignment="Top">
                <TextBlock Text="Rules (check = enabled)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceInputBrush}">
                  <ScrollViewer MaxHeight="98" VerticalScrollBarVisibility="Auto" Padding="4,2">
                    <ItemsControl ItemsSource="{Binding Trace.RuleLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,4,0"
                                      ToolTip="Enable/disable this rule without deleting it"
                                      AutomationProperties.Name="Enable this bookmark rule" />
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="218" Height="22" Padding="4,1" VerticalContentAlignment="Center"
                                     common:PlaceholderService.Text="id:18FEF100 · payload:62F190 · Signal &gt; 20"
                                     ToolTip="id:18FEF100 · payload:62F190 · Message.Signal &gt; 20"
                                     AutomationProperties.Name="Bookmark rule expression" />
                            <Button Content="✕" Padding="5,0" Margin="4,0,0,0" MinWidth="0"
                                    Command="{Binding DataContext.Trace.RemoveRuleLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Remove this rule row"
                                    AutomationProperties.Name="Remove this rule row" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <Button Content="+ Add rule" Style="{StaticResource SubtleButton}" Padding="4,1" HorizontalAlignment="Left" Margin="0,2,0,0"
                        Command="{Binding Trace.AddRuleLineCommand}" ToolTip="Add another rule row" />
              </StackPanel>
              <StackPanel Margin="0,0,10,4" VerticalAlignment="Top">
                <TextBlock Text="Set name" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                <TextBox Width="110" Height="24" Padding="6,2" Text="{Binding Trace.RuleSetName, UpdateSourceTrigger=PropertyChanged}"
                         common:PlaceholderService.Text="Rule set name"
                         ToolTip="Name used when saving this rule set for reuse"
                         AutomationProperties.Name="Rule set name" />
                <TextBlock Text="Saved sets" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,6,0,3" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox Width="112" Height="24"
                            ItemsSource="{Binding Trace.RuleBookmarkPresets}"
                            SelectedItem="{Binding Trace.SelectedRuleBookmark}"
                            DisplayMemberPath="Name"
                            ToolTip="Load a previously saved offline bookmark rule set"
                            AutomationProperties.Name="Saved bookmark rule sets" />
                  <Button Content="↺" Padding="4,0" Margin="4,0,0,0" MinWidth="0" Command="{Binding Trace.ReloadRuleBookmarkPresetCommand}"
                          ToolTip="Reload the selected set into the rows above, discarding any unsaved edits"
                          AutomationProperties.Name="Reload selected rule set" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,0,4" VerticalAlignment="Top">
                <TextBlock Text="Actions" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Bookmark rule" Style="{StaticResource AccentButton}" Padding="8,3" Command="{Binding Trace.ApplyRuleBookmarksCommand}" Margin="0,0,4,0"
                          ToolTip="Apply the enabled rule(s) above now: mark every matching frame in the trace" />
                  <Button Content="Save" Padding="8,3" Command="{Binding Trace.SaveRuleBookmarkPresetCommand}" Margin="0,0,4,0"
                          ToolTip="Save the current rule(s) under the set name for later reuse" />
                  <Button Content="Delete" Padding="8,3" Command="{Binding Trace.DeleteRuleBookmarkPresetCommand}" Margin="0,0,4,0"
                          ToolTip="Delete the selected saved rule set" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Content="All on" Padding="8,3" Command="{Binding Trace.EnableAllRulesCommand}" Margin="0,0,4,0"
                          ToolTip="Enable every rule row above" />
                  <Button Content="All off" Padding="8,3" Command="{Binding Trace.DisableAllRulesCommand}"
                          ToolTip="Disable every rule row above without deleting them" />
                </StackPanel>
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          </Border>
          </StackPanel>
          </Expander>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,8">
          <controls:TraceOverviewControl x:Name="TraceOverview"
                                         Frames="{Binding Frames}"
                                         CurrentPercent="{Binding Trace.TimelinePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>

        <GridSplitter x:Name="TraceOverviewSplitter" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnTraceOverviewResized"
                      ToolTip="Drag to resize the trace density overview" />

        <DataGrid Grid.Row="3" x:Name="TraceGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="trace.grid"
                  ItemsSource="{Binding Trace.Rows}"
                  SelectedItem="{Binding Trace.SelectedRow}"
                  IsReadOnly="True" CanUserSortColumns="False"
                  SelectionMode="Single"
                  ScrollViewer.CanContentScroll="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Item"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.CacheLength="0,0"
                  VirtualizingPanel.CacheLengthUnit="Page"
                  MouseDoubleClick="OnTraceGridMouseDoubleClick"
                  FontFamily="Consolas" FontSize="12.5">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open DBC message and bit layout"
                        Command="{Binding InspectSelectedTraceDbcCommand}"
                        ToolTip="Inspect actual DBC signal bit positions, endianness and named values for this CAN frame" />
              <MenuItem Header="Inspect selected UDS transaction" Click="OnTraceInspectUdsClick"
                        ToolTip="Jump to the diagnostic request/response containing this raw frame" />
              <MenuItem Header="Find related UDS ↔ CAN evidence"
                        Command="{Binding ShowSelectedTraceFrameCorrelationsCommand}"
                        ToolTip="Open recorded DID/CAN source-frame pairs that include this raw frame" />
              <Separator />
              <MenuItem Header="Filter by this ID"
                        Command="{Binding Trace.FilterBySelectedIdCommand}" />
              <MenuItem Header="Open original source frame"
                        Command="{Binding OpenOriginalTraceSourceCommand}"
                        ToolTip="Verify and open this frame in its source recording" />
              <MenuItem Header="Add all signals of this message to main plot (stay in Trace)"
                        Click="OnTracePlotSelectedMessageWithoutNavigationClick" />
              <MenuItem Header="Mark / unmark row"
                        Command="{Binding Trace.ToggleMarkerCommand}" />
              <MenuItem Header="Clear all markers"
                        Command="{Binding Trace.ClearMarkersCommand}" />
              <MenuItem Header="Compare marked frames (difference)" Click="OnTraceCompareFramesClick"
                        ToolTip="Mark frames with M, then compare their properties, payload bytes and decoded signals (min / max / mean)" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="DetailsVisibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                  <Setter Property="DetailsVisibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource ChangedRowHighlightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRowColour}" Value="True">
                  <Setter Property="Background" Value="{Binding RowColourBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Manual">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Timing">
                  <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Diagnostic">
                  <Setter Property="BorderBrush" Value="{DynamicResource PlotSeries4Brush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Range">
                  <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <!-- A stable detail height keeps the virtualised trace extent deterministic while
                   rows are recycled. The payload side scrolls locally only when CAN-FD content
                   exceeds the available space; at its boundary the wheel continues the trace. -->
              <Border Style="{StaticResource Card}" Margin="38,4,8,8" Padding="10" Height="310"
                      PreviewMouseWheel="OnTraceDetailPreviewMouseWheel">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="320" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel VerticalAlignment="Top">
                      <TextBlock Text="Frame detail" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding SourceEvidenceInfo}" Style="{StaticResource MutedText}"
                                 FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                 AutomationProperties.AutomationId="trace.rowSourceEvidence" />
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="82" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Payload" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding PayloadHex}" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Previous" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviousPayloadHex}" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Text="Changed" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChangedBytesText}" FontFamily="Consolas" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Text="Delta" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PayloadDeltaText}" FontFamily="Consolas" Foreground="{DynamicResource TealBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding MessageComment}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding IdentifierDetailTooltip}" Style="{StaticResource MutedText}"
                                 FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                 Visibility="{Binding Frame.IsExtended, Converter={StaticResource VisibleWhenTrue}}"
                                 ToolTip="J1939 fields are a possible 29-bit interpretation, not proof of the network protocol." />
                      <ItemsControl ItemsSource="{Binding PayloadBytes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Padding="4,2" Margin="0,1" CornerRadius="3">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="Transparent" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource ChangedByteHighlightBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSourceByte}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                      <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="34" />
                                  <ColumnDefinition Width="48" />
                                  <ColumnDefinition Width="48" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ByteLabel}" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.Name="{Binding EvidenceByteLabel}"
                                           ToolTip="{Binding EvidenceByteLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Previous}" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Current}" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>

                    <controls:DecodedSignalGrid Grid.Column="2"
                              SignalRows="{Binding DetailedSignals}"
                              MaxRowsHeight="286"
                              OpenSignalDetailRequested="OnSignalDetailRequested" />
                  </Grid>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Expand" Width="60" MinWidth="60" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- The arrow is the ONLY way to open/close the inline detail: clicking
                       anywhere else on the row (or on a scrollbar) just selects/scrolls and
                       never toggles the panel. -->
                  <Button Content="{Binding IsExpanded, Converter={StaticResource ExpandGlyph}}"
                          Click="OnToggleTraceRowDetailsClick"
                          Style="{StaticResource SubtleButton}" Padding="10,0"
                          HorizontalAlignment="Center" FontSize="12"
                          ToolTip="Open/close this row's decoded details inline; multiple rows can stay open"
                          AutomationProperties.Name="Toggle row decoded details" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Plot" Width="74" MinWidth="74" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="↗" Padding="6,1" Margin="0,0,4,0"
                            ToolTip="Quick Plot: open a separate graph window for this message's decoded signal (pick one if several)"
                            AutomationProperties.Name="Quick plot decoded signal of this message"
                            AutomationProperties.AutomationId="trace.rowQuickPlot"
                            Click="OnQuickPlotTraceRowClick" />
                    <Button Content="＋" Padding="6,1"
                            ToolTip="Add every decoded signal of this message to the main chart and stay on the Trace"
                            AutomationProperties.Name="Add decoded signals of this message to the chart"
                            AutomationProperties.AutomationId="trace.rowAddToChart"
                            Click="OnPlotTraceRowClick" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Mark" Binding="{Binding MarkerText}" Width="44" MinWidth="44" />
            <DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="46" MinWidth="46" />
            <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="78" MinWidth="78" />
            <DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="64" MinWidth="60">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="{Binding SourceEvidenceInfo}" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="34" MinWidth="34" />
            <DataGridTextColumn Header="Dir" Binding="{Binding DirectionText, Mode=OneWay}" Width="36" MinWidth="36" />
            <DataGridTextColumn Header="ID" Binding="{Binding IdentifierHex, Mode=OneWay}" Width="70" MinWidth="70">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="{Binding IdentifierDetailTooltip}"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu, Mode=OneWay}" Width="70" MinWidth="70" />
            <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="98" MinWidth="98" />
            <DataGridTextColumn Header="DLC" Binding="{Binding Length}" Width="38" MinWidth="38">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="{Binding LengthTooltip}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Flags" Binding="{Binding FlagsText}" Width="40" MinWidth="40" />
            <!-- Prioritize the decoded interpretation over auxiliary raw payload on 13-inch screens. -->
            <DataGridTextColumn Header="Interpretation" Binding="{Binding InterpretationText}" Width="2*" MinWidth="235">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding InterpretationText}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Data" Binding="{Binding PayloadHex}" Width="150" MinWidth="150" />
            <DataGridTextColumn Header="UDS" Binding="{Binding UdsText, Mode=OneWay}" Width="90" MinWidth="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding UdsText}" />
                  <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state: one guiding message instead of a blank grid. -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    AutomationProperties.AutomationId="trace.emptyState"
                    Visibility="{Binding IsTraceLoaded, Converter={StaticResource VisibleWhenFalse}}">
          <TextBlock Text="No trace loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,4,0,0"
                     Text="Click Open trace… above, or drag and drop a trace file anywhere in this window." />
        </StackPanel>
      </Grid>

      <!-- ============ DBC MANAGER (master-detail) ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=2}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: actions · search (kept on its own row so the coverage summary never overflows) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="Export definitions…" Command="{Binding ExportDbcDefinitionsCommand}"
                  Margin="8,0,0,0" ToolTip="Export DBC message, signal, value table and attribute definitions matching the current search (no trace required)"
                  AutomationProperties.Name="Export filtered DBC definitions to Excel" AutomationProperties.AutomationId="dbc.exportDefinitions" />
          <Button DockPanel.Dock="Left" Content="Load DBC…" AutomationProperties.AutomationId="dbc.load" Style="{StaticResource AccentButton}" Command="{Binding LoadDbcCommand}" Margin="0,0,8,0"
                  ToolTip="Load one or more DBC (or best-effort ARXML) CAN database files" />
          <Button DockPanel.Dock="Left" Content="Unload all DBCs" Command="{Binding ClearDbcCommand}" Margin="0,0,12,0"
                  ToolTip="Unload the database files from this analysis (original files remain untouched; staged DBC edits require confirmation)" />
          <TextBox DockPanel.Dock="Left" x:Name="DbcSearchBox" AutomationProperties.AutomationId="dbc.search" Width="340" Text="{Binding DbcCatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                   common:PlaceholderService.Text="🔍 Search databases, messages, signals, IDs…"
                   ToolTip="Search database, message, signal, unit, ID, transmitter or comment"
                   AutomationProperties.Name="Search DBC catalog" />
        </DockPanel>

        <!-- Row 1: live decode coverage summary and read-only version comparison -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Export DBC diff…" Margin="6,0,0,0"
                  Command="{Binding ExportDbcComparisonCommand}"
                  IsEnabled="{Binding HasDbcComparison}"
                  AutomationProperties.Name="Export DBC version differences to Excel or CSV ZIP" AutomationProperties.AutomationId="dbc.exportDiff"
                  ToolTip="Write the current parsed DBC comparison as a read-only multi-sheet XLSX or UTF-8 CSV archive" />
          <Button DockPanel.Dock="Right" Content="Merge DBCs…" Margin="6,0,0,0"
                  Click="OnMergeDbcsClick"
                  AutomationProperties.Name="Merge two DBC versions into a new DBC file" AutomationProperties.AutomationId="dbc.merge"
                  ToolTip="Review additions and conflicting changes between a base DBC and an incoming version, then save a new merged DBC. Neither source file is modified." />
          <Button DockPanel.Dock="Right" Content="Compare DBCs…" Margin="6,0,0,0"
                  Command="{Binding CompareDbcFilesCommand}"
                  AutomationProperties.Name="Compare two DBC file versions" AutomationProperties.AutomationId="dbc.compare"
                  ToolTip="Choose baseline and current DBC files. Compare exact CAN ID, 11/29-bit format, bit encoding, units, multiplexing and raw value meanings. Does not change active decoding." />
          <CheckBox DockPanel.Dock="Left" Content="Observed only"
                    IsChecked="{Binding DbcObservedOnly}" IsEnabled="{Binding IsTraceLoaded}"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="dbc.observedOnly"
                    ToolTip="Requires a loaded CAN Trace. Show only DBC messages and signals with recorded decoded samples; all source definitions remain intact." />
          <TextBlock Text="{Binding DecodeCoverageSummary}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <Expander x:Name="DbcDefinitionDiffExpander" AutomationProperties.AutomationId="dbc.diffExpander" Grid.Row="2" Header="DBC definition version comparison"
                  Visibility="{Binding HasDbcComparison, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                  IsExpanded="False" Margin="0,0,0,8"
                  AutomationProperties.Name="Read-only compared DBC message and signal definitions">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox Content="Changes only" IsChecked="{Binding DbcComparisonChangesOnly, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="0,0,12,5"
                        ToolTip="Show added, removed, changed and ambiguous definitions; export retains unchanged rows."
                        AutomationProperties.Name="Filter DBC version comparison to changes only" />
              <Button Content="Inspect baseline" Command="{Binding InspectBaselineDbcDiffCommand}"
                      IsEnabled="{Binding HasSelectedDbcComparisonDiff}" Margin="0,0,6,5"
                      ToolTip="Open the selected message or signal only when the exact baseline file is loaded and its parsed definitions still match."
                      AutomationProperties.Name="Inspect selected difference in loaded baseline DBC"/>
              <Button Content="Inspect current" Command="{Binding InspectCurrentDbcDiffCommand}"
                      IsEnabled="{Binding HasSelectedDbcComparisonDiff}" Margin="0,0,10,5"
                      ToolTip="Open the exact current CAN frame and signal if the loaded database matches the compared snapshot; ambiguous definitions are refused."
                      AutomationProperties.Name="Inspect selected difference in loaded current DBC"/>
              <TextBlock Text="{Binding DbcComparisonSummary}"
                         Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </WrapPanel>
            <DataGrid x:Name="DbcDefinitionDiffGrid" AutomationProperties.AutomationId="dbc.diffGrid" Height="160"
                      ItemsSource="{Binding DbcComparisonRows}"
                      SelectedItem="{Binding SelectedDbcComparisonDiffRow, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserSortColumns="True" EnableRowVirtualization="True"
                      SelectionMode="Single" FontSize="11">
              <DataGrid.Columns>
                <DataGridTextColumn Header="CAN ID" Binding="{Binding IdentifierText}" Width="78" />
                <DataGridTextColumn Header="Format" Binding="{Binding FrameFormat}" Width="68" />
                <DataGridTextColumn Header="Type" Binding="{Binding Scope}" Width="68" />
                <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="130" />
                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="90" />
                <DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="90" />
                <DataGridCheckBoxColumn Header="Review" Binding="{Binding RequiresReview}" Width="65" />
                <DataGridTextColumn Header="Changed fields" Binding="{Binding Differences}" Width="200" />
                <DataGridTextColumn Header="Before" Binding="{Binding BaselineDefinition}" Width="240" />
                <DataGridTextColumn Header="After" Binding="{Binding CurrentDefinition}" Width="240" />
                <DataGridTextColumn Header="Old message" Binding="{Binding BaselineMessage}" Width="100" />
                <DataGridTextColumn Header="New message" Binding="{Binding CurrentMessage}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Expander>

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="280" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Master: databases + options + unmatched diagnostics -->
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="120" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding DbcDatabases}"
                      SelectedItem="{Binding SelectedDbcDatabase}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                      SelectionMode="Single" FontSize="12" MaxHeight="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="DBC" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="Msg" Binding="{Binding MessageCount}" Width="52" MinWidth="52" />
                <DataGridTextColumn Header="Sig" Binding="{Binding SignalCount}" Width="56" MinWidth="56" />
                <DataGridTemplateColumn Header="" Width="46" MinWidth="46">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding WarningBadge}" Foreground="{DynamicResource WarningBrush}"
                                 ToolTip="{Binding WarningsText}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <!-- Options for the selected database -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,8"
                    Visibility="{Binding SelectedDbcDatabase, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
              <StackPanel>
                <TextBlock Text="{Binding SelectedDbcDatabase.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedDbcDatabase.Path, Converter={StaticResource MiddleEllipsis}, ConverterParameter=52}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDbcDatabase.Path}" />
                <TextBlock Text="{Binding SelectedDbcDatabase.CoverageText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <CheckBox Content="Match by J1939 PGN" IsChecked="{Binding SelectedDbcDatabase.MatchByPgn}"
                            ToolTip="Match trace frames to this DBC by Parameter Group Number, ignoring the source address. Enable for J1939 databases." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Bus" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox MinWidth="130" ItemsSource="{Binding SelectedDbcDatabase.ChannelChoices}"
                            SelectedIndex="{Binding SelectedDbcDatabase.ChannelIndex}"
                            ToolTip="Restrict this DBC to one bus so multi-bus traces are not mis-decoded"
                            AutomationProperties.Name="Bus channel" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedDbcDatabase.WarningsText}" Style="{StaticResource MutedText}" FontSize="11"
                           TextWrapping="Wrap" MaxHeight="70"
                           Visibility="{Binding SelectedDbcDatabase.HasWarnings, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                <Button Content="Remove this DBC" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding RemoveDbcCommand}" CommandParameter="{Binding SelectedDbcDatabase}"
                        ToolTip="Unload this database and re-run coverage" />
              </StackPanel>
            </Border>

            <!-- Why-unmatched diagnostics -->
            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="Unmatched trace IDs — why they did not match"
                         Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                         ToolTip="When exactly one loaded DBC can explain an ID (channel assignment or J1939 PGN), RBG CAN Insight fixes its options automatically the first time the ID is seen. Hover a row's Hint for details; ambiguous cases still need a manual pick in the database options above." />
              <DataGrid ItemsSource="{Binding UnmatchedIdentifiers}" IsReadOnly="True"
                        AutoGenerateColumns="False" CanUserSortColumns="True" FontSize="11.5" MinRowHeight="26">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="36" MinWidth="36" />
                  <DataGridTextColumn Header="ID" Binding="{Binding IdentifierText}" SortMemberPath="Identifier" Width="100" MinWidth="100" />
                  <DataGridTextColumn Header="Frames" Binding="{Binding FrameCount}" Width="64" MinWidth="64" />
                  <DataGridTextColumn Header="Hint" Binding="{Binding Hint}" Width="*" MinWidth="180">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="ToolTip" Value="{Binding Hint}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>

          <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

          <!-- Detail: DBC messages → signals → bit-level inspector and live trace proof. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="1.1*" MinHeight="100" />
              <RowDefinition Height="7" />
              <RowDefinition Height="1*" MinHeight="100" />
              <RowDefinition Height="0" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="DbcMessagesGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" Grid.Row="0"
                      AutomationProperties.AutomationId="dbc.messagesGrid"
                      AutomationProperties.Name="DBC message definitions with observed trace coverage"
                      ItemsSource="{Binding DbcMessages}" SelectedItem="{Binding SelectedDbcMessage}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                      SelectionMode="Single" FontSize="12.2"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
              <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Filter trace by this ID" Command="{Binding FilterTraceByIdentifierCommand}"
                            CommandParameter="{Binding SelectedDbcMessage.Identifier}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="DBC" Binding="{Binding Database}" Width="130" MinWidth="130" />
                <DataGridTemplateColumn Header="Source file" Width="150" MinWidth="150" SortMemberPath="SourceFile">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SourceFile, Converter={StaticResource MiddleEllipsis}, ConverterParameter=26}"
                                 ToolTip="{Binding SourceFile}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="90" MinWidth="90" />
                <DataGridTextColumn Header="Message" Binding="{Binding Name}" Width="200" MinWidth="200" />
                <DataGridTextColumn Header="TX" Binding="{Binding Transmitter}" Width="110" MinWidth="110" />
                <DataGridTextColumn Header="DLC" Binding="{Binding Length}" Width="55" MinWidth="55" />
                <DataGridTextColumn Header="Cycle ms" Binding="{Binding NominalCycleText}" Width="75" MinWidth="68" />
                <DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" Width="70" MinWidth="70" />
                <DataGridTextColumn Header="Trace coverage" Binding="{Binding CoverageText}" Width="120" MinWidth="120" />
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="ToolTip" Value="{Binding Comment}" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="{Binding DbcDetailScopeText}"
                         Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
              <DataGrid x:Name="DbcSignalsGrid" AutomationProperties.AutomationId="dbc.signalsGrid"
                        AutomationProperties.Name="DBC signal definitions, bit layout and recorded source"
                        ItemsSource="{Binding DbcSignals}" SelectedItem="{Binding SelectedDbcSignal}"
                        SelectionMode="Single" IsReadOnly="True"
                        AutoGenerateColumns="False" CanUserSortColumns="True" FontSize="12.2"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="190" MinWidth="190" />
                  <DataGridTextColumn Header="Trace evidence" Binding="{Binding ObservedText}" Width="156" MinWidth="140" />
                  <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu}" Width="100" MinWidth="100" />
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="150" MinWidth="150" />
                  <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="85" MinWidth="85" />
                  <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" MinWidth="60" />
                  <DataGridTextColumn Header="Start" Binding="{Binding StartBit}" Width="55" MinWidth="55" />
                  <DataGridTextColumn Header="Bits" Binding="{Binding BitLength}" Width="50" MinWidth="50" />
                  <DataGridTextColumn Header="Endian" Binding="{Binding ByteOrderText}" Width="98" MinWidth="98" />
                  <DataGridTextColumn Header="Type" Binding="{Binding EncodingText}" Width="77" MinWidth="77" />
                  <DataGridTextColumn Header="Mux" Binding="{Binding MultiplexText}" Width="62" MinWidth="62" />
                  <DataGridTextColumn Header="VAL_" Binding="{Binding NamedValuesCount}" Width="58" MinWidth="58" />
                  <DataGridTextColumn Header="Range" Binding="{Binding RangeText}" Width="130" MinWidth="130" />
                  <DataGridTextColumn Header="Scaling" Binding="{Binding ScalingText}" Width="120" MinWidth="120" />
                  <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Comment}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>

            <Border Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,7,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Signal inspector ↗" Style="{StaticResource AccentButton}"
                        Click="OnOpenDbcInspectorClick" AutomationProperties.AutomationId="dbc.openInspector"
                        ToolTip="Open bit layout, encoding, value meanings, recorded evidence and DBC editing in a large separate window" />
                <TextBlock Text="{Binding DbcInspector.Header}" Style="{StaticResource SectionTitle}" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- ============ SIGNALS & PLOT ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=3}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="6" />
          <RowDefinition Height="220" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Row 0: plot actions · playback transport (mirrors the trace view's toolbar split) -->
        <ScrollViewer Grid.Row="0" Margin="0,0,0,6" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="signals.primaryToolbar">
          <StackPanel Orientation="Horizontal">
          <Button Content="Plot selected" AutomationProperties.AutomationId="signals.plotSelected"
                  Style="{StaticResource AccentButton}" Click="OnPlotSelectedSignalClick"
                  ToolTip="Add the selected recorded signal to the chart, keeping existing curves; select a row below first"
                  Margin="0,0,8,0" />
          <Button Content="Add visible (max 24)" AutomationProperties.AutomationId="signals.plotVisible"
                  Command="{Binding Signals.PlotFilteredCommand}" Click="OnPlotWindowControlClick" Margin="0,0,8,0"
                  ToolTip="Add up to 24 visible filtered signals. Existing plotted curves are preserved; narrow the search to select a specific source." />
          <Button Content="Discover signal groups…" Click="OnDiscoverSignalGroupsClick" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="signals.discoverGroups"
                  ToolTip="Automatically discover source-qualified groups of recorded signals, without a DTC or preselected signal." />
          <Button Content="Find related signals…" Click="OnFindRelatedSignalsClick" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="signals.findRelations"
                  ToolTip="From the selected original CAN signal, discover other observed signals moving together, before or after. No causal claim." />
          <Button Content="Charts…" Click="OnSignalChartsClick" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="signals.charts" AutomationProperties.Name="Signal charts"
                  ToolTip="Histogram, XY plot and spectrum of recorded signals in a separate window" />
          <Button Content="Derived signals…" Click="OnOpenDerivedSignals" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="tools.derived" AutomationProperties.Name="Derived signals"
                  ToolTip="Compute a new signal from recorded ones with a formula (offline, from recorded samples only)" />
          <Button Content="Signal analysis…" AutomationProperties.AutomationId="signals.analyze" Click="OnAnalyzeSignalClick" Margin="0,0,8,0"
                  ToolTip="Statistics, time-weighted histogram, constant runs and dominant frequency of the selected recorded signal, in a separate window" />
          <Button Content="Clear plot" AutomationProperties.AutomationId="signals.clearPlot" Command="{Binding Signals.ClearPlotsCommand}" Margin="0,0,8,0" />
          <Button Content="Export decoded…" AutomationProperties.AutomationId="signals.exportDecoded" Command="{Binding ExportDecodedSignalsCommand}" Margin="0,0,8,0" />
          <Button Command="{Binding Signals.TogglePlaybackCommand}" Margin="0,0,8,0">
            <Button.Content>
              <Binding Path="Signals.PlaybackButtonText" />
            </Button.Content>
          </Button>
          <TextBlock Text="Speed" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Width="76" ItemsSource="{Binding Signals.PlaybackSpeedChoices}"
                    SelectedItem="{Binding Signals.PlaybackSpeed}" ToolTip="Plot replay speed multiplier" Margin="0,0,8,0"
                    AutomationProperties.Name="Plot playback speed" />
          <CheckBox Content="Cumulative" IsChecked="{Binding Signals.IsCumulativeReveal}" VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Reveal plotted signals from the first sample up to the current playback time instead of sliding a fixed window" />
          <TextBlock Text="Y axis" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Width="104" ItemsSource="{Binding Signals.YAxisModeChoices}"
                    SelectedIndex="{Binding Signals.YAxisModeIndex}" Margin="0,0,8,0"
                    ToolTip="Auto switches to one scale per signal when plotted units are mixed, so signals with very different ranges (e.g. RPM and a temperature) don't flatten each other"
                    AutomationProperties.Name="Y axis scaling mode" />
          <Button Content="Head" Command="{Binding Signals.HeadCommand}" Margin="0,0,4,0" />
          <Button Content="Prev" Command="{Binding Signals.PreviousCommand}" Margin="0,0,4,0" />
          <Button Content="Next" Command="{Binding Signals.NextCommand}" Margin="0,0,4,0" />
          <Button Content="Tail" Command="{Binding Signals.TailCommand}" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="signals.tail" />
          <TextBlock Text="{Binding Signals.SummaryText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="signals.summary" />
          </StackPanel>
        </ScrollViewer>

        <!-- Row 1: search and recovery first; window controls remain horizontally scrollable -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,8"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="signals.viewToolbar">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Recording" Margin="0,0,5,0" VerticalAlignment="Center"
                       Visibility="{Binding Signals.HasMultipleLoggers, Converter={StaticResource VisibleWhenTrue}}" />
            <ComboBox Width="210" Margin="0,0,8,0"
                      ItemsSource="{Binding Signals.LoggerChoices}"
                      DisplayMemberPath="Name" SelectedValuePath="SourceIndex"
                      SelectedValue="{Binding Signals.SelectedLoggerIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding Signals.HasMultipleLoggers, Converter={StaticResource VisibleWhenTrue}}"
                      AutomationProperties.AutomationId="signals.loggerScope"
                      AutomationProperties.Name="Select original recording for catalog and main chart"
                      ToolTip="Scope the signal catalog and main chart to one physical logger. Checked plots from other loggers are retained; standalone Quick Plot windows are independent." />
            <TextBox x:Name="SignalsSearchBox" AutomationProperties.AutomationId="signals.search"
                     Width="260" Margin="0,0,8,0"
                     Text="{Binding Signals.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     common:PlaceholderService.Text="Signal, CAN ID, logger:2, bus…"
                     ToolTip="Search one or more recorded properties: logger:2 EngineSpeed, ch2 EngCoolantTemp, sa:0xFE, pgn:0xF004. Logger numbering starts at 1 and refers to the original physical file; SA/PGN apply only to 29-bit frames. Ctrl+F focuses search; Esc clears."
                     AutomationProperties.Name="Search observed signal catalog" />
            <Button Content="Clear filters" Margin="0,0,10,0"
                    AutomationProperties.AutomationId="signals.clearFilters"
                    Command="{Binding Signals.ResetSignalFiltersCommand}"
                    ToolTip="Show signals from all original recordings, preserving plotted curve selections and watch list" />
            <TextBlock Text="{Binding Signals.StatusText}" Style="{StaticResource MutedText}"
                       MaxWidth="185" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Signals.StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Zoom +" Command="{Binding Signals.ZoomInCommand}" Click="OnPlotWindowControlClick"
                    Padding="8,6" Margin="0,0,4,0" ToolTip="Zoom in: smaller time window" AutomationProperties.Name="Zoom in" />
            <Button Content="Zoom −" Command="{Binding Signals.ZoomOutCommand}" Click="OnPlotWindowControlClick"
                    Padding="8,6" Margin="0,0,4,0" ToolTip="Zoom out: larger time window" AutomationProperties.Name="Zoom out" />
            <Button Content="Fit" Command="{Binding Signals.FitAllCommand}" Click="OnPlotWindowControlClick"
                    Margin="0,0,4,0" ToolTip="Fit the full observed trace time span" />
            <Button Content="10s" Command="{Binding Signals.LastSecondsCommand}" CommandParameter="10"
                    Click="OnPlotWindowControlClick" Padding="8,6" Margin="0,0,4,0" />
            <Button Content="30s" Command="{Binding Signals.LastSecondsCommand}" CommandParameter="30"
                    Click="OnPlotWindowControlClick" Padding="8,6" Margin="0,0,4,0" />
            <Button Content="60s" Command="{Binding Signals.LastSecondsCommand}" CommandParameter="60"
                    Click="OnPlotWindowControlClick" Padding="8,6" Margin="0,0,8,0" />
            <TextBlock Text="Window (s)" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="62" Text="{Binding Signals.PlotTimeWindowSeconds, UpdateSourceTrigger=LostFocus}"
                     Margin="0,0,8,0" AutomationProperties.AutomationId="signals.windowSeconds"
                     AutomationProperties.Name="Plot time window in seconds" />
            <Button Content="Reset wheel zoom" Click="OnResetZoom" Margin="0,0,8,0"
                    ToolTip="Discard only the manual mouse-wheel zoom and follow the timeline/window controls again" />
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <controls:SignalPlotControl x:Name="Plot"
                                        AutomationProperties.AutomationId="signals.chart"
                                        AutomationProperties.Name="Observed CAN signal plot"
                                        AutomationProperties.HelpText="Hover any line to read the original CAN time, value, held age, change delta and frame. Small circles mark a thinned subset of real changed samples. Click X1; Shift-click X2; Ctrl-click opens the exact original CAN frame when available; mouse wheel zooms; Shift-wheel pans."
                                        ItemsSource="{Binding Signals.ChartSeries}"
                                        CursorTimestampNanoseconds="{Binding PlotCursorNanoseconds}"
                                        TimeWindowSeconds="{Binding Signals.PlotTimeWindowSeconds}"
                                        WindowEndTimestampNanoseconds="{Binding Signals.PlotWindowEndNanoseconds}"
                                        GlobalStartTimestampNanoseconds="{Binding Signals.TimelineStartNanoseconds}"
                                        GlobalEndTimestampNanoseconds="{Binding Signals.TimelineEndNanoseconds}"
                                        CumulativeReveal="{Binding Signals.IsCumulativeReveal}"
                                        YAxisModeIndex="{Binding Signals.YAxisModeIndex}"
                                        LinearInterpolation="{Binding Signals.LinearInterpolation}"
                                        ShowInlineLegend="{Binding Signals.ShowInlineLegend}"
                                        MarkerTimestamps="{Binding Trace.MarkedTimestamps}" />
          </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"
                      ToolTip="Drag to resize the watch list / signal list panel" />

        <Grid Grid.Row="4" Margin="0,2,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding WatchSignals.Count, Converter={StaticResource CollapsibleRowHeight}, ConverterParameter=86}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="{Binding Signals.OfflinePlotNavigationText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <Slider DockPanel.Dock="Right" Width="320" Minimum="0" Maximum="100"
                    AutomationProperties.AutomationId="signals.timeline"
                    Value="{Binding Signals.TimelinePercent, UpdateSourceTrigger=PropertyChanged}"
                    Thumb.DragStarted="OnSignalsTimelineDragStarted"
                    PreviewMouseLeftButtonDown="OnSignalsTimelinePreviewMouseDown"
                    ToolTip="Scrub the main plot's time position"
                    AutomationProperties.Name="Scrub the main plot's time position" />
          </DockPanel>
          <DataGrid Grid.Row="1" x:Name="WatchGrid"
                    ItemsSource="{Binding WatchSignals}"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    FontSize="12"
                    Margin="0,0,0,6">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Watch ECU" Binding="{Binding Ecu}" Width="105" MinWidth="105" />
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.2*" MinWidth="120" />
              <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="1.4*" MinWidth="140" />
              <DataGridTextColumn Header="Value at cursor" Binding="{Binding ValueText}" Width="130" MinWidth="130" />
              <DataGridTextColumn Header="Sample time" Binding="{Binding TimeText}" Width="120" MinWidth="120" />
              <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="90" MinWidth="90" />
              <DataGridTemplateColumn Header="" Width="48" MinWidth="48">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="✕" ToolTip="Remove from watch list"
                            AutomationProperties.Name="Remove from watch list"
                            Command="{Binding DataContext.RemoveWatchSignalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Padding="8,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="2" Margin="2,1,0,5"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="◀ Change" Command="{Binding Signals.PreviousChangeCommand}" Margin="0,0,4,0" Padding="7,3"
                      AutomationProperties.AutomationId="signals.previousChange"
                      ToolTip="Move to the previous actual decoded value transition of the selected signal" />
              <Button Content="Change ▶" Command="{Binding Signals.NextChangeCommand}" Margin="0,0,4,0" Padding="7,3"
                      AutomationProperties.AutomationId="signals.nextChange"
                      ToolTip="Move to the next actual decoded value transition of the selected signal" />
              <Button Content="Nearby changes…" Click="OnFindNearbySignalChangesClick"
                      AutomationProperties.AutomationId="signals.findNearbyChanges"
                      ToolTip="Find decoded signals that changed within ±5 seconds of the selected signal and cursor, matching the physical logger. No causal claims."
                      Padding="7,3" Margin="0,0,8,0" />
              <Button Content="Source frame" Command="{Binding OpenSelectedPlotSourceCommand}" Padding="7,3" Margin="0,0,12,0"
                      AutomationProperties.AutomationId="signals.openSourceFrame"
                      ToolTip="Open the exact recorded CAN frame associated with the selected signal value at plot time" />
              <CheckBox Content="Changing only" IsChecked="{Binding Signals.ChangingOnly}"
                        AutomationProperties.AutomationId="signals.changingOnly"
                        ToolTip="Only decoded signals whose recorded physical value changed at least once"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
              <CheckBox Content="Plotted only" IsChecked="{Binding Signals.PlottedOnly}"
                        AutomationProperties.AutomationId="signals.plottedOnly"
                        ToolTip="Show only signals selected for the main chart"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
              <CheckBox Content="Linear lines" IsChecked="{Binding Signals.LinearInterpolation}"
                        AutomationProperties.AutomationId="signals.linearInterpolation"
                        ToolTip="Optional straight-line visual interpolation between recorded CAN samples; off = sample-and-hold"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
              <CheckBox Content="Chart labels" IsChecked="{Binding Signals.ShowInlineLegend}"
                        AutomationProperties.AutomationId="signals.chartLabels"
                        ToolTip="Floating chart labels; signal rows always contain the curve colors"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Signals.VisibleSeriesSummary}" Style="{StaticResource MutedText}"
                         AutomationProperties.AutomationId="signals.visibleCount"
                         Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Signals.SelectedSeriesText}" Style="{StaticResource MutedText}"
                         AutomationProperties.AutomationId="signals.selectedSource"
                         MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip="Selected recorded signal for change navigation and exact source-frame lookup" />
              <TextBlock Text="{Binding Signals.SelectedSignalCursorReadout}" Style="{StaticResource MutedText}"
                         AutomationProperties.AutomationId="signals.cursorReadout"
                         MaxWidth="470" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip="{Binding Signals.SelectedSignalCursorReadout}" />
            </WrapPanel>
          </ScrollViewer>
          <Grid Grid.Row="3">
          <DataGrid x:Name="SignalsGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="signals.grid"
                    ItemsSource="{Binding Signals.FilteredSeries}"
                    SelectedItem="{Binding Signals.SelectedSeries, Mode=TwoWay}"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    AutoGenerateColumns="False"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    MouseDoubleClick="OnSignalSeriesDoubleClick">
            <DataGrid.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Toggle plot" Click="OnToggleSignalPlotClick" />
                <Separator />
                <MenuItem Header="Filter trace by this ID" Command="{Binding FilterTraceByIdentifierCommand}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem.IdentifierHex, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
              <!-- The mini-plot opens ONLY via the Expand arrow (or a row double-click), never
                   by mere selection — so browsing the list cannot pop charts open by accident. -->
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="DetailsVisibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.RowDetailsTemplate>
              <DataTemplate>
                <!-- Inline mini-plot of this one signal over the FULL trace: deliberately not
                     bound to the playback window/timeline, which drives the main plot above. -->
                <Border Style="{StaticResource Card}" Margin="8,4,8,8" Padding="8" Height="200" ClipToBounds="True">
                  <controls:SignalPlotControl
                      AutomationProperties.Name="Single recorded CAN signal preview"
                      ItemsSource="{Binding Converter={StaticResource SingleSeries}}"
                      IgnorePlottedFilter="True"
                      CursorTimestampNanoseconds="{Binding DataContext.PlotCursorNanoseconds, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border>
              </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Signal" Binding="{Binding SignalName, Mode=OneWay}" Width="200" MinWidth="140" IsReadOnly="True" />
              <DataGridTemplateColumn Header="Value @ cursor" Width="*" MinWidth="130" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource SignalAtPlotCursor}">
                          <Binding />
                          <Binding Path="DataContext.Signals.PlotWindowEndNanoseconds"
                                   RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Last source" Width="*" MinWidth="112" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTipService.ShowDuration="30000">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource SignalSourceAgeAtPlotCursor}">
                          <Binding />
                          <Binding Path="DataContext.Signals.PlotWindowEndNanoseconds"
                                   RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </TextBlock.Text>
                      <TextBlock.ToolTip>
                        <MultiBinding Converter="{StaticResource SignalSourceAgeAtPlotCursor}"
                                      ConverterParameter="provenance">
                          <Binding />
                          <Binding Path="DataContext.Signals.PlotWindowEndNanoseconds"
                                   RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </TextBlock.ToolTip>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Quick" Width="86" MinWidth="80" CanUserReorder="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="↗ Plot" Click="OnQuickPlotSeriesClick"
                            ToolTip="Open an independent Quick Plot window for this exact recorded CAN signal (Ctrl+Enter with the row selected)"
                            AutomationProperties.AutomationId="signals.quickPlot"
                            AutomationProperties.Name="Quick plot recorded signal"
                            Style="{StaticResource SubtleButton}" Padding="8,1" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Plot" Width="55" MinWidth="55">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsPlotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                              ToolTip="Draw this signal in the main plot above"
                              AutomationProperties.Name="Plot this signal in the main plot" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Expand" Width="62" MinWidth="62" CanUserReorder="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{Binding IsDetailOpen, Converter={StaticResource ExpandGlyph}}"
                            Click="OnToggleSignalDetailClick"
                            Style="{StaticResource SubtleButton}" Padding="10,0"
                            HorizontalAlignment="Center" FontSize="12"
                            ToolTip="Open/close this signal's inline mini-plot (full trace); multiple rows can stay open"
                            AutomationProperties.Name="Toggle signal mini-plot" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="34" MinWidth="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding PlotColor}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Recording" Binding="{Binding RecordingText, Mode=OneWay}" Width="155" MinWidth="125" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding RecordingPath}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding RecordingText}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="CAN" Binding="{Binding ChannelText, Mode=OneWay}" Width="70" MinWidth="65" IsReadOnly="True" />
              <DataGridTextColumn Header="Message" Binding="{Binding MessageName, Mode=OneWay}" Width="170" MinWidth="170" IsReadOnly="True" />
              <DataGridTextColumn Header="Activity" Binding="{Binding ActivityText, Mode=OneWay}" Width="112" MinWidth="100" IsReadOnly="True" />
              <DataGridTextColumn Header="DBC" Binding="{Binding DatabaseName, Mode=OneWay}" Width="110" MinWidth="95" IsReadOnly="True" />
              <DataGridTextColumn Header="ECU/TX" Binding="{Binding Transmitter, Mode=OneWay}" Width="110" MinWidth="110" IsReadOnly="True" />
              <DataGridTextColumn Header="Source ID" Binding="{Binding IdentifierHex, Mode=OneWay}" Width="105" MinWidth="98" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding SourceIdentifierDetailText}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding SourceIdentifierDetailText}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount, Mode=OneWay}" Width="90" MinWidth="90" IsReadOnly="True" />
              <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=OneWay}" Width="70" MinWidth="70" IsReadOnly="True" />
              <DataGridTextColumn Header="Comment / info" Binding="{Binding ToolTipText, Mode=OneWay}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding Signals.EmptySignalsText}" Style="{StaticResource MutedText}"
                     AutomationProperties.AutomationId="signals.empty"
                     Visibility="{Binding Signals.FilteredSeries.Count, Converter={StaticResource NavVisibility}, ConverterParameter=0}"
                     IsHitTestVisible="False" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="520" Margin="24" FontSize="13" />
          </Grid>
        </Grid>
      </Grid>

      <!-- ============ CHANGE MATRIX ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=4}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding Matrix.SelectedRow, Converter={StaticResource CollapsibleRowHeight}, ConverterParameter=6}" />
          <RowDefinition Height="{Binding Matrix.SelectedRow, Converter={StaticResource CollapsibleRowHeight}, ConverterParameter=200}" MinHeight="0" />
        </Grid.RowDefinitions>

        <!-- Row 0: search · filter · sort (kept on its own row so the summary/min-step/export row never overflows) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <TextBox DockPanel.Dock="Left" x:Name="MatrixSearchBox" AutomationProperties.AutomationId="matrix.search" Width="260" Text="{Binding Matrix.SearchText, UpdateSourceTrigger=PropertyChanged}"
                   common:PlaceholderService.Text="🔍 Search ECU, signal, message or ID…"
                   ToolTip="Search ECU, signal, message, comment, unit or ID"
                   AutomationProperties.Name="Search ECU, signal, message or ID" />
          <ComboBox DockPanel.Dock="Left" Margin="8,0,0,0" MinWidth="130"
                    SelectedIndex="{Binding Matrix.ActivityFilterIndex}"
                    ToolTip="Filter rows by activity classification"
                    AutomationProperties.Name="Activity filter">
            <ComboBoxItem Content="All signals" />
            <ComboBoxItem Content="Changed only" />
            <ComboBoxItem Content="Stable" />
            <ComboBoxItem Content="Anomalous" />
            <ComboBoxItem Content="Missing" />
          </ComboBox>
          <ComboBox DockPanel.Dock="Left" Margin="8,0,0,0" MinWidth="170"
                    SelectedIndex="{Binding Matrix.SortIndex}"
                    ToolTip="Choose how rows are ordered"
                    AutomationProperties.Name="Sort order">
            <ComboBoxItem Content="Sort: changes ↓" />
            <ComboBoxItem Content="Sort: amplitude ↓" />
            <ComboBoxItem Content="Sort: largest step ↓" />
            <ComboBoxItem Content="Sort: name" />
            <ComboBoxItem Content="Sort: last change ↓" />
          </ComboBox>
        </DockPanel>

        <!-- Row 1: min-step filter · export · live summary -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Text="Min step:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBox DockPanel.Dock="Left" Width="70" Text="{Binding Matrix.MinDelta, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Hide signals whose largest observed change is smaller than this value"
                   AutomationProperties.Name="Minimum step filter" />
          <TextBlock DockPanel.Dock="Left" Text="Recording" VerticalAlignment="Center"
                     Style="{StaticResource MutedText}" Margin="10,0,4,0"
                     Visibility="{Binding Matrix.HasMultipleLoggers, Converter={StaticResource VisibleWhenTrue}}" />
          <ComboBox DockPanel.Dock="Left" Width="190" Margin="0,0,8,0"
                    ItemsSource="{Binding Matrix.LoggerChoices}"
                    DisplayMemberPath="Name" SelectedValuePath="SourceIndex"
                    SelectedValue="{Binding Matrix.SelectedLoggerIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding Matrix.HasMultipleLoggers, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.AutomationId="matrix.loggerScope"
                    AutomationProperties.Name="Select original recording for Change Matrix"
                    ToolTip="Filter signal activity, missing findings, change details and exports to this original recording. No cross-logger clock alignment is assumed." />
          <Button DockPanel.Dock="Left" Content="Export…" Command="{Binding Matrix.ExportCommand}" Margin="10,0,0,0"
                  ToolTip="Export the current Change Matrix rows" />
          <TextBlock Text="{Binding Matrix.SummaryText}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="MatrixGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="matrix.grid" ItemsSource="{Binding Matrix.Rows}" SelectedItem="{Binding Matrix.SelectedRow}"
                  IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" FontSize="12.5"
                  MouseDoubleClick="OnMatrixRowDoubleClick">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Plot selected signal" Command="{Binding Matrix.PlotSelectedCommand}" />
              <MenuItem Header="Filter trace by this ID" Command="{Binding FilterTraceByIdentifierCommand}"
                        CommandParameter="{Binding Matrix.SelectedRow.IdentifierHex}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Actions" Width="72" MinWidth="72" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="∿" ToolTip="Plot this signal"
                          AutomationProperties.Name="Plot this signal"
                          Click="OnPlotMatrixRowClick" Padding="8,2" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Activity" Width="90" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Activity, Converter={StaticResource ActivityBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActivityText}" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Ordered by what an analyst scans for first: what the signal is and how it's
                 behaving, before secondary bus metadata and least-often-needed exact timestamps. -->
            <DataGridTextColumn Header="Recording" Binding="{Binding RecordingText}" Width="150" MinWidth="125">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding OriginalSourcePath}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="CAN" Binding="{Binding ChannelText}" Width="65" MinWidth="60" />
            <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="1.1*" MinWidth="120" />
            <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="1.3*" MinWidth="140" />
            <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="Last" Binding="{Binding LastValueText}" Width="0.8*" MinWidth="85" />
            <DataGridTextColumn Header="First" Binding="{Binding FirstValueText}" Width="0.8*" MinWidth="85" />
            <DataGridTextColumn Header="Amplitude" Binding="{Binding AmplitudeText}" Width="0.8*" MinWidth="90" />
            <DataGridTextColumn Header="Largest step" Binding="{Binding LargestDeltaText}" Width="0.9*" MinWidth="100" />
            <DataGridTextColumn Header="Min … Max" Binding="{Binding MinMaxText}" Width="1.1*" MinWidth="140" />
            <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu, Mode=OneWay}" Width="105" MinWidth="105" />
            <DataGridTextColumn Header="ID" Binding="{Binding IdentifierHex, Mode=OneWay}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" MinWidth="60" />
            <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount, Mode=OneWay}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="First change" Binding="{Binding FirstChangeText}" Width="0.9*" MinWidth="100" />
            <DataGridTextColumn Header="Last change" Binding="{Binding LastChangeText}" Width="1*" MinWidth="100" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding Matrix.EmptyMatrixText}" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="550"
                   AutomationProperties.AutomationId="matrix.empty"
                   Visibility="{Binding Matrix.Rows.Count, Converter={StaticResource NavVisibility}, ConverterParameter=0}" />

        <DockPanel Grid.Row="3" Margin="0,8,0,4">
          <Button Content="Plot selected signal" Style="{StaticResource AccentButton}"
                  Command="{Binding Matrix.PlotSelectedCommand}" DockPanel.Dock="Left"
                  ToolTip="Plot the selected row's signal over the full trace" />
          <TextBlock Text="Changes of the selected signal — double-click a change to open its frame in the Trace view."
                     Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"
                      ToolTip="Drag to resize the changes panel" />

        <DataGrid Grid.Row="5" ItemsSource="{Binding Matrix.SelectedChanges}" IsReadOnly="True"
                  CanUserSortColumns="True" SelectionMode="Single" FontFamily="Consolas" FontSize="12"
                  MouseDoubleClick="OnChangeRowDoubleClick" x:Name="ChangesGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="120" MinWidth="120" />
            <DataGridTextColumn Header="From" Binding="{Binding FromText}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="To" Binding="{Binding ToText}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="Δ" Binding="{Binding DeltaText}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="Frame #" Binding="{Binding FrameIndex}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- ============ BYTE MATRIX (temporal) ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=5}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="ByteMatrixOverviewRow" Height="140" MinHeight="70" MaxHeight="420" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition x:Name="ByteMatrixSplitterRow" Height="{Binding ByteMatrix.SelectedRow, Converter={StaticResource CollapsibleRowHeight}, ConverterParameter=6}" />
          <RowDefinition x:Name="ByteMatrixDecodedRow" Height="{Binding ByteMatrix.SelectedRow, Converter={StaticResource ByteMatrixDecodedHeight}, ConverterParameter=220}" MinHeight="0" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ByteMatrix.SummaryText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <TextBox x:Name="ByteMatrixFilterBox" AutomationProperties.AutomationId="byteMatrix.search" Width="320" Text="{Binding ByteMatrix.FilterText, UpdateSourceTrigger=PropertyChanged}"
                   common:PlaceholderService.Text="🔍 Filter by ID, message or channel…"
                   ToolTip="Filter by ID, message name or channel"
                   AutomationProperties.Name="Filter by ID, message or channel" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
          <Border DockPanel.Dock="Left" Style="{StaticResource ToolGroup}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ToolButton}" Content="⏮" Command="{Binding ByteMatrix.HeadCommand}" ToolTip="Trace start" Margin="0,0,2,0" AutomationProperties.Name="Trace start" />
              <Button Style="{StaticResource ToolButton}" Command="{Binding ByteMatrix.TogglePlaybackCommand}" MinWidth="52" Margin="0,0,2,0">
                <Button.Content>
                  <Binding Path="ByteMatrix.PlaybackButtonText" />
                </Button.Content>
              </Button>
              <Button Style="{StaticResource ToolButton}" Content="⏭" Command="{Binding ByteMatrix.TailCommand}" ToolTip="Trace end" AutomationProperties.Name="Trace end" />
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Left" Text="Speed" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox DockPanel.Dock="Left" Width="76" ItemsSource="{Binding ByteMatrix.PlaybackSpeedChoices}"
                    SelectedItem="{Binding ByteMatrix.PlaybackSpeed}" ToolTip="Byte matrix replay speed multiplier" Margin="0,0,10,0"
                    AutomationProperties.Name="Byte matrix playback speed" />
          <Slider Minimum="0" Maximum="100" VerticalAlignment="Center"
                  Value="{Binding ByteMatrix.TimelinePercent, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="Timeline: the matrix shows the payload state at this point in the trace"
                  AutomationProperties.Name="Byte matrix timeline position" />
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,8">
          <controls:TraceOverviewControl x:Name="ByteMatrixOverview"
                                         Frames="{Binding Frames}"
                                         CurrentPercent="{Binding ByteMatrix.TimelinePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>

        <GridSplitter x:Name="ByteMatrixOverviewSplitter" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnByteMatrixOverviewResized"
                      ToolTip="Drag to resize the byte matrix density overview" />

        <DataGrid Grid.Row="4" x:Name="ByteMatrixGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="byteMatrix.grid" ItemsSource="{Binding ByteMatrix.Rows}"
                  SelectedItem="{Binding ByteMatrix.SelectedRow}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  PreviewMouseLeftButtonDown="OnByteMatrixGridPreviewMouseLeftButtonDown"
                  FontFamily="Consolas"
                  FontSize="12.5">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Filter trace by this ID" Command="{Binding FilterTraceByIdentifierCommand}"
                        CommandParameter="{Binding ByteMatrix.SelectedRow.Identifier}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Resources>
            <DataTemplate x:Key="ByteCellTemplate">
              <Border Padding="8,3" CornerRadius="3" ToolTip="{Binding ChangedBitsText}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ChangedByteMatrixCellBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Expand" Width="62" MinWidth="62" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding IsDetailOpen, Converter={StaticResource ExpandGlyph}}"
                          Click="OnToggleByteMatrixDetailsClick"
                          Style="{StaticResource SubtleButton}" Padding="10,0"
                          HorizontalAlignment="Center" FontSize="12"
                          ToolTip="Open or close the decoded signal details for this ID"
                          AutomationProperties.Name="Toggle decoded signal details" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="48" MinWidth="48" />
            <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="95" MinWidth="95" />
            <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu}" Width="105" MinWidth="105" />
            <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="1*" MinWidth="160" />
            <DataGridTemplateColumn Header="B0" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[0]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B1" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[1]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B2" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[2]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B3" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[3]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B4" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[4]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B5" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[5]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B6" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[6]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="B7" Width="54" MinWidth="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentPresenter Content="{Binding Bytes[7]}" ContentTemplate="{StaticResource ByteCellTemplate}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="+FD" Binding="{Binding ExtraBytesText}" Width="55" MinWidth="55" />
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="90" MinWidth="90" />
            <DataGridTextColumn Header="Last [s]" Binding="{Binding LastTimeText}" Width="*" />
            <DataGridTemplateColumn Header="Plot" Width="48" MinWidth="48">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="∿" Padding="6,1" ToolTip="Plot every decoded signal of this ID — no need to open the decoded signal panel first"
                          AutomationProperties.Name="Plot every decoded signal of this ID"
                          Click="OnPlotByteMatrixRowClick" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"
                      Visibility="{Binding ByteMatrix.SelectedRow, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                      DragCompleted="OnByteMatrixDecodedPanelResized"
                      ToolTip="Drag to resize the decoded signal panel — the size you choose is kept for the rest of the session" />

        <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,2,0,0" Padding="12"
                Visibility="{Binding ByteMatrix.SelectedRow, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
              <TextBlock Text="{Binding ByteMatrix.SelectedRow.Identifier, StringFormat='Decoded signals for ID {0}'}"
                         FontWeight="SemiBold" VerticalAlignment="Center"
                         ToolTip="Live-updates while playing — click this ID's row again in the table above to close this panel" />
              <TextBlock Text="{Binding ByteMatrix.SelectedRow.LastTimeText, StringFormat='state at {0}s'}"
                         DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
            <controls:DecodedSignalGrid Grid.Row="1"
                      SignalRows="{Binding ByteMatrix.SelectedRowSignals}"
                      OpenSignalDetailRequested="OnSignalDetailRequested" />
          </Grid>
        </Border>
      </Grid>

      <!-- ============ STATISTICS ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=6}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="96" />
          <RowDefinition Height="6" />
          <RowDefinition Height="2*" MinHeight="300" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolGroup}" Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding BusLoadRows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                  <TextBlock Text="{Binding ChannelText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="bus load @" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBox Width="56" Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                           ToolTip="Assumed bitrate for this channel — never auto-detected from the file, always an explicit input"
                           AutomationProperties.Name="{Binding ChannelText, StringFormat='Assumed bitrate for {0}'}" />
                  <TextBlock Text="kbit/s =" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,4,0" />
                  <TextBlock Text="{Binding LoadPercentText}" FontWeight="SemiBold" VerticalAlignment="Center"
                             ToolTip="Estimated from nominal (unstuffed) frame bit counts — an approximation, not a cycle-accurate measurement" />
                  <TextBlock Text="(estimated, whole-trace average)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                  <TextBlock Text="{Binding LoggedLoadText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0"
                             ToolTip="Bus load measured and written by the logger itself (ASC Statistic: lines); not derived from the frames" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
          <Button DockPanel.Dock="Left" Content="Open first frame" Command="{Binding OpenStatisticsRowCommand}" CommandParameter="first" Margin="0,0,8,0"
                  ToolTip="Jump to the first trace frame for the selected ID" />
          <Button DockPanel.Dock="Left" Content="Open last frame" Command="{Binding OpenStatisticsRowCommand}" CommandParameter="last" Margin="0,0,12,0"
                  ToolTip="Jump to the last trace frame for the selected ID" />
          <Button DockPanel.Dock="Left" Content="Compare trace…" Command="{Binding CompareTraceCommand}" Margin="0,0,8,0"
                  ToolTip="Load a second trace file and compare rates/frames/decoded signals against it" />
          <Button DockPanel.Dock="Left" x:Name="CompareWithReferenceButton" Content="Compare with reference" Command="{Binding CompareWithReferenceCommand}" Margin="0,0,12,0"
                  ToolTip="Compare the loaded trace with the reference trace you compared last, without choosing a file again"
                  AutomationProperties.Name="Compare with reference trace" />
          <Button DockPanel.Dock="Left" Content="Overlay signal…" Click="OnSignalOverlayClick" Margin="0,0,12,0"
                  IsEnabled="{Binding HasSignalOverlay}"
                  ToolTip="Overlay one decoded signal of the loaded trace on the reference trace you compared with (after Compare trace…)"
                  AutomationProperties.Name="Overlay a signal of the loaded trace on the reference trace" AutomationProperties.AutomationId="statistics.overlay" />
          <Button x:Name="StatisticsPopOutButton" Content="Reports in a window ↗" Margin="0,0,12,0"
                  Click="OnPopOutStatisticsClick" AutomationProperties.AutomationId="statistics.popOut"
                  ToolTip="Open the nominal-cycle, transition, network-matrix, trigger, sequence and compare reports in a large separate window" />
          <TextBox x:Name="StatisticsSearchBox" AutomationProperties.AutomationId="statistics.search" Width="240" Text="{Binding StatisticsSearchText, UpdateSourceTrigger=PropertyChanged}"
                   common:PlaceholderService.Text="🔍 Filter by ECU, ID, message or channel…"
                   ToolTip="Filter by ECU, ID, message name or channel"
                   AutomationProperties.Name="Filter by ECU, ID, message or channel" />
                  <TextBlock Margin="12,0,0,0" Text="{Binding StatisticsSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </WrapPanel>
        <DataGrid Grid.Row="2" x:Name="StatisticsGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="statistics.grid" ItemsSource="{Binding StatisticsRows}" SelectedItem="{Binding SelectedStatisticsRow}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserSortColumns="True"
                  FontFamily="Consolas" FontSize="12.5">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open first frame" Command="{Binding OpenStatisticsRowCommand}" CommandParameter="first" />
              <MenuItem Header="Open last frame" Command="{Binding OpenStatisticsRowCommand}" CommandParameter="last" />
              <Separator />
              <MenuItem Header="Compare trace…" Command="{Binding CompareTraceCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="45" MinWidth="45" />
            <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="95" MinWidth="95" />
            <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu}" Width="105" MinWidth="105" />
            <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="1.2*" MinWidth="160" />
            <DataGridTextColumn Header="Frames" Binding="{Binding FrameCount, StringFormat=N0}" Width="90" MinWidth="90" />
            <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" Width="85" MinWidth="85" />
            <DataGridTextColumn Header="Avg period [ms]" Binding="{Binding AveragePeriodText}" SortMemberPath="AveragePeriodMs" Width="115" MinWidth="115" />
            <DataGridTextColumn Header="Min [ms]" Binding="{Binding MinPeriodMs, StringFormat=F1}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="Max [ms]" Binding="{Binding MaxPeriodMs, StringFormat=F1}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="Jitter" Binding="{Binding JitterText}" Width="85" MinWidth="85" />
            <DataGridTextColumn Header="Std dev" Binding="{Binding StdDevText}" Width="80" MinWidth="80">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Population standard deviation of this identifier's period across the whole trace" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Bursts" Binding="{Binding BurstCountText}" Width="65" MinWidth="65">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Gaps at least 60% shorter than this identifier's average period" />
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BurstCount}" Value="0">
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="DLC" Binding="{Binding LengthText}" Width="60" MinWidth="60" />
            <DataGridTextColumn Header="First [s]" Binding="{Binding FirstTimeText}" Width="0.8*" MinWidth="95" />
            <DataGridTextColumn Header="Last [s]" Binding="{Binding LastTimeText}" Width="0.8*" MinWidth="95" />
          </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ToolTip="Drag to resize the statistics and DBC nominal timing panels" />
        <DockPanel x:Name="StatisticsReportsPanel" Grid.Row="4" Margin="0,2,0,0">
          <TabControl>
            <TabItem Header="DBC nominal cycle">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="1*" MinHeight="80"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="1*" MinHeight="80"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding CycleTiming.Summary}"
                           FontWeight="SemiBold" Margin="8,6,8,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding CycleTiming.Interpretation}"
                           Style="{StaticResource MutedText}" FontSize="10.5"
                           Margin="8,0,8,6" TextWrapping="Wrap"/>
                <DataGrid Grid.Row="2" x:Name="DbcCycleTimingGrid"
                          ItemsSource="{Binding CycleTiming.Rows}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserSortColumns="True"
                          EnableRowVirtualization="True" FontSize="11.5"
                          AutomationProperties.Name="DBC declared versus observed cycle timing">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="DBC" Binding="{Binding Database}" Width="110"/>
                    <DataGridTextColumn Header="CAN" Binding="{Binding Channel}" Width="48"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="100" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="160" MinWidth="120"/>
                    <DataGridTextColumn Header="Nominal [ms]" Binding="{Binding NominalMs}" Width="92"/>
                    <DataGridTextColumn Header="Actual mean [ms]" Binding="{Binding MeanMs}" Width="120"/>
                    <DataGridTextColumn Header="Δ mean" Binding="{Binding DeviationText}" Width="80"/>
                    <DataGridTextColumn Header="Min – Max [ms]" Binding="{Binding MinMaxMs}" Width="135"/>
                    <DataGridTextColumn Header="Std dev [ms]" Binding="{Binding StdDevMs}" Width="95"/>
                    <DataGridTextColumn Header="Late" Binding="{Binding LateGaps}" Width="55"/>
                    <DataGridTextColumn Header="Early" Binding="{Binding EarlyGaps}" Width="55"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="ToolTip" Value="{Binding Detail}"/>
                          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ToolTip="Resize nominal cycle summary and source-backed gap evidence"/>
                <DockPanel Grid.Row="4">
                  <DockPanel DockPanel.Dock="Top" Margin="4,4,4,4">
                    <Button DockPanel.Dock="Right" Content="Open gap in Trace"
                            Command="{Binding CycleTiming.OpenIncidentCommand}"
                            ToolTip="Navigate to the exact captured frame ending the selected long cycle gap"
                            AutomationProperties.Name="Open selected DBC cycle incident in Trace"/>
                    <TextBlock Text="SOURCE-BACKED LATE INTERVALS"
                               Style="{StaticResource MutedText}" FontWeight="SemiBold"
                               FontSize="10.5" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DataGrid x:Name="DbcCycleIncidentsGrid"
                            ItemsSource="{Binding CycleTiming.Incidents}"
                            SelectedItem="{Binding CycleTiming.SelectedIncident}"
                            IsReadOnly="True" AutoGenerateColumns="False"
                            EnableRowVirtualization="True" CanUserSortColumns="True"
                            MouseDoubleClick="OnDbcCycleIncidentDoubleClick"
                            FontSize="11" AutomationProperties.Name="DBC nominal cycle late-gap incidents">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Time [s]" Binding="{Binding TimestampSeconds, StringFormat=F6}" Width="100"/>
                      <DataGridTextColumn Header="CAN" Binding="{Binding Channel}" Width="45"/>
                      <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="100"/>
                      <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="135"/>
                      <DataGridTextColumn Header="Gap [ms]" Binding="{Binding GapMs, StringFormat=F3}" Width="95"/>
                      <DataGridTextColumn Header="Nominal [ms]" Binding="{Binding NominalMs}" Width="90"/>
                      <DataGridTextColumn Header="Factor" Binding="{Binding Ratio}" Width="65"/>
                      <DataGridTextColumn Header="Frame #" Binding="{Binding FrameNumber}" Width="75"/>
                      <DataGridTextColumn Header="Evidence / uncertainty" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Named state transitions"
                     AutomationProperties.AutomationId="statistics.stateTransitionsTab">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                  <TextBlock Text="{Binding StateTransitions.Summary}" FontWeight="SemiBold" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="statistics.stateTransitionsSummary"/>
                  <TextBlock Text="{Binding StateTransitions.Interpretation}" Style="{StaticResource MutedText}"
                             TextWrapping="Wrap" FontSize="10.5" Margin="0,3,0,7"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open after frame"
                            Command="{Binding StateTransitions.OpenAfterFrameCommand}"
                            AutomationProperties.AutomationId="statistics.stateTransitionsOpenAfter"
                            ToolTip="First recorded frame showing the new state"/>
                    <Button DockPanel.Dock="Right" Content="Open before frame" Margin="0,0,7,0"
                            Command="{Binding StateTransitions.OpenBeforeFrameCommand}"
                            AutomationProperties.AutomationId="statistics.stateTransitionsOpenBefore"
                            ToolTip="Last recorded frame showing the previous state"/>
                    <TextBox Width="240" HorizontalAlignment="Left"
                             Text="{Binding StateTransitions.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             common:PlaceholderService.Text="Filter message, signal or state…"
                             AutomationProperties.Name="Filter recorded named-state transitions"
                             AutomationProperties.AutomationId="statistics.stateTransitionsSearch"/>
                  </DockPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding StateTransitions.Rows}" SelectedItem="{Binding StateTransitions.SelectedRow}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                          EnableRowVirtualization="True" FontSize="11.5"
                          AutomationProperties.Name="Recorded DBC named-state changes"
                          AutomationProperties.AutomationId="statistics.stateTransitionsGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeSeconds}" Width="95"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="140"/>
                    <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="135"/>
                    <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="115"/>
                    <DataGridTextColumn Header="After" Binding="{Binding After}" Width="115"/>
                    <DataGridTextColumn Header="Prior observed [ms]" Binding="{Binding ObservedMilliseconds}" Width="135"/>
                    <DataGridTextColumn Header="Uncertainty [ms]" Binding="{Binding GapMilliseconds}" Width="130"/>
                    <DataGridTextColumn Header="Frame before" Binding="{Binding BeforeFrame}" Width="100"/>
                    <DataGridTextColumn Header="Frame after" Binding="{Binding AfterFrame}" Width="100"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Network matrix" AutomationProperties.AutomationId="statistics.networkMatrixTab">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                  <TextBlock Text="{Binding NetworkMatrix.Summary}" FontWeight="SemiBold" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="statistics.networkMatrixSummary"/>
                  <TextBlock Text="{Binding NetworkMatrix.Interpretation}"
                             Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             FontSize="10.5" Margin="0,3,0,7"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Inspect in DBC Manager"
                            Command="{Binding NetworkMatrix.InspectInDbcCommand}"
                            ToolTip="Open this exact loaded source message; observed ECU identity remains unverified"
                            AutomationProperties.AutomationId="statistics.networkMatrixInspect"/>
                    <TextBox HorizontalAlignment="Left" Width="260"
                             Text="{Binding NetworkMatrix.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             common:PlaceholderService.Text="Filter DBC, ECU, message, ID…"
                             AutomationProperties.Name="Filter DBC network matrix"
                             AutomationProperties.AutomationId="statistics.networkMatrixSearch"/>
                  </DockPanel>
                </StackPanel>
                <TabControl>
                  <TabItem Header="Declared and observed">
                    <DataGrid ItemsSource="{Binding NetworkMatrix.Rows}" SelectedItem="{Binding NetworkMatrix.SelectedRow}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                              EnableRowVirtualization="True" FontSize="11.5"
                              AutomationProperties.AutomationId="statistics.networkMatrixGrid"
                              AutomationProperties.Name="DBC declared network roles and observed CAN channels">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="DBC" Binding="{Binding Database}" Width="125"/>
                        <DataGridTextColumn Header="Channel" Binding="{Binding ChannelText}" Width="100"/>
                        <DataGridTextColumn Header="ID / format" Binding="{Binding IdentifierText}" Width="135"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="145"/>
                        <DataGridTextColumn Header="TX declared" Binding="{Binding DeclaredTransmitter}" Width="110"/>
                        <DataGridTextColumn Header="RX declared" Binding="{Binding DeclaredReceivers}" Width="150"/>
                        <DataGridTextColumn Header="DLC" Binding="{Binding DeclaredDlc}" Width="55"/>
                        <DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" Width="65"/>
                        <DataGridTextColumn Header="Frames" Binding="{Binding ObservedFrames}" Width="75"/>
                        <DataGridTextColumn Header="Avg period [ms]" Binding="{Binding PeriodText}" Width="115"/>
                        <DataGridTextColumn Header="PGN (possible)" Binding="{Binding PgnText}" Width="160"/>
                        <DataGridTextColumn Header="Interpretation" Binding="{Binding Evidence}" Width="*"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Ambiguous / unmatched" AutomationProperties.AutomationId="statistics.networkMatrixIssuesTab">
                    <DataGrid ItemsSource="{Binding NetworkMatrix.Issues}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                              EnableRowVirtualization="True" FontSize="11.5"
                              AutomationProperties.AutomationId="statistics.networkMatrixIssuesGrid">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Channel" Binding="{Binding ChannelText}" SortMemberPath="Channel" Width="80"/>
                        <DataGridTextColumn Header="ID / format" Binding="{Binding IdentifierText}" Width="145"/>
                        <DataGridTextColumn Header="Frames" Binding="{Binding RecordedFrames}" Width="85"/>
                        <DataGridTextColumn Header="Problem" Binding="{Binding CodeText}" SortMemberPath="Code" Width="190"/>
                        <DataGridTextColumn Header="Reason / limitation" Binding="{Binding Explanation}" Width="*"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                </TabControl>
              </DockPanel>
            </TabItem>
            <TabItem Header="Signal triggers" AutomationProperties.AutomationId="statistics.triggerTab">
              <DockPanel>
                <!-- The rule editor opens in its own window; the result grid keeps the height. -->
                <Button DockPanel.Dock="Top" Content="Configure trigger rules in a separate window…"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        Margin="8,5,8,8" Click="OnPopOutTriggerEditorClick"
                        AutomationProperties.AutomationId="statistics.openTriggerEditor"
                        ToolTip="Edit source-scoped trigger rules in a resizable window" />
                <DockPanel x:Name="StatisticsTriggerEditorPanel" Visibility="Collapsed">
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="360"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="8,4,8,8">
                  <TextBlock Text="{Binding Triggers.Interpretation}"
                             Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             FontSize="10.5" Margin="0,2,0,5"/>
                  <TextBox Width="360" HorizontalAlignment="Left"
                           Text="{Binding Triggers.SignalSearchText, UpdateSourceTrigger=PropertyChanged}"
                           common:PlaceholderService.Text="Search exact CAN channel / signal / database…"
                           AutomationProperties.Name="Search trigger signal"
                           AutomationProperties.AutomationId="statistics.triggerSignalSearch"/>
                  <ComboBox ItemsSource="{Binding Triggers.SignalChoices}" SelectedItem="{Binding Triggers.SelectedSignal}"
                            DisplayMemberPath="Label" HorizontalAlignment="Left" Width="540" Margin="0,5,0,2"
                            AutomationProperties.Name="Choose source-scoped decoded signal"
                            AutomationProperties.AutomationId="statistics.triggerSignal"/>
                  <TextBlock Text="{Binding Triggers.SignalSelectionSummary}"
                             Style="{StaticResource MutedText}" FontSize="10.5"
                             TextWrapping="Wrap" Margin="0,2,0,5"/>
                  <WrapPanel Margin="0,0,0,7">
                    <TextBlock Text="Saved local rules" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Triggers.Presets}"
                              SelectedItem="{Binding Triggers.SelectedPreset}"
                              DisplayMemberPath="Name" Width="205" Margin="0,0,7,0"
                              ToolTip="Rules are stored locally and require the exact DBC, signal and physical channel to reload"
                              AutomationProperties.AutomationId="statistics.triggerPreset"/>
                    <TextBox Width="170" Margin="0,0,7,0" VerticalAlignment="Center"
                             Text="{Binding Triggers.PresetNameText, UpdateSourceTrigger=PropertyChanged}"
                             common:PlaceholderService.Text="Rule name…"
                             AutomationProperties.AutomationId="statistics.triggerPresetName"/>
                    <Button Content="Save rule" Margin="0,0,7,0"
                            Command="{Binding Triggers.SavePresetCommand}"
                            ToolTip="Store current rule settings locally, replacing the same-named rule if present"
                            AutomationProperties.AutomationId="statistics.triggerSaveRule"/>
                    <Button Content="Load rule" Margin="0,0,7,0"
                            Command="{Binding Triggers.LoadPresetCommand}"
                            ToolTip="Load only when the exact source-scoped signal identity is available"
                            AutomationProperties.AutomationId="statistics.triggerLoadRule"/>
                    <Button Content="Delete rule"
                            Command="{Binding Triggers.DeletePresetCommand}"
                            ToolTip="Delete the selected local rule with confirmation; never changes source files"
                            AutomationProperties.AutomationId="statistics.triggerDeleteRule"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,0,0,6">
                    <StackPanel Margin="0,0,10,4">
                      <TextBlock Text="Predicate" Style="{StaticResource MutedText}"/>
                      <ComboBox ItemsSource="{Binding Triggers.ModeChoices}" SelectedIndex="{Binding Triggers.ModeIndex}"
                                Width="190" AutomationProperties.AutomationId="statistics.triggerMode"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,4">
                      <TextBlock Text="Threshold (physical)" Style="{StaticResource MutedText}"/>
                      <TextBox Width="110" Text="{Binding Triggers.ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.AutomationId="statistics.triggerThreshold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,4">
                      <TextBlock Text="Change tolerance" Style="{StaticResource MutedText}"/>
                      <TextBox Width="105" Text="{Binding Triggers.ToleranceText, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.AutomationId="statistics.triggerTolerance"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,4">
                      <TextBlock Text="Named DBC state" Style="{StaticResource MutedText}"/>
                      <TextBox Width="150" Text="{Binding Triggers.NamedStateText, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.AutomationId="statistics.triggerNamedState"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,4">
                      <TextBlock Text="Min separation [ms]" Style="{StaticResource MutedText}"/>
                      <TextBox Width="125" Text="{Binding Triggers.SeparationMsText, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.AutomationId="statistics.triggerSeparation"/>
                    </StackPanel>
                  </WrapPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open matching frame"
                            Command="{Binding Triggers.OpenAfterFrameCommand}" Margin="7,0,0,0"
                            AutomationProperties.AutomationId="statistics.triggerOpenAfter"/>
                    <Button DockPanel.Dock="Right" Content="Open previous frame"
                            Command="{Binding Triggers.OpenBeforeFrameCommand}" Margin="7,0,0,0"
                            AutomationProperties.AutomationId="statistics.triggerOpenBefore"/>
                    <Button DockPanel.Dock="Left" Content="Evaluate offline"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding Triggers.EvaluateCommand}" Margin="0,0,12,0"
                            AutomationProperties.AutomationId="statistics.triggerEvaluate"/>
                    <TextBlock Text="{Binding Triggers.StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="statistics.triggerStatus"/>
                  </DockPanel>
                  </StackPanel>
                </ScrollViewer>
                <DataGrid ItemsSource="{Binding Triggers.Events}" SelectedItem="{Binding Triggers.SelectedEvent}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                          EnableRowVirtualization="True" FontSize="11.5"
                          AutomationProperties.AutomationId="statistics.triggerGrid"
                          AutomationProperties.Name="Offline trigger results with original source frames">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeSeconds}" Width="100"/>
                    <DataGridTextColumn Header="Before" Binding="{Binding BeforeValue}" Width="95"/>
                    <DataGridTextColumn Header="After" Binding="{Binding AfterValue}" Width="95"/>
                    <DataGridTextColumn Header="Before state" Binding="{Binding BeforeState}" Width="130"/>
                    <DataGridTextColumn Header="After state" Binding="{Binding AfterState}" Width="130"/>
                    <DataGridTextColumn Header="Uncertainty [ms]" Binding="{Binding ObservationGapMs}" Width="135"/>
                    <DataGridTextColumn Header="Prior frame #" Binding="{Binding BeforeFrame}" Width="95"/>
                    <DataGridTextColumn Header="Match frame #" Binding="{Binding AfterFrame}" Width="95"/>
                  </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
              </DockPanel>
            </TabItem>
            <TabItem Header="Event sequences" AutomationProperties.AutomationId="statistics.sequenceTab">
              <DockPanel>
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="355"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="8,4,8,8">
                    <TextBlock Text="Compare two recorded signal events. A→B requires strictly increasing timestamps; A &amp; B means nearby observations, not simultaneous ECU state. No live CAN transmission."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Event A · source-scoped signal" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Sequences.FirstSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderService.Text="Search A database / CAN channel / signal"
                                 AutomationProperties.AutomationId="statistics.sequenceSearchA" Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding Sequences.FirstChoices}"
                                  SelectedItem="{Binding Sequences.FirstSignal}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="statistics.sequenceSignalA"/>
                        <ComboBox ItemsSource="{Binding Sequences.TriggerModes}"
                                  SelectedIndex="{Binding Sequences.FirstModeIndex}"
                                  AutomationProperties.AutomationId="statistics.sequenceModeA" Margin="0,5,0,4"/>
                        <WrapPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Threshold" Style="{StaticResource MutedText}"/>
                            <TextBox Width="92" Text="{Binding Sequences.FirstThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceThresholdA"/>
                          </StackPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Change tolerance" Style="{StaticResource MutedText}"/>
                            <TextBox Width="104" Text="{Binding Sequences.FirstToleranceText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceToleranceA"/>
                          </StackPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Named state" Style="{StaticResource MutedText}"/>
                            <TextBox Width="130" Text="{Binding Sequences.FirstStateText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceStateA"/>
                          </StackPanel>
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Event B · source-scoped signal" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Sequences.SecondSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderService.Text="Search B database / CAN channel / signal"
                                 AutomationProperties.AutomationId="statistics.sequenceSearchB" Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding Sequences.SecondChoices}"
                                  SelectedItem="{Binding Sequences.SecondSignal}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="statistics.sequenceSignalB"/>
                        <ComboBox ItemsSource="{Binding Sequences.TriggerModes}"
                                  SelectedIndex="{Binding Sequences.SecondModeIndex}"
                                  AutomationProperties.AutomationId="statistics.sequenceModeB" Margin="0,5,0,4"/>
                        <WrapPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Threshold" Style="{StaticResource MutedText}"/>
                            <TextBox Width="92" Text="{Binding Sequences.SecondThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceThresholdB"/>
                          </StackPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Change tolerance" Style="{StaticResource MutedText}"/>
                            <TextBox Width="104" Text="{Binding Sequences.SecondToleranceText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceToleranceB"/>
                          </StackPanel>
                          <StackPanel Margin="0,0,9,3">
                            <TextBlock Text="Named state" Style="{StaticResource MutedText}"/>
                            <TextBox Width="130" Text="{Binding Sequences.SecondStateText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="statistics.sequenceStateB"/>
                          </StackPanel>
                        </WrapPanel>
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,6,0,8">
                      <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Temporal predicate" Style="{StaticResource MutedText}"/>
                        <ComboBox ItemsSource="{Binding Sequences.SequenceModes}"
                                  SelectedIndex="{Binding Sequences.SequenceModeIndex}"
                                  Width="235" AutomationProperties.AutomationId="statistics.sequenceRelation"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Min delay [ms]" Style="{StaticResource MutedText}"/>
                        <TextBox Width="100" Text="{Binding Sequences.MinDelayMsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="statistics.sequenceMinMs"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Max delay [ms]" Style="{StaticResource MutedText}"/>
                        <TextBox Width="100" Text="{Binding Sequences.MaxDelayMsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="statistics.sequenceMaxMs"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Pre-context [ms]" Style="{StaticResource MutedText}"/>
                        <TextBox Width="105" Text="{Binding Sequences.PreContextMsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="statistics.sequencePreMs"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Post-context [ms]" Style="{StaticResource MutedText}"/>
                        <TextBox Width="105" Text="{Binding Sequences.PostContextMsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="statistics.sequencePostMs"/>
                      </StackPanel>
                    </WrapPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Open event B frame"
                              Command="{Binding Sequences.OpenBFrameCommand}" Margin="7,0,0,0"
                              AutomationProperties.AutomationId="statistics.sequenceOpenB"/>
                      <Button DockPanel.Dock="Right" Content="Open event A frame"
                              Command="{Binding Sequences.OpenAFrameCommand}" Margin="7,0,0,0"
                              AutomationProperties.AutomationId="statistics.sequenceOpenA"/>
                      <Button DockPanel.Dock="Left" Content="Evaluate A/B offline"
                              Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                              Command="{Binding Sequences.EvaluateCommand}"
                              AutomationProperties.AutomationId="statistics.sequenceEvaluate"/>
                      <TextBlock Text="{Binding Sequences.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="statistics.sequenceStatus"/>
                    </DockPanel>
                  </StackPanel>
                </ScrollViewer>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*" MinHeight="100"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                  </Grid.RowDefinitions>
                  <DataGrid Grid.Row="0" ItemsSource="{Binding Sequences.Results}"
                            SelectedItem="{Binding Sequences.SelectedEvent}" IsReadOnly="True"
                            AutoGenerateColumns="False" CanUserSortColumns="True"
                            EnableRowVirtualization="True" FontSize="11.5"
                            AutomationProperties.AutomationId="statistics.sequenceGrid"
                            AutomationProperties.Name="Observed A/B event pairs">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="A [s]" Binding="{Binding ATimeSeconds}" Width="95"/>
                      <DataGridTextColumn Header="B [s]" Binding="{Binding BTimeSeconds}" Width="95"/>
                      <DataGridTextColumn Header="Delay [ms]" Binding="{Binding ObservedDelayMs}" Width="95"/>
                      <DataGridTextColumn Header="A frame" Binding="{Binding AFrame}" Width="90"/>
                      <DataGridTextColumn Header="B frame" Binding="{Binding BFrame}" Width="90"/>
                      <DataGridTextColumn Header="Context starts [s]" Binding="{Binding ContextStartSeconds}" Width="140"/>
                      <DataGridTextColumn Header="Context ends [s]" Binding="{Binding ContextEndSeconds}" Width="140"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch"/>
                  <DockPanel Grid.Row="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                      <Button DockPanel.Dock="Right" Content="Open context frame"
                              Command="{Binding Sequences.OpenContextFrameCommand}"
                              AutomationProperties.AutomationId="statistics.sequenceOpenContext"/>
                      <TextBlock Text="{Binding Sequences.ContextStatus}" TextWrapping="Wrap"
                                 Style="{StaticResource MutedText}"
                                 AutomationProperties.AutomationId="statistics.sequenceContextStatus"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Sequences.ContextFrames}"
                              SelectedItem="{Binding Sequences.SelectedContext}"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" FontSize="11.5"
                              AutomationProperties.AutomationId="statistics.sequenceContextGrid"
                              AutomationProperties.Name="Bounded real trace frames before and after selected event pair">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Original #" Binding="{Binding OriginalFrameNumber}" Width="95"/>
                        <DataGridTextColumn Header="Time [s]" Binding="{Binding TimestampSeconds}" Width="110"/>
                        <DataGridTextColumn Header="Physical bus" Binding="{Binding Channel}" Width="90"/>
                        <DataGridTextColumn Header="CAN ID" Binding="{Binding Identifier}" Width="150"/>
                        <DataGridTextColumn Header="Recorded payload" Binding="{Binding Data}" Width="*"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Grid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Regression" x:Name="RegressionTab">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding RegressionSummary}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="4,5,4,5"/>
                <DataGrid x:Name="RegressionGrid" ItemsSource="{Binding RegressionRows}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserSortColumns="True" FontSize="12"
                          AutomationProperties.Name="Differences against the compared trace">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" MinWidth="90" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" MinWidth="110" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="250" MinWidth="170" />
                    <DataGridTextColumn Header="Difference" Binding="{Binding Summary}" Width="*" MinWidth="220" />
                    <DataGridTextColumn Header="Baseline" Binding="{Binding Baseline}" Width="130" MinWidth="110" />
                    <DataGridTextColumn Header="Candidate" Binding="{Binding Candidate}" Width="130" MinWidth="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="ID compare">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CompareSummary}" Style="{StaticResource MutedText}" Margin="4,5,4,5"/>
                <DataGrid ItemsSource="{Binding CompareTraceRows}" IsReadOnly="True"
                        AutoGenerateColumns="False" CanUserSortColumns="True"
                        FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="45" MinWidth="45" />
                  <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="95" MinWidth="95" />
                  <DataGridTextColumn Header="Base frames" Binding="{Binding BaseFrames}" Width="100" MinWidth="100" />
                  <DataGridTextColumn Header="Compare frames" Binding="{Binding CompareFrames}" Width="115" MinWidth="115" />
                  <DataGridTextColumn Header="Delta frames" Binding="{Binding FrameDelta}" Width="95" MinWidth="95" />
                  <DataGridTextColumn Header="Base rate" Binding="{Binding BaseRate}" Width="95" MinWidth="95" />
                  <DataGridTextColumn Header="Compare rate" Binding="{Binding CompareRate}" Width="105" MinWidth="105" />
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Signal compare">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6"
                           Text="Double-click a row (or select it and press Plot difference) to overlay base vs. compare on a chart." />
                <Button DockPanel.Dock="Bottom" Content="Plot difference" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Click="OnPlotCompareSignalClick"
                        ToolTip="Overlay the selected signal's base and compare timelines on a relative-time chart" />
                <DataGrid ItemsSource="{Binding CompareSignalRows}" SelectedItem="{Binding SelectedCompareSignalRow}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserSortColumns="True"
                          FontFamily="Consolas" FontSize="12" MouseDoubleClick="OnCompareSignalRowDoubleClick">
                  <DataGrid.Columns>
                  <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu}" Width="100" MinWidth="100" />
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="170" MinWidth="170" />
                  <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="150" MinWidth="150" />
                  <DataGridTextColumn Header="Base samples" Binding="{Binding BaseSamples}" Width="105" MinWidth="105" />
                  <DataGridTextColumn Header="Compare samples" Binding="{Binding CompareSamples}" Width="125" MinWidth="125" />
                  <DataGridTextColumn Header="Base last" Binding="{Binding BaseLast}" Width="105" MinWidth="105" />
                  <DataGridTextColumn Header="Compare last" Binding="{Binding CompareLast}" Width="115" MinWidth="115" />
                  <DataGridTextColumn Header="Delta last" Binding="{Binding DeltaLast}" Width="105" MinWidth="105" />
                  <DataGridTextColumn Header="Base range" Binding="{Binding BaseRange}" Width="110" MinWidth="110" />
                  <DataGridTextColumn Header="Compare range" Binding="{Binding CompareRange}" Width="120" MinWidth="120" />
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

      <!-- ============ DID ↔ CAN MAPPING ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=7}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <WrapPanel Orientation="Horizontal">
            <Button Content="Load CDD / ODX / DTC…" AutomationProperties.AutomationId="mapping.loadCatalog" Command="{Binding Mapping.LoadCatalogCommand}" Margin="0,0,8,0"
                    ToolTip="Load one or more diagnostic description files (CDD or ODX) listing DIDs" />
            <Button Content="Export ODX…" Click="OnExportOdxClick" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="mapping.exportOdx" AutomationProperties.Name="Export ODX"
                    ToolTip="Write the loaded diagnostic definitions as an ODX 2.2 file (checked for structure, not against the official schema)" />
            <Button Content="Browse definitions" Command="{Binding BrowseDiagnosticCatalogCommand}" Margin="0,0,8,0"
                    ToolTip="Browse ECU, DID, field offsets, bit lengths, value tables, DTCs, routine parameters and transport profiles"/>
            <Button Content="Inspect selected DID" Command="{Binding BrowseSelectedMappingDidCommand}"
                    Margin="0,0,8,0"
                    ToolTip="Open the selected mapping row's exact DID and ECU in Diagnostic Catalog, including Engineering PAR and field details. Ambiguous source variants are refused."
                    AutomationProperties.Name="Inspect source diagnostic definition of selected mapping row"/>
            <Button Content="Auto-correlate" AutomationProperties.AutomationId="mapping.correlate" Style="{StaticResource AccentButton}" Command="{Binding Mapping.CorrelateCommand}" Margin="0,0,16,0"
                    ToolTip="Score every DID against every loaded DBC signal using name, unit, range, scaling, comments and trace evidence" />
            <Button Content="Save map…" AutomationProperties.AutomationId="mapping.save" Command="{Binding Mapping.SaveMapCommand}" Margin="0,0,8,0"
                    ToolTip="Save the current DID ↔ CAN mapping (candidates, status, notes) to a .rbgmap.json file" />
            <Button Content="Load map…" AutomationProperties.AutomationId="mapping.load" Command="{Binding Mapping.LoadMapCommand}" Margin="0,0,8,0"
                    ToolTip="Re-apply a previously saved .rbgmap.json mapping to the loaded catalogs" />
            <Button Content="Export…" AutomationProperties.AutomationId="mapping.export" Command="{Binding Mapping.ExportCommand}"
                    ToolTip="Export the mapping table as CSV or Excel for sharing/reporting" />
            <Button Content="Plot candidate" Command="{Binding PlotSelectedMappingCommand}" Margin="8,0,0,0"
                    ToolTip="Plot the selected row's mapped CAN signal" />
          </WrapPanel>
          <Grid Margin="16,0,0,0" Width="420">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="MappingSearchBox" AutomationProperties.AutomationId="mapping.search" Text="{Binding Mapping.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     common:PlaceholderService.Text="🔍 Search DID, parameter or mapped signal…"
                     ToolTip="Search DID, parameter name or mapped signal"
                     AutomationProperties.Name="Search DID, parameter or mapped signal" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120" SelectedIndex="{Binding Mapping.StatusFilterIndex}"
                      ToolTip="Filter mapping rows by review status"
                      AutomationProperties.Name="Status filter">
              <ComboBoxItem Content="All statuses" />
              <ComboBoxItem Content="Suggested" />
              <ComboBoxItem Content="Confirmed" />
              <ComboBoxItem Content="To verify" />
              <ComboBoxItem Content="Rejected" />
              <ComboBoxItem Content="Unmatched" />
            </ComboBox>
          </Grid>
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="MappingGrid" PreviewMouseRightButtonDown="OnContextGridPreviewRightMouseDown" AutomationProperties.AutomationId="mapping.grid" ItemsSource="{Binding Mapping.Rows}" SelectedItem="{Binding Mapping.SelectedRow}"
                  IsReadOnly="False" CanUserSortColumns="True" SelectionMode="Single" FontSize="12.5"
                  RowHeight="30">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Confirm" Command="{Binding Mapping.ConfirmCommand}" />
              <MenuItem Header="Reject" Command="{Binding Mapping.RejectCommand}" />
              <Separator />
              <MenuItem Header="Plot candidate" Command="{Binding PlotSelectedMappingCommand}" />
              <Separator />
              <MenuItem Header="Remember this mapping" Command="{Binding Mapping.SaveAliasCommand}"
                        ToolTip="Teach the tool this DID parameter always maps to this CAN signal, so it is suggested first next time — in any catalog or DBC that uses the same names" />
              <MenuItem Header="Forget learned mapping" Command="{Binding Mapping.ForgetAliasCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="DID" Binding="{Binding DidHex}" Width="70" MinWidth="70" IsReadOnly="True" FontFamily="Consolas" />
            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="190" MinWidth="190" IsReadOnly="True" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200" MinWidth="200" IsReadOnly="True" />
            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55" MinWidth="55" IsReadOnly="True" />
            <DataGridTextColumn Header="Range" Binding="{Binding RangeText}" Width="110" MinWidth="110" IsReadOnly="True" />
            <DataGridTextColumn Header="In trace" Binding="{Binding TraceEvidenceText}" Width="150" MinWidth="110" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
                  <Setter Property="ToolTip" Value="{Binding TraceEvidenceToolTip}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="CAN signal (candidates)" Width="240" MinWidth="240">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔖" Margin="0,0,4,0" VerticalAlignment="Center"
                               Visibility="{Binding IsLearnedAlias, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                               ToolTip="Learned alias: you taught this DID → signal mapping" />
                    <ComboBox ItemsSource="{Binding CandidateChoices}" SelectedItem="{Binding SelectedCandidate, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="12" Margin="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Mapped CAN signal candidate">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource CandidateLabel}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="CAN message" Binding="{Binding MessageText}" Width="*" MinWidth="130" IsReadOnly="True" />
            <DataGridTextColumn Header="Match score" Binding="{Binding CandidateScoreText}" Width="Auto" MinWidth="95" IsReadOnly="True" />
            <DataGridTemplateColumn Header="Association" Width="110" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Height="8" Width="60" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4" VerticalAlignment="Center">
                      <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                              Background="{DynamicResource AccentBrush}"
                              Width="{Binding Confidence, Converter={StaticResource ConfidenceWidth}, ConverterParameter=60}" />
                    </Border>
                    <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               ToolTip="Conservative association indicator, capped at 50% until reviewed. Not a probability." />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Status" Width="95" MinWidth="95">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StatusText}" FontSize="11" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Review" Width="120" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="✓" ToolTip="Confirm mapping" AutomationProperties.Name="Confirm mapping" Command="{Binding ConfirmCommand}" Padding="8,2" Margin="0,0,4,0" />
                    <Button Content="✕" ToolTip="Reject mapping" AutomationProperties.Name="Reject mapping" Command="{Binding RejectCommand}" Padding="8,2" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Review warning" Binding="{Binding ReviewWarning}" Width="200" MinWidth="130" IsReadOnly="True" />
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
          <StackPanel>
            <Grid Visibility="{Binding Mapping.IsCorrelating, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                  Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"
                           Value="{Binding Mapping.CorrelationProgressPercent, Mode=OneWay}"
                           ToolTip="Correlating every DID against every DBC signal using name, unit, range, scaling and trace evidence" />
              <TextBlock Grid.Column="1" Text="{Binding Mapping.CorrelationTimeText}" Style="{StaticResource MutedText}"
                         FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Content="Compare saved maps…" Command="{Binding Mapping.CompareMapsCommand}"
                      Margin="0,0,10,0"
                      AutomationProperties.Name="Compare two saved DID CAN mapping versions" AutomationProperties.AutomationId="mapping.compare"
                      ToolTip="Choose baseline and current .rbgmap.json files; preview differences without modifying either. No loaded trace, DBC or diagnostic catalog is required." />
              <Button Content="Export comparison…" Command="{Binding Mapping.ExportComparisonCommand}"
                      IsEnabled="{Binding Mapping.HasComparison}" Margin="0,0,10,0"
                      AutomationProperties.Name="Export saved mapping differences" AutomationProperties.AutomationId="mapping.exportDiff"
                      ToolTip="Write the current read-only comparison as a multi-sheet XLSX workbook or UTF-8 CSV ZIP." />
              <TextBlock Text="{Binding Mapping.ComparisonSummary}"
                         Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Expander x:Name="SavedMappingDiffExpander" AutomationProperties.AutomationId="mapping.diffExpander"
                      Header="Saved mapping comparison preview" IsExpanded="False"
                      Visibility="{Binding Mapping.HasComparison, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                      AutomationProperties.Name="Read-only saved DID CAN mapping differences">
              <DataGrid x:Name="SavedMappingDiffGrid" AutomationProperties.AutomationId="mapping.diffGrid" ItemsSource="{Binding Mapping.ComparisonRows}"
                        Height="175" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserSortColumns="True" EnableRowVirtualization="True"
                        SelectionMode="Single" FontSize="11">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DID" Binding="{Binding DidHex}" Width="85" />
                  <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="100" />
                  <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="110" />
                  <DataGridCheckBoxColumn Header="Review" Binding="{Binding RequiresReview}" Width="65" />
                  <DataGridTextColumn Header="Baseline CAN" Binding="{Binding BaselineSignal}" Width="220" />
                  <DataGridTextColumn Header="Current CAN" Binding="{Binding CurrentSignal}" Width="220" />
                  <DataGridTextColumn Header="DID definition" Binding="{Binding DidDefinition}" Width="105" />
                  <DataGridTextColumn Header="CAN definition" Binding="{Binding CanDefinition}" Width="105" />
                  <DataGridTextColumn Header="Evidence / reason" Binding="{Binding Explanation}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>
            <TextBlock Text="{Binding Mapping.StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="mapping.status" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{Binding Mapping.SelectedRow.ReasonText, StringFormat='Why this candidate: {0}', FallbackValue=''}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ INVESTIGATION (synchronized panes) ============ -->
      <Grid x:Name="InvestigationWorkspace"
            Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=9}"
            Margin="14">
        <Grid.Resources>
          <DataTemplate x:Key="InvestigationTracePane">
            <DataGrid x:Name="InvestigationTraceGrid"
                      ItemsSource="{Binding DataContext.Trace.Rows, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding DataContext.Trace.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="0,0"
                      FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Trace frames pane">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="70" MinWidth="60" />
                <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="100" MinWidth="90" />
                <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="40" MinWidth="36" />
                <DataGridTextColumn Header="ID" Binding="{Binding IdentifierHex, Mode=OneWay}" Width="80" MinWidth="70" />
                <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="140" MinWidth="100" />
                <DataGridTextColumn Header="Data" Binding="{Binding PayloadHex}" Width="*" MinWidth="160" />
              </DataGrid.Columns>
            </DataGrid>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationDecodedPane">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="{Binding DataContext.Trace.SelectedRow.FrameIndex, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Signals decoded from frame #{0}, FallbackValue=Select a frame in the Trace pane to see its decoded signals.}" />
              <controls:DecodedSignalGrid SignalRows="{Binding DataContext.Trace.SelectedRow.DetailedSignals, RelativeSource={RelativeSource AncestorType=Window}}"
                                          MaxRowsHeight="2000"
                                          OpenSignalDetailRequested="OnSignalDetailRequested" />
            </DockPanel>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationObservedSignalsPane">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding DataContext.Signals.LoggerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="SourceIndex"
                          SelectedValue="{Binding DataContext.Signals.SelectedLoggerIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          Visibility="{Binding DataContext.Signals.HasMultipleLoggers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}"
                          AutomationProperties.AutomationId="investigation.loggerScope"
                          AutomationProperties.Name="Original physical logger for related signal analysis"
                          ToolTip="Choose which original CAN recording to inspect. Time axes from other independent loggers are never silently aligned."
                          Margin="0,0,0,5"/>
                <TextBox Text="{Binding DataContext.Signals.SearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                         common:PlaceholderService.Text="Search EngineSpeed, torque, bus, logger…"
                         AutomationProperties.AutomationId="investigation.signalSearch"
                         ToolTip="Find recorded decoded signals, not only DBC declarations" />
                <WrapPanel Margin="0,5,0,0">
                  <CheckBox Content="Changing only" VerticalAlignment="Center" Margin="0,0,10,0"
                            IsChecked="{Binding DataContext.Signals.ChangingOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.AutomationId="investigation.changingOnly" />
                  <Button Content="＋ Plot selected" Padding="6,3" Margin="0,0,8,0"
                          Click="OnPlotSelectedSignalClick"
                          AutomationProperties.AutomationId="investigation.plotSelected"
                          ToolTip="Select any source-backed observed signal row; add the exact recording/DBC/CAN ID to the main plot without removing other curves." />
                  <Button Content="Clear filters" Padding="5,2" Margin="0,0,10,0"
                          Command="{Binding DataContext.Signals.ResetSignalFiltersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          AutomationProperties.AutomationId="investigation.clearSignalFilters" />
                  <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                             Text="{Binding DataContext.Signals.VisibleSeriesSummary, RelativeSource={RelativeSource AncestorType=Window}}" />
                </WrapPanel>
              </StackPanel>
              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding DataContext.Signals.FilteredSeries, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedItem="{Binding DataContext.Signals.SelectedSeries, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                        AutoGenerateColumns="False" SelectionMode="Single" CanUserSortColumns="True"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        AutomationProperties.AutomationId="investigation.signalsGrid"
                        AutomationProperties.Name="Recorded CAN signals; tick Plot to add curves without navigating">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Plot" Binding="{Binding IsPlotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="52"/>
                  <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="*" MinWidth="130" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="125" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Bus" Binding="{Binding ChannelText}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Wire ID" Binding="{Binding IdentifierHex}" Width="82" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationSignalPlotPane">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,7">
                <Button DockPanel.Dock="Right" Content="Nearby changes…" Margin="5,0,0,0"
                        Visibility="{Binding DataContext.Investigation.AdvancedVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}"
                        Click="OnFindNearbySignalChangesClick"
                        AutomationProperties.AutomationId="investigation.findNearbyChanges"
                        ToolTip="Rank changes within ±5s of this cursor in the same physical recording; review actual sample evidence (not a fault diagnosis)" />
                <Button DockPanel.Dock="Right" Content="Find related signals…" Margin="5,0,0,0"
                        Click="OnFindRelatedSignalsClick"
                        AutomationProperties.AutomationId="investigation.findRelations"
                        ToolTip="From the selected recorded signal, find co-varying signals and possible time shifts in the SAME physical recording. Observed association does not prove influence." />
                <Button DockPanel.Dock="Right" Content="▶" Padding="8,3" Margin="5,0,0,0"
                        Command="{Binding DataContext.Signals.NextChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.AutomationId="investigation.nextChange"
                        AutomationProperties.Name="Next actual CAN signal change"
                        ToolTip="Next recorded change of the selected signal · show the exact time, old/new value and original source frame"/>
                <Button DockPanel.Dock="Right" Content="◀" Padding="8,3" Margin="5,0,0,0"
                        Command="{Binding DataContext.Signals.PreviousChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.AutomationId="investigation.previousChange"
                        AutomationProperties.Name="Previous actual CAN signal change"
                        ToolTip="Previous recorded change of the selected signal · view the before/after values, timestamp and source frame"/>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                           Text="{Binding DataContext.Signals.SelectedSignalCursorReadout, RelativeSource={RelativeSource AncestorType=Window}}"
                           AutomationProperties.AutomationId="investigation.cursorReadout"
                           ToolTip="{Binding DataContext.Signals.SelectedSignalCursorReadout, RelativeSource={RelativeSource AncestorType=Window}}"/>
              </DockPanel>
              <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <controls:SignalPlotControl Loaded="OnInvestigationPlotLoaded" Unloaded="OnInvestigationPlotUnloaded"
                  AutomationProperties.AutomationId="investigation.signalChart"
                  AutomationProperties.Name="Source-backed decoded signals over recorded time"
                  AutomationProperties.HelpText="Tick Plot in the signal list. Hover the curve for actual source timestamp, value, before-and-after change and delta. Circles mark observed changed frames (thinned). Click X1; Shift-click X2; Ctrl-click opens the exact original CAN frame."
                  ItemsSource="{Binding DataContext.Signals.ChartSeries, RelativeSource={RelativeSource AncestorType=Window}}"
                  CursorTimestampNanoseconds="{Binding DataContext.PlotCursorNanoseconds, RelativeSource={RelativeSource AncestorType=Window}}"
                  TimeWindowSeconds="{Binding DataContext.Signals.PlotTimeWindowSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                  WindowEndTimestampNanoseconds="{Binding DataContext.Signals.PlotWindowEndNanoseconds, RelativeSource={RelativeSource AncestorType=Window}}"
                  GlobalStartTimestampNanoseconds="{Binding DataContext.Signals.TimelineStartNanoseconds, RelativeSource={RelativeSource AncestorType=Window}}"
                  GlobalEndTimestampNanoseconds="{Binding DataContext.Signals.TimelineEndNanoseconds, RelativeSource={RelativeSource AncestorType=Window}}"
                  YAxisModeIndex="{Binding DataContext.Signals.YAxisModeIndex, RelativeSource={RelativeSource AncestorType=Window}}"
                  LinearInterpolation="{Binding DataContext.Signals.LinearInterpolation, RelativeSource={RelativeSource AncestorType=Window}}"
                  ShowInlineLegend="{Binding DataContext.Signals.ShowInlineLegend, RelativeSource={RelativeSource AncestorType=Window}}"
                  MarkerTimestamps="{Binding DataContext.Trace.MarkedTimestamps, RelativeSource={RelativeSource AncestorType=Window}}" />
              </Border>
            </Grid>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationUdsPane">
            <DataGrid x:Name="InvestigationUdsGrid"
                      ItemsSource="{Binding DataContext.Uds.Rows, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding DataContext.Uds.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                      FontSize="12" AutomationProperties.Name="UDS transactions pane">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="100" MinWidth="90" />
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceText}" Width="200" MinWidth="140" />
                <DataGridTextColumn Header="Object" Binding="{Binding ObjectText}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="170" MinWidth="110" />
              </DataGrid.Columns>
            </DataGrid>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationFindingsPane">
            <DataGrid x:Name="InvestigationFindingsGrid"
                      ItemsSource="{Binding DataContext.Uds.FindingRows, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding DataContext.Uds.SelectedFinding, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                      FontSize="12" AutomationProperties.Name="Offline findings pane">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="100" MinWidth="100" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" MinWidth="90" />
                <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="100" MinWidth="90" />
                <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="*" MinWidth="160" />
              </DataGrid.Columns>
            </DataGrid>
          </DataTemplate>

          <DataTemplate x:Key="InvestigationEmptyPane">
            <TextBlock Text="Choose what this pane shows from the list above." Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DataTemplate>

          <DataTemplate x:Key="InvestigationPane" DataType="{x:Type vm:InvestigationSlotViewModel}">
            <Border Style="{StaticResource Card}" Padding="8">
              <DockPanel>
                <ComboBox DockPanel.Dock="Top" Margin="0,0,0,6"
                          Visibility="{Binding DataContext.Investigation.AdvancedVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}"
                          ItemsSource="{Binding DataContext.Investigation.PaneChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValue="{Binding Kind}" SelectedValuePath="Pane" DisplayMemberPath="Label"
                          AutomationProperties.Name="Pane content" />
                <ContentControl Content="{Binding}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="ContentTemplate" Value="{StaticResource InvestigationEmptyPane}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Trace">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationTracePane}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="DecodedSignals">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationDecodedPane}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="ObservedSignals">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationObservedSignalsPane}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="SignalPlot">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationSignalPlotPane}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="UdsTransactions">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationUdsPane}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Findings">
                          <Setter Property="ContentTemplate" Value="{StaticResource InvestigationFindingsPane}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </DockPanel>
            </Border>
          </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CANalyzer-style home: a recorded signal list and shared trend.
             Do not require the advanced multi-pane layout editor on a small display. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="9" Margin="0,0,0,7">
          <StackPanel>
            <WrapPanel Margin="0,0,0,5">
              <TextBlock Text="CAN signals" FontSize="16" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Button Content="Open trace…" Command="{Binding OpenTraceCommand}"
                      AutomationProperties.AutomationId="investigation.openTrace"
                      Margin="0,0,6,3"
                      ToolTip="Open ASC, BLF, MF4 or other supported original recordings"/>
              <Button Content="Load DBC…" Command="{Binding LoadDbcCommand}"
                      AutomationProperties.AutomationId="investigation.loadDbc"
                      Margin="0,0,6,3"
                      ToolTip="Decode actual CAN frames with the appropriate DBC"/>
              <Button Content="Discover signal groups…" Style="{StaticResource AccentButton}"
                      AutomationProperties.AutomationId="investigation.discoverGroups"
                      Click="OnDiscoverSignalGroupsClick" Margin="0,0,6,3"
                      ToolTip="One-click discovery of observed CAN signal relationship groups. No DTC or preselected signal required." />
              <Button Content="Find related signals…" Style="{StaticResource AccentButton}"
                      AutomationProperties.AutomationId="investigation.findRelationsMain"
                      Click="OnFindRelatedSignalsClick" Margin="0,0,6,3"
                      ToolTip="Select any recorded signal in the list; discover other signals varying with it, possibly before/after, in its original physical logger"/>
              <Button Content="Signals + trend" Click="OnOpenSimpleSignalViewClick"
                      AutomationProperties.AutomationId="investigation.simpleMode"
                      Margin="0,0,6,3"
                      ToolTip="Restore the uncluttered CANalyzer-style signal list and plot"/>
              <TextBlock Text="{Binding Signals.SummaryText}" Style="{StaticResource MutedText}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"
                         Margin="0,0,8,3"/>
            </WrapPanel>
            <Expander Header="Advanced · custom panes, UDS, findings and saved layouts"
                      IsExpanded="{Binding Investigation.AdvancedVisible, Mode=TwoWay}"
                      AutomationProperties.AutomationId="investigation.advanced"
                      ToolTip="Optional engineering layout controls; the simple signal list and trend remain the default">
              <StackPanel Margin="0,6,0,0">
                <WrapPanel>
                  <TextBlock Text="Layout" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox x:Name="InvestigationLayoutBox" AutomationProperties.AutomationId="investigation.layout" Width="190"
                            ItemsSource="{Binding Investigation.Layouts}" SelectedItem="{Binding Investigation.SelectedLayout}"
                            DisplayMemberPath="Name" Margin="0,0,10,5" AutomationProperties.Name="Investigation layout" />
                  <TextBlock Text="Arrangement" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox x:Name="InvestigationArrangementBox" AutomationProperties.AutomationId="investigation.arrangement" Width="170"
                            ItemsSource="{Binding Investigation.ArrangementChoices}" SelectedItem="{Binding Investigation.ArrangementChoice}"
                            DisplayMemberPath="Label" Margin="0,0,10,5" AutomationProperties.Name="Pane arrangement" />
                  <TextBox Width="145" Text="{Binding Investigation.SaveName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,5"
                           common:PlaceholderService.Text="Layout name…" AutomationProperties.AutomationId="investigation.layoutName"/>
                  <Button Content="Save layout" Command="{Binding Investigation.SaveCommand}" Margin="0,0,6,5"
                          AutomationProperties.AutomationId="investigation.saveLayout" />
                  <Button Content="Delete" Command="{Binding Investigation.DeleteCommand}" Margin="0,0,6,5"
                          AutomationProperties.AutomationId="investigation.deleteLayout"/>
                </WrapPanel>
                <TextBlock Text="{Binding Investigation.Status}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="InvestigationPaneGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="120" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" MinHeight="90" />
          </Grid.RowDefinitions>

          <ContentControl x:Name="InvestigationPane0" ContentTemplate="{StaticResource InvestigationPane}"
                          Content="{Binding Investigation.Slots[0]}"
                          Grid.Row="{Binding Investigation.Slots[0].Row}" Grid.Column="{Binding Investigation.Slots[0].Column}"
                          Grid.RowSpan="{Binding Investigation.Slots[0].RowSpan}" Grid.ColumnSpan="{Binding Investigation.Slots[0].ColumnSpan}"
                          Visibility="{Binding Investigation.Slots[0].IsVisible, Converter={StaticResource VisibleWhenTrue}}" />
          <ContentControl x:Name="InvestigationPane1" ContentTemplate="{StaticResource InvestigationPane}"
                          Content="{Binding Investigation.Slots[1]}"
                          Grid.Row="{Binding Investigation.Slots[1].Row}" Grid.Column="{Binding Investigation.Slots[1].Column}"
                          Grid.RowSpan="{Binding Investigation.Slots[1].RowSpan}" Grid.ColumnSpan="{Binding Investigation.Slots[1].ColumnSpan}"
                          Visibility="{Binding Investigation.Slots[1].IsVisible, Converter={StaticResource VisibleWhenTrue}}" />
          <ContentControl x:Name="InvestigationPane2" ContentTemplate="{StaticResource InvestigationPane}"
                          Content="{Binding Investigation.Slots[2]}"
                          Grid.Row="{Binding Investigation.Slots[2].Row}" Grid.Column="{Binding Investigation.Slots[2].Column}"
                          Grid.RowSpan="{Binding Investigation.Slots[2].RowSpan}" Grid.ColumnSpan="{Binding Investigation.Slots[2].ColumnSpan}"
                          Visibility="{Binding Investigation.Slots[2].IsVisible, Converter={StaticResource VisibleWhenTrue}}" />
          <ContentControl x:Name="InvestigationPane3" ContentTemplate="{StaticResource InvestigationPane}"
                          Content="{Binding Investigation.Slots[3]}"
                          Grid.Row="{Binding Investigation.Slots[3].Row}" Grid.Column="{Binding Investigation.Slots[3].Column}"
                          Grid.RowSpan="{Binding Investigation.Slots[3].RowSpan}" Grid.ColumnSpan="{Binding Investigation.Slots[3].ColumnSpan}"
                          Visibility="{Binding Investigation.Slots[3].IsVisible, Converter={StaticResource VisibleWhenTrue}}" />

          <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                        Visibility="{Binding Investigation.ShowVerticalSplitter, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.Name="Resize panes horizontally" />
          <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch"
                        ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                        Visibility="{Binding Investigation.ShowHorizontalSplitter, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.Name="Resize panes vertically" />
        </Grid>
      </Grid>

      <!-- ============ UDS TRANSACTION ANALYSIS ============ -->
      <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource NavVisibility}, ConverterParameter=8}"
            Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="6" />
          <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <DockPanel Margin="0,0,0,7">
          <ComboBox DockPanel.Dock="Left" Width="180" ItemsSource="{Binding Uds.ViewChoices}"
                    SelectedIndex="{Binding Uds.SelectedViewIndex}" Margin="0,0,10,0"
                    ToolTip="Choose an offline diagnostic analysis view"
                    AutomationProperties.Name="UDS analysis view" AutomationProperties.AutomationId="uds.viewSelector" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding Uds.InsightSummary}" Style="{StaticResource MutedText}"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
          <Button DockPanel.Dock="Right" Content="Open raw frames" Command="{Binding Uds.JumpToTraceCommand}"
                  Margin="8,0,0,0" ToolTip="Jump to the first raw CAN frame of the selected UDS transaction"
                  Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}" />
          <ComboBox DockPanel.Dock="Right" Width="165"
                    ItemsSource="{Binding Uds.PhysicalSourceChoices}"
                    SelectedIndex="{Binding Uds.SelectedPhysicalSourceIndex, Mode=TwoWay}"
                    AutomationProperties.AutomationId="uds.physicalSource"
                    AutomationProperties.Name="Physical recording for UDS transactions"
                    ToolTip="Filter recorded UDS transactions by the original logger file. Other UDS workspaces remain combined."
                    Margin="8,0,0,0">
            <ComboBox.Style>
              <Style TargetType="ComboBox">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Uds.HasMultiplePhysicalSources}" Value="True"/>
                      <Condition Binding="{Binding Uds.SelectedViewIndex}" Value="1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
          </ComboBox>
          <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Uds.FilterChoices}"
                    SelectedIndex="{Binding Uds.FilterIndex}" Margin="8,0,0,0"
                    AutomationProperties.Name="UDS transaction filter"
                    Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}" />
          <TextBox x:Name="UdsSearchBox" AutomationProperties.AutomationId="uds.search" Text="{Binding Uds.SearchText, UpdateSourceTrigger=PropertyChanged}"
                   common:PlaceholderService.Text="🔍 Filter service, DID, DTC, routine, ECU, NRC or payload…"
                   ToolTip="Space-separated search across every decoded transaction field"
                   AutomationProperties.Name="Filter service, DID, DTC, routine, ECU, NRC or payload"
                   Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}" />
          </DockPanel>
          <TextBlock Text="{Binding Uds.PhysicalSourceScopeText}"
                     AutomationProperties.AutomationId="uds.physicalSourceScope"
                     TextWrapping="Wrap" FontSize="11" Margin="2,0,0,6">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Uds.HasMultiplePhysicalSources}" Value="True"/>
                      <Condition Binding="{Binding Uds.SelectedViewIndex}" Value="1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Direct diagnostic tasks. The advanced dropdown above keeps all existing modes. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                        >
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="INVESTIGATE" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                         FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button Content="Overview" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="0" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show diagnostic overview" />
              <Button Content="Requests / replies" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="1" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show UDS requests and responses" AutomationProperties.AutomationId="uds.viewTransactions" />
              <Button Content="DID values" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="2" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show decoded DID values" />
              <Button Content="Fault memory" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="3" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show DTC fault memory" />
              <Button Content="Routines" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="4" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show routine control history" />
              <Button Content="UDS ↔ CAN" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="5" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show UDS to CAN signal correlation" />
              <Button Content="Transport errors" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="6" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show ISO-TP transport problems" />
              <Button Content="Findings" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="7" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show offline diagnostic findings" AutomationProperties.AutomationId="uds.viewFindings" />
              <Button Content="ECU snapshot" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="9" Click="OnUdsQuickViewClick" AutomationProperties.Name="Show recorded ECU identification snapshot" />
              <Button Content="Spec vs trace" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Click="OnSpecVsTraceClick" AutomationProperties.Name="Compare catalog definitions with recorded diagnostic traffic" AutomationProperties.AutomationId="uds.specVsTrace" />
              <Button Content="Catalog check" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Click="OnCatalogCheckClick" AutomationProperties.Name="Check loaded CDD and ODX descriptions for consistency problems" AutomationProperties.AutomationId="uds.catalogCheck" />
              <Button Content="CDD / ODX definitions" Style="{StaticResource ToolButton}" Margin="0,0,5,0"
                      Tag="11" Click="OnUdsQuickViewClick" AutomationProperties.Name="Browse diagnostic description definitions" AutomationProperties.AutomationId="uds.openCatalog" />
            </WrapPanel>
          </ScrollViewer>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="UdsTransactionsGrid" MouseDoubleClick="OnUdsTransactionDoubleClick" ToolTip="Double-click a transaction to open its full detail in a window" AutomationProperties.AutomationId="uds.transactionsGrid"
                  ItemsSource="{Binding Uds.Rows}" SelectedItem="{Binding Uds.SelectedRow}"
                  IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  FontSize="12.5" RowHeight="30"
                  Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource ChangedRowHighlightBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45" MinWidth="45" />
            <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="95" MinWidth="95" FontFamily="Consolas" />
            <DataGridTextColumn Header="Ch" Binding="{Binding ChannelText}" Width="48" MinWidth="48" />
            <DataGridTextColumn Header="Logger" Binding="{Binding SourceName}" Width="135" MinWidth="115">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  <Setter Property="ToolTip" Value="{Binding SourceEvidenceText}"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Direction" Binding="{Binding DirectionText}" Width="105" MinWidth="105" />
            <DataGridTextColumn Header="Service" Binding="{Binding ServiceText}" Width="180" MinWidth="150" />
            <DataGridTextColumn Header="Object" Binding="{Binding ObjectText}" Width="180" MinWidth="120" />
            <DataGridTextColumn Header="Request" Binding="{Binding RequestText}" Width="*" MinWidth="180">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding RequestText}" /></Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="150" MinWidth="120">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding OutcomeText}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Response" Binding="{Binding DurationText}" Width="90" MinWidth="80" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}" />

        <Border x:Name="UdsTransactionDetailCard" Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0"
                Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=1}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.4*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="TRANSPORT &amp; ADDRESSING" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="uds.selectedSourceEvidence">
                <Run Text="{Binding Uds.SelectedRow.AddressingText, Mode=OneWay}" /><LineBreak />
                <Run Text="Frames: " FontWeight="SemiBold" /><Run Text="{Binding Uds.SelectedRow.FrameIndicesText, Mode=OneWay}" /><LineBreak />
                <Run Text="Quality: " FontWeight="SemiBold" /><Run Text="{Binding Uds.SelectedRow.QualityText, Mode=OneWay}" />
              </TextBlock>
            </Grid>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="UDS PAYLOAD" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" Text="{Binding Uds.SelectedRow.RequestPayloadText, StringFormat='Request: {0}', Mode=OneWay}"
                         FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6" />
              <TextBox Grid.Row="2" Text="{Binding Uds.SelectedRow.ResponsePayloadText, Mode=OneWay}" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                       AutomationProperties.Name="Response payload" />
            </Grid>
            <Grid Grid.Column="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="DECODED CDD / ODX FIELDS" Style="{StaticResource MutedText}"
                         FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" Text="{Binding Uds.SelectedRow.ResponseText, Mode=OneWay}"
                         TextWrapping="Wrap" Margin="0,0,0,6" />
              <StackPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="{Binding Uds.SelectedRow.IncompleteDidLayoutMessage}"
                           Visibility="{Binding Uds.SelectedRow.HasIncompleteDidLayout, Converter={StaticResource VisibleWhenTrue}}"
                           AutomationProperties.AutomationId="uds.partialDidWarning"
                           AutomationProperties.Name="{Binding Uds.SelectedRow.IncompleteDidLayoutMessage}"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel Visibility="{Binding Uds.SelectedRow.HasDecodedFields, Converter={StaticResource VisibleWhenTrue}}">
                <ComboBox Width="220" MinHeight="28" Margin="0,0,6,4"
                          ItemsSource="{Binding Uds.SelectedDecodedField.SourceSpans}"
                          SelectedItem="{Binding Uds.SelectedDecodedSourceSpan, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          AutomationProperties.AutomationId="uds.fieldSourceFrames"
                          AutomationProperties.Name="Select original CAN frame and byte range for this DID field"
                          ToolTip="A field spanning First Frame and Consecutive Frames has one selectable source entry per recorded CAN frame."
                          IsEnabled="{Binding Uds.SelectedDecodedField.HasVerifiedSource}" />
                <Button Content="Open source frame" Margin="0,0,0,4"
                        Command="{Binding Uds.OpenDecodedFieldSourceCommand}"
                        IsEnabled="{Binding Uds.CanOpenDecodedFieldSource}"
                        AutomationProperties.AutomationId="uds.openFieldSource"
                        AutomationProperties.Name="Open selected original CAN frame for verified DID field"
                        ToolTip="Open the selected original recorded CAN frame. Unverified source evidence cannot be opened." />
                </WrapPanel>
              </StackPanel>
              <ListBox Grid.Row="3" ItemsSource="{Binding Uds.SelectedRow.DecodedFields}"
                       SelectedItem="{Binding Uds.SelectedDecodedField, Mode=TwoWay}"
                       AutomationProperties.AutomationId="uds.decodedFields"
                       AutomationProperties.Name="Decoded DID subparameters and exact original CAN source evidence"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       Visibility="{Binding Uds.SelectedRow.HasDecodedFields, Converter={StaticResource VisibleWhenTrue}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="3,4">
                      <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ValueText}" FontFamily="Consolas" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding MeaningText}" TextWrapping="Wrap"
                                 Style="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                 Style="{StaticResource MutedText}"
                                 AutomationProperties.Name="{Binding SourceText}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox Grid.Row="3" Text="{Binding Uds.SelectedRow.DecodedValuesText, Mode=OneWay}"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Other diagnostic decoded responses"
                       Visibility="{Binding Uds.SelectedRow.HasDecodedFields, Converter={StaticResource VisibleWhenFalse}}" />
            </Grid>
          </Grid>
        </Border>

        <!-- Read-only overview: no diagnostic transmission controls exist anywhere in this workspace. -->
        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=0}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="SERVICE ACTIVITY" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,8" />
              <DataGrid AutomationProperties.AutomationId="uds.servicesGrid" ItemsSource="{Binding Uds.ServiceRows}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="SID" Binding="{Binding ServiceId, StringFormat='0x{0:X2}', Mode=OneWay}" Width="58" />
                  <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" MinWidth="150" />
                  <DataGridTextColumn Header="Req" Binding="{Binding Requests}" Width="Auto" MinWidth="55" />
                  <DataGridTextColumn Header="Positive" Binding="{Binding Positive}" Width="Auto" MinWidth="80" />
                  <DataGridTextColumn Header="Negative" Binding="{Binding Negative}" Width="Auto" MinWidth="84" />
                  <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="Auto" MinWidth="80" />
                  <DataGridTextColumn Header="Avg ms" Binding="{Binding AverageResponseMilliseconds, StringFormat=F2}" Width="Auto" MinWidth="76" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="OFFLINE DIAGNOSTIC EVIDENCE" Style="{StaticResource MutedText}" FontWeight="Bold" />
              <TextBlock Text="{Binding Uds.InsightSummary}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,14" TextWrapping="Wrap" />
              <TextBlock Text="This workspace reconstructs recorded ISO-TP/UDS traffic only. It cannot send requests, clear faults, start routines, change sessions or unlock security." TextWrapping="Wrap" />
              <Separator Margin="0,16" />
              <TextBlock Text="Evidence model" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock Text="Every DID value, DTC transition, routine step and correlation retains timestamps and source CAN frame indices. Inferred addressing and incomplete transport are explicitly labelled." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=2}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Related CAN signals" Margin="8,0,0,0"
                    Command="{Binding ShowDidSampleCorrelationsCommand}"
                    AutomationProperties.AutomationId="uds.didToCan"
                    ToolTip="Find CAN signals statistically paired with this exact recorded DID, field and endpoint; no automatic identity confirmation"
                    AutomationProperties.Name="Open source-paired CAN correlations for selected DID field" />
            <Button DockPanel.Dock="Right" Content="Source frame" Margin="8,0,0,0"
                    Command="{Binding Uds.OpenDidSampleSourceFrameCommand}"
                    ToolTip="Open the last complete positive UDS response's original CAN frame for the selected sample group. Request and response frame provenance remains available in Transactions."
                    AutomationProperties.Name="Open selected recorded DID sample source CAN frame"/>
            <Button DockPanel.Dock="Right" Content="Clear DID filter" Margin="8,0,0,0"
                    Command="{Binding Uds.ClearDidSampleFocusCommand}"
                    IsEnabled="{Binding Uds.HasDidSampleFocus}"
                    ToolTip="Show all recorded diagnostic DID sample groups again"
                    AutomationProperties.Name="Clear recorded DID sample scope"/>
            <TextBlock Text="{Binding Uds.DidSampleScopeText}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </DockPanel>
          <DataGrid Grid.Row="1" x:Name="UdsDidSamplesGrid" AutomationProperties.AutomationId="uds.didSamplesGrid"
                    ItemsSource="{Binding Uds.VisibleDidSampleRows}"
                    SelectedItem="{Binding Uds.SelectedDidSample}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserSortColumns="True" SelectionMode="Single"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Recording" Binding="{Binding RecordingText}" Width="145">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="{Binding OriginalSourcePath}"/>
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Bus" Binding="{Binding ChannelText}" Width="95"/>
            <DataGridTextColumn Header="DID" Binding="{Binding DidText}" Width="75" FontFamily="Consolas" />
            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="200" />
            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="220" />
            <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="130" />
            <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="80" />
            <DataGridTextColumn Header="Physical range / last value" Binding="{Binding RangeText}" Width="*" />
            <DataGridTextColumn Header="First [s]" Binding="{Binding FirstTimeText}" Width="100" />
            <DataGridTextColumn Header="Last [s]" Binding="{Binding LastTimeText}" Width="100" />
          </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=3}">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="190" /></Grid.RowDefinitions>
          <DataGrid AutomationProperties.AutomationId="uds.faultsGrid" ItemsSource="{Binding Uds.FaultRows}" SelectedItem="{Binding Uds.SelectedFault}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Recording" Binding="{Binding SourceText}" Width="135"/>
              <DataGridTextColumn Header="Bus" Binding="{Binding ChannelText}" Width="105"/>
              <DataGridTextColumn Header="DTC" Binding="{Binding CodeText}" Width="90" FontFamily="Consolas" />
              <DataGridTextColumn Header="Description" Binding="{Binding Name}" Width="220" />
              <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="130" />
              <DataGridTextColumn Header="Current status" Binding="{Binding CurrentStatusText}" Width="*" />
              <DataGridTextColumn Header="Reads" Binding="{Binding Occurrences}" Width="65" />
              <DataGridCheckBoxColumn Header="Cleared" Binding="{Binding WasCleared, Mode=OneWay}" Width="70" />
              <DataGridTextColumn Header="Observed" Binding="{Binding DurationText}" Width="190" />
              <DataGridTextColumn Header="CDD/ODX source" Binding="{Binding DefinitionText}" Width="165">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding DefinitionSourceFile}"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="SELECTED DTC" Style="{StaticResource MutedText}" FontWeight="Bold" />
                <Button Content="Investigate recorded conditions…"
                        AutomationProperties.AutomationId="uds.investigateDtcConditions"
                        Click="OnOpenDtcConditionsFromUdsClick" Margin="0,5,0,3"
                        ToolTip="Open the exact selected fault in Data Studio. Select its recorded status/snapshot event before analyzing CAN signal changes." />
                <TextBlock Text="{Binding Uds.SelectedFault.CodeText}" FontSize="18" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Uds.SelectedFault.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Uds.SelectedFault.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
              <DataGrid Grid.Column="2" ItemsSource="{Binding Uds.SelectedFault.Timeline}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time [ns]" Binding="{Binding TimestampNanoseconds}" Width="130" />
                  <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="180" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" />
                  <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=4}">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="180" /></Grid.RowDefinitions>
          <DataGrid AutomationProperties.AutomationId="uds.routinesGrid" ItemsSource="{Binding Uds.RoutineRows}" SelectedItem="{Binding Uds.SelectedRoutine}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45" />
              <DataGridTextColumn Header="Routine" Binding="{Binding IdentifierText}" Width="85" FontFamily="Consolas" />
              <DataGridTextColumn Header="Recording" Binding="{Binding SourceText}" Width="125"/>
              <DataGridTextColumn Header="Bus" Binding="{Binding ChannelText}" Width="90"/>
              <DataGridTextColumn Header="CDD/ODX definition" Binding="{Binding DefinitionText}" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding DefinitionSourceFile}"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
              <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="130" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
              <DataGridTextColumn Header="Duration [ms]" Binding="{Binding DurationMilliseconds, StringFormat=F2}" Width="110" />
              <DataGridTextColumn Header="Recorded input" Binding="{Binding InputSummary}" Width="*" />
              <DataGridTextColumn Header="Recorded result" Binding="{Binding ResultSummary}" Width="*" />
              <DataGridTextColumn Header="Pending" Binding="{Binding ResponsePendingCount}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <DockPanel><TextBlock DockPanel.Dock="Top" Text="RECORDED ROUTINE STEPS — ANALYSIS ONLY" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,6" />
              <DataGrid ItemsSource="{Binding Uds.SelectedRoutine.Steps}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Action" Binding="{Binding ActionName}" Width="130" />
                  <DataGridTextColumn Header="Time [ns]" Binding="{Binding TimestampNanoseconds}" Width="140" />
                  <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                  <DataGridTextColumn Header="Input" Binding="{Binding RequestData}" Width="*" />
                  <DataGridTextColumn Header="Response/result" Binding="{Binding ResponseData}" Width="*" />
                  <DataGridTextColumn Header="NRC" Binding="{Binding NegativeResponse}" Width="150" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=5}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.1*" />
          </Grid.RowDefinitions>
          <!-- Two-tier toolbar: the search box stays usable at 1024 px,
               while optional filters/counts wrap instead of crushing it. -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="UdsCorrelationSearchBox" Grid.Column="0" MinHeight="30"
                       Text="{Binding Uds.CorrelationSearchText, UpdateSourceTrigger=PropertyChanged}"
                       KeyDown="OnUdsCorrelationSearchKeyDown"
                       AutomationProperties.AutomationId="uds.correlationSearch"
                       common:PlaceholderService.Text="Search DID, ECU, DBC, CAN bus, signal…"
                       AutomationProperties.Name="Search UDS and CAN correlation candidates"
                       ToolTip="Use space-separated terms: did:f405 dbc:engine bus:2 signal:Temperature. You can exclude with -dbc:other. Also supports ecu:, field:, id:, format:, verdict:, has:paired. Ctrl+F focuses this box; Esc clears its filters." />
              <Button Grid.Column="1" Content="Clear filters" Margin="8,0,0,0" Padding="10,5"
                      Command="{Binding Uds.ClearCorrelationFiltersCommand}"
                      IsEnabled="{Binding Uds.HasActiveCorrelationFilters}"
                      AutomationProperties.AutomationId="uds.correlationClearFilters"
                      ToolTip="Remove the text search and recorded-only filter without changing the imported evidence" />
            </Grid>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
              <CheckBox Content="Recorded pairs only"
                        IsChecked="{Binding Uds.CorrelationSourcePairsOnly}"
                        VerticalAlignment="Center" Margin="0,0,14,4"
                        AutomationProperties.AutomationId="uds.correlationPairsOnly"
                        ToolTip="Show only candidates with real paired source frames. Unchecking also shows insufficient/ambiguous hypotheses." />
              <TextBlock Text="{Binding Uds.CorrelationVisibleSummary}" Style="{StaticResource MutedText}"
                         VerticalAlignment="Center" Margin="0,0,14,4"
                         AutomationProperties.AutomationId="uds.correlationCount" />
              <TextBlock Text="Search tips ⓘ" Style="{StaticResource MutedText}"
                         VerticalAlignment="Center" FontSize="11" Margin="0,0,0,4"
                         ToolTip="Examples: did:f405 bus:2 -dbc:other. Use Ctrl+F to search; Esc clears filters. Select a candidate to inspect its original frame evidence below." />
            </WrapPanel>
          </Grid>
          <Grid Grid.Row="1">
            <DataGrid x:Name="UdsTemporalCorrelationGrid"
                      AutomationProperties.AutomationId="uds.correlationGrid"
                      ItemsSource="{Binding Uds.VisibleCorrelationRows}"
                      SelectedItem="{Binding Uds.SelectedCorrelation}"
                      SelectionChanged="OnUdsCorrelationSelectionChanged"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserSortColumns="True" SelectionMode="Single"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" RowHeight="30"
                      FrozenColumnCount="1"
                      ToolTip="Select a statistical candidate; the panel below shows its original recorded DID/CAN evidence. No automatic identity confirmation.">
            <DataGrid.Columns>
              <!-- Keep the four most actionable source-identity columns visible
                   before secondary descriptive fields on 13-inch displays. -->
              <DataGridTextColumn Header="DID" Binding="{Binding DidText}" Width="76" FontFamily="Consolas" />
              <DataGridTextColumn Header="CAN signal" Binding="{Binding SignalText}" Width="190" MinWidth="145" />
              <DataGridTextColumn Header="DBC / CAN source" Binding="{Binding SignalSourceText}" Width="194" MinWidth="165" />
              <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="116" MinWidth="105" />
              <DataGridTextColumn Header="Fit indicator" Binding="{Binding ConfidenceText}"
                                  SortMemberPath="AssociationConfidence" Width="112" MinWidth="104" />
              <DataGridTextColumn Header="Parameter" Binding="{Binding DidName}" Width="175" />
              <DataGridTextColumn Header="Observed field" Binding="{Binding ObservedField}" Width="160" />
              <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceSummary}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
            </DataGrid>
            <Border Margin="12" Padding="20" CornerRadius="8"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="570"
                    Visibility="{Binding Uds.HasVisibleCorrelationRows, Converter={StaticResource VisibleWhenFalse}}">
              <StackPanel>
                <TextBlock Text="No matching correlation evidence" FontWeight="SemiBold" FontSize="15"
                           TextAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Uds.CorrelationEmptyStateText}" TextAlignment="Center"
                           TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                           AutomationProperties.AutomationId="uds.correlationEmptyMessage" />
                <Button Content="Show all candidates" Command="{Binding Uds.ClearCorrelationFiltersCommand}"
                        Visibility="{Binding Uds.HasActiveCorrelationFilters, Converter={StaticResource VisibleWhenTrue}}"
                        HorizontalAlignment="Center" MinWidth="170"
                        AutomationProperties.AutomationId="uds.correlationShowAll"
                        ToolTip="Clear correlation filters without deleting any evidence" />
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                           Visibility="{Binding Uds.HasCorrelationRows, Converter={StaticResource VisibleWhenFalse}}">
                  <Button Content="Open a CAN trace…" Command="{Binding OpenTraceCommand}"
                          Margin="0,0,8,5" AutomationProperties.AutomationId="uds.correlationOpenTrace"
                          ToolTip="Import recorded ASC/BLF CAN and ISO-TP evidence without modifying original files" />
                  <Button Content="Load a DBC…" Command="{Binding LoadDbcCommand}"
                          Margin="0,0,0,5" AutomationProperties.AutomationId="uds.correlationLoadDbc"
                          ToolTip="Load a message and signal definition for offline source-aware correlation" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
          <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                        ToolTip="Drag to adjust the relative height of the correlation list and evidence" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*" MinWidth="220" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize correlation chart and evidence inspector"
                          ToolTip="Drag to give more space to the chart or recorded-frame details" />
            <controls:UdsCorrelationPlotControl Correlation="{Binding Uds.SelectedCorrelation}"
                                                SelectedPairIndex="{Binding Uds.SelectedCorrelationPairIndex}"
                                                PairSelected="OnUdsCorrelationPointSelected"
                                                AutomationProperties.AutomationId="uds.correlationChart"
                                                AutomationProperties.Name="UDS and CAN source-pair time chart"
                                                AutomationProperties.HelpText="Actual DID and CAN timestamps are shown independently. Click a recorded point to inspect its raw source frames; use Previous and Next for keyboard access."
                                                MinHeight="170" />
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
              <ScrollViewer x:Name="UdsCorrelationDetailsScroller"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            AutomationProperties.Name="Explainable DID CAN correlation source evidence">
                <Grid>
                  <TextBlock Text="Select a candidate above to inspect its actual paired source frames, time offset and DBC definition. Correlation is not proof of identity."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4"
                           Visibility="{Binding Uds.HasSelectedCorrelation, Converter={StaticResource VisibleWhenFalse}}"
                           AutomationProperties.AutomationId="uds.correlationSelectionHint" />
                <StackPanel Visibility="{Binding Uds.HasSelectedCorrelation, Converter={StaticResource VisibleWhenTrue}}">
                  <TextBlock Text="EXPLAINABLE CORRELATION" Style="{StaticResource MutedText}" FontWeight="Bold" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Export paired evidence…" Click="OnExportCorrelationEvidenceClick"
                            IsEnabled="{Binding Uds.SelectedCorrelation.HasSourcePairs}"
                            Margin="0,0,8,5"
                            AutomationProperties.AutomationId="uds.exportCorrelationEvidence"
                            ToolTip="Save original paired DID and CAN timestamps, values, source frame IDs, ISO-TP response segments and unverified statistical score as CSV" />
                  </WrapPanel>
                  <Button Content="Open exact signal in DBC" Command="{Binding ShowCorrelatedSignalInDbcCommand}" HorizontalAlignment="Left" Margin="0,0,0,0"
                          IsEnabled="{Binding Uds.SelectedCorrelation.HasSourcePairs}"
                          ToolTip="Inspect the matching DBC source, exact CAN ID and bus using the selected evidence pair; ambiguous or changed DBC sources are rejected"
                          AutomationProperties.Name="Open exact correlated CAN definition and bus" AutomationProperties.AutomationId="uds.openCorrelatedSignal" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.SignalSourceText}" FontWeight="SemiBold"
                             TextWrapping="Wrap" Margin="0,6,0,3" />
                  <TextBlock Text="REVIEW INDIVIDUAL RECORDED PAIRS · CLICK A PLOT POINT" Style="{StaticResource MutedText}"
                             FontWeight="Bold" Margin="0,8,0,3" />
                  <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="◀ Previous" Command="{Binding Uds.PreviousCorrelationPairCommand}"
                            IsEnabled="{Binding Uds.CanPreviousCorrelationPair}" Margin="0,0,5,4"
                            AutomationProperties.AutomationId="uds.pairPrevious"
                            ToolTip="Inspect the preceding independently paired CAN and DID observations" />
                    <Button Content="Next ▶" Command="{Binding Uds.NextCorrelationPairCommand}"
                            IsEnabled="{Binding Uds.CanNextCorrelationPair}" Margin="0,0,5,4"
                            AutomationProperties.AutomationId="uds.pairNext"
                            ToolTip="Inspect the next independently paired CAN and DID observations" />
                    <Button Content="DID frame ↗" Command="{Binding Uds.OpenCorrelationDidFrameCommand}"
                            IsEnabled="{Binding Uds.SelectedCorrelation.HasSourcePairs}" Margin="0,0,5,4"
                            AutomationProperties.AutomationId="uds.pairDidFrame"
                            ToolTip="Open the original terminal positive-response CAN frame; all ISO-TP transport frame indices appear below" />
                    <Button Content="CAN frame ↗" Command="{Binding Uds.OpenCorrelationCanFrameCommand}"
                            IsEnabled="{Binding Uds.SelectedCorrelation.HasSourcePairs}" Margin="0,0,5,4"
                            AutomationProperties.AutomationId="uds.pairCanFrame"
                            ToolTip="Open the exact recorded CAN source frame used in this statistical fit" />
                  </WrapPanel>
                  <TextBlock Text="{Binding Uds.CorrelationPairSummary}" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="uds.pairSummary"
                             FontFamily="Consolas" FontSize="11" />
                  <TextBlock Text="{Binding Uds.CorrelationPairFramesText}" TextWrapping="Wrap"
                             FontSize="11" Style="{StaticResource MutedText}" Margin="0,3,0,7"
                             AutomationProperties.AutomationId="uds.pairFrames" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.SignalText}" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,4" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.MetricsText}" TextWrapping="Wrap" />
                  <TextBlock Text="Automatic waveform agreement does not establish a verified DID/CAN signal identity. Review source definitions and evidence before confirmation."
                             Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="Observed DID field" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.ObservedField}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.SourceFrameEvidence}"
                             FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Uds.SelectedCorrelation.Explanation}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="12"
                Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=6}">
          <DockPanel><TextBlock DockPanel.Dock="Top" Text="ISO-TP TRANSPORT FINDINGS" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,8" />
            <ListBox AutomationProperties.AutomationId="uds.transportIssues" ItemsSource="{Binding Uds.TransportIssues}" FontFamily="Consolas" />
          </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=7}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="Double-click a row to open its source frame" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding Uds.FindingSummary}" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <DataGrid Grid.Row="1" x:Name="OfflineFindingsGrid" AutomationProperties.AutomationId="uds.findingsGrid" ItemsSource="{Binding Uds.FindingRows}"
                    SelectedItem="{Binding Uds.SelectedFinding}" IsReadOnly="True" AutoGenerateColumns="False"
                    MouseDoubleClick="OnOfflineFindingDoubleClick">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource ChangedRowHighlightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource ChangedRowHighlightBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="100" MinWidth="100" />
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" />
              <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="95" FontFamily="Consolas" />
              <DataGridTextColumn Header="ECU / source" Binding="{Binding Ecu}" Width="130" />
              <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="240" />
              <DataGridTextColumn Header="Evidence and explanation" Binding="{Binding Details}" Width="*" MinWidth="260" />
              <DataGridTextColumn Header="Frames" Binding="{Binding FramesText}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <DataGrid Grid.Row="1" Grid.RowSpan="3" x:Name="DiagnosticSequenceGrid" AutomationProperties.AutomationId="uds.sequenceGrid"
                  ItemsSource="{Binding Uds.SequenceRows}" SelectedItem="{Binding Uds.SelectedSequenceEvent}"
                  IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="OnDiagnosticSequenceDoubleClick"
                  Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=8}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45" />
            <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="95" FontFamily="Consolas" />
            <DataGridTextColumn Header="Phase" Binding="{Binding Category}" Width="110" />
            <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="130" />
            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="190" />
            <DataGridTextColumn Header="Recorded operation" Binding="{Binding Operation}" Width="220" />
            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
            <DataGridTextColumn Header="Observed state / evidence" Binding="{Binding State}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=9}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <TextBlock Text="Identification values reconstructed from recorded DID responses. No request is sent to any ECU."
                       TextWrapping="Wrap" Style="{StaticResource MutedText}" />
          </Border>
          <DataGrid Grid.Row="1" x:Name="EcuSnapshotGrid" AutomationProperties.AutomationId="uds.ecuSnapshotGrid" ItemsSource="{Binding Uds.EcuSnapshotRows}"
                    SelectedItem="{Binding Uds.SelectedEcuValue}" IsReadOnly="True" AutoGenerateColumns="False"
                    MouseDoubleClick="OnEcuSnapshotDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="150" />
              <DataGridTextColumn Header="DID" Binding="{Binding DidText}" Width="80" FontFamily="Consolas" />
              <DataGridTextColumn Header="Identification parameter" Binding="{Binding Parameter}" Width="260" />
              <DataGridTextColumn Header="Recorded value" Binding="{Binding PhysicalValue}" Width="*" />
              <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="100" FontFamily="Consolas" />
              <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=10}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <TextBlock Text="Observed identifiers are checked against the loaded CDD/ODX definitions. Unknown entries remain visible instead of being silently treated as decoded."
                       TextWrapping="Wrap" Style="{StaticResource MutedText}" />
          </Border>
          <DataGrid Grid.Row="1" AutomationProperties.AutomationId="uds.coverageGrid" ItemsSource="{Binding Uds.CatalogCoverageRows}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="140" />
              <DataGridTextColumn Header="Defined" Binding="{Binding Defined}" Width="90" />
              <DataGridTextColumn Header="Observed" Binding="{Binding Observed}" Width="90" />
              <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" Width="90" />
              <DataGridTextColumn Header="Unknown" Binding="{Binding Unknown}" Width="90" />
              <DataGridTextColumn Header="Coverage" Binding="{Binding CoverageText}" Width="110" />
              <DataGridTextColumn Header="Observed but unresolved" Binding="{Binding UnknownText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- Original diagnostic catalogs: DIDs, DTCs, routines, service definitions,
             transport connections and ECU variants, with actual bit-level fields. -->
        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding Uds.SelectedViewIndex, Converter={StaticResource NavVisibility}, ConverterParameter=11}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                  <TextBlock Text="CATALOG" FontWeight="SemiBold" VerticalAlignment="Center"
                             Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                  <TextBox Width="240" Text="{Binding CatalogExplorer.SearchText, UpdateSourceTrigger=PropertyChanged}"
                           common:PlaceholderService.Text="Filter DID, ECU, service, DTC, PAR…"
                           ToolTip="Space-separated terms match source, name, ID, ECU, engineering subparameter and field names"
                           AutomationProperties.Name="Filter diagnostic catalog definitions" AutomationProperties.AutomationId="diagnostics.search"/>
                  <ComboBox x:Name="DiagnosticEcuFilter" AutomationProperties.AutomationId="diagnostics.ecuFilter" Width="150" Margin="8,0,0,0"
                            ItemsSource="{Binding CatalogExplorer.EcuFilters}"
                            SelectedItem="{Binding CatalogExplorer.SelectedEcuFilter, Mode=TwoWay}"
                            ToolTip="Restrict the catalog and Excel definition exports to one ECU/variant."
                            AutomationProperties.Name="Select ECU variant for diagnostic catalog"/>
                </StackPanel>
                <TextBlock Text="{Binding CatalogExplorer.Summary}" Style="{StaticResource MutedText}"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <!-- Wrap instead of clipping actions on 13-inch/high-DPI displays. -->
              <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Load CDD / ODX / DTC…" AutomationProperties.AutomationId="diagnostics.loadCatalog" Command="{Binding Mapping.LoadCatalogCommand}"
                        Margin="0,0,7,5" ToolTip="Add diagnostic descriptions to the offline catalog"/>
                <Button Content="Export conditions…" Command="{Binding ExportDiagnosticConditionsCommand}" Margin="0,0,6,0"
                        ToolTip="Document declared session/security pre-conditions, request and response layouts and what could not be extracted, for every loaded definition"
                        AutomationProperties.Name="Export diagnostic conditions and access requirements" AutomationProperties.AutomationId="diagnostics.exportConditions" />
                <Button Content="Edit text…" Click="OnEditDiagnosticTextClick" Margin="0,0,6,0"
                        ToolTip="Edit the display name and description of the selected CDD/ODX definition and save a validated copy; the source file is never modified"
                        AutomationProperties.Name="Edit the selected diagnostic definition text" AutomationProperties.AutomationId="diagnostics.edit" />
                <Button Content="Export definitions…" Command="{Binding ExportDiagnosticDefinitionsCommand}"
                        Margin="0,0,7,5" ToolTip="Export filtered DIDs, engineering PAR/sub-PAR tree, individual fields, DTCs, routines, services and variants; source files remain unchanged"
                        AutomationProperties.Name="Export filtered diagnostic catalog definitions to Excel" AutomationProperties.AutomationId="diagnostics.exportDefinitions"/>
                <Button x:Name="ExportEngineeringParametersButton" AutomationProperties.AutomationId="diagnostics.exportEngineering" Content="PARs export…"
                        Command="{Binding ExportEngineeringParametersCommand}"
                        Margin="0,0,7,5"
                        ToolTip="Export source-backed DID, PAR and nested sub-PAR definitions, declared values and extraction coverage as Excel XLSX or a ZIP of UTF-8 CSV tables. Current search applies."
                        AutomationProperties.Name="Export filtered engineering parameters and subparameters to Excel"/>
                <Button Content="Correlate DID ↔ CAN" Style="{StaticResource AccentButton}"
                        Command="{Binding MapSelectedDiagnosticDidCommand}"
                        Margin="0,0,7,5"
                        ToolTip="Focus the EXACT selected DID, ECU and source catalog in DID-to-CAN mapping. Unverified candidates remain unverified."/>
                <Button Content="Recorded DID evidence" Command="{Binding ShowSelectedDiagnosticDidSamplesCommand}"
                        Margin="0,0,7,5"
                        ToolTip="Show offline positive UDS response samples for this DID across all observed diagnostic endpoint groups, without guessing the ECU."
                        AutomationProperties.Name="Show recorded UDS evidence for selected diagnostic DID"/>
                <Button Content="Compare CDD / ODX…" Command="{Binding CompareDiagnosticFilesCommand}"
                        Margin="8,0,7,5"
                        ToolTip="Compare baseline/current diagnostic descriptions including DID, fields, Engineering PARs, DTCs, routines, ECU variants, services and transport. Read-only."
                        AutomationProperties.Name="Compare two CDD ODX PDX diagnostic description versions" AutomationProperties.AutomationId="diagnostics.compare"/>
                <Button Content="Export comparison…" Command="{Binding ExportDiagnosticComparisonCommand}"
                        IsEnabled="{Binding HasDiagnosticComparison}" Margin="0,0,7,5"
                        ToolTip="Write all diagnostic source changes with evidence limits to XLSX or CSV ZIP"
                        AutomationProperties.Name="Export compared diagnostic definitions" AutomationProperties.AutomationId="diagnostics.exportDiff"/>
              </WrapPanel>
            </Grid>
          </Border>

          <Expander x:Name="DiagnosticDefinitionDiffExpander" Grid.Row="1"
                    Header="Diagnostic definition version comparison" Margin="0,0,0,8"
                    Visibility="{Binding HasDiagnosticComparison, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                    AutomationProperties.Name="Read-only CDD ODX version difference preview">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Changes only" IsChecked="{Binding DiagnosticComparisonChangesOnly, Mode=TwoWay}"
                          Margin="0,0,12,5" VerticalAlignment="Center"
                          ToolTip="Show changed, added, removed and ambiguous definitions; the full export also includes unchanged rows"
                          AutomationProperties.Name="Show only changed diagnostic definitions"/>
                <Button Content="Inspect baseline" Command="{Binding InspectBaselineDiagnosticDiffCommand}"
                        IsEnabled="{Binding HasSelectedDiagnosticDiff}" Margin="0,0,6,5"
                        ToolTip="Focus this DID, DTC, routine, field or Engineering PAR in the exact baseline file if already loaded. Ambiguous matches are rejected."
                        AutomationProperties.Name="Inspect selected difference in loaded baseline diagnostic catalog"/>
                <Button Content="Inspect current" Command="{Binding InspectCurrentDiagnosticDiffCommand}"
                        IsEnabled="{Binding HasSelectedDiagnosticDiff}" Margin="0,0,10,5"
                        ToolTip="Focus this definition in the exact current source if already loaded; does not import or change other catalogs."
                        AutomationProperties.Name="Inspect selected difference in loaded current diagnostic catalog"/>
                <TextBlock Text="{Binding DiagnosticComparisonSummary}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </WrapPanel>
              <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Width="210" Margin="0,0,8,4"
                         Text="{Binding DiagnosticComparisonSearchText, UpdateSourceTrigger=PropertyChanged}"
                         common:PlaceholderService.Text="Filter DID, PAR, source values…"
                         ToolTip="Search DID/ID, ECU, kind, PAR path, changed properties and before/after definitions. AND terms; does not change the complete export."
                         AutomationProperties.Name="Search diagnostic version differences"/>
                <ComboBox Width="135" Margin="0,0,8,4"
                          ItemsSource="{Binding DiagnosticComparisonEcuChoices}"
                          SelectedItem="{Binding SelectedDiagnosticComparisonEcu, Mode=TwoWay}"
                          ToolTip="Filter source comparison to one ECU or variant; does not change exported records."
                          AutomationProperties.Name="Filter diagnostic differences by ECU"/>
                <ComboBox Width="165" Margin="0,0,12,4"
                          ItemsSource="{Binding DiagnosticComparisonScopeChoices}"
                          SelectedItem="{Binding SelectedDiagnosticComparisonScope, Mode=TwoWay}"
                          ToolTip="Show DIDs, Engineering PARs, DTCs, routine fields, transport or all definition types."
                          AutomationProperties.Name="Filter diagnostic differences by definition type"/>
                <TextBlock Text="{Binding DiagnosticComparisonVisibleSummary}"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </WrapPanel>
              <DataGrid x:Name="DiagnosticDefinitionDiffGrid" Height="170"
                        ItemsSource="{Binding DiagnosticComparisonRows}"
                        SelectedItem="{Binding SelectedDiagnosticDiffRow, Mode=TwoWay}"
                        IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserSortColumns="True" SelectionMode="Single"
                        EnableRowVirtualization="True" FontSize="11">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kind" Binding="{Binding Scope}" Width="115"/>
                  <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="80"/>
                  <DataGridTextColumn Header="DID / ID" Binding="{Binding Identifier}" Width="100"/>
                  <DataGridTextColumn Header="PAR path" Binding="{Binding Path}" Width="170"/>
                  <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="95"/>
                  <DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="98"/>
                  <DataGridCheckBoxColumn Header="Review" Binding="{Binding RequiresReview}" Width="67"/>
                  <DataGridTextColumn Header="Changed properties" Binding="{Binding ChangedFields}" Width="180"/>
                  <DataGridTextColumn Header="Before" Binding="{Binding BaselineDefinition}" Width="240"/>
                  <DataGridTextColumn Header="After" Binding="{Binding CurrentDefinition}" Width="240"/>
                  <DataGridTextColumn Header="Old source" Binding="{Binding BaselineSource}" Width="120"/>
                  <DataGridTextColumn Header="New source" Binding="{Binding CurrentSource}" Width="120"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Expander>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.6*" MinWidth="230"/>
              <ColumnDefinition Width="7"/>
              <ColumnDefinition Width="1.5*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="DiagnosticCatalogGrid" Grid.Column="0" AutomationProperties.AutomationId="diagnostics.catalogGrid"
                      ItemsSource="{Binding CatalogExplorer.Rows}"
                      SelectedItem="{Binding CatalogExplorer.SelectedDefinition}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      FontSize="12" RowHeight="28">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" MinWidth="65"/>
                <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="100" MinWidth="80" FontFamily="Consolas"/>
                <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="100" MinWidth="75"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Fields/PARs" Binding="{Binding FieldsAndParCount}"
                                    Width="88" MinWidth="88"/>
              </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="130"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="0.65*" MinHeight="110"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="Export DID…"
                            Command="{Binding ExportSelectedDiagnosticDidCommand}"
                            IsEnabled="{Binding CatalogExplorer.CanExportSelectedDid}"
                            Margin="8,0,0,0"
                            ToolTip="Export only the selected DID, fields and named values for this ECU/source; no trace needed"
                            AutomationProperties.Name="Export selected diagnostic DID to Excel" AutomationProperties.AutomationId="diagnostics.exportSelectedDid"/>
                    <TextBlock Text="DIAGNOSTIC DEFINITION" Style="{StaticResource MutedText}" FontSize="10"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding CatalogExplorer.DefinitionDetails}" TextWrapping="Wrap"
                             MaxHeight="100" FontSize="11.5"/>
                </StackPanel>
              </Border>
              <TabControl Grid.Row="1"
                          SelectedIndex="{Binding CatalogExplorer.InspectorTabIndex, Mode=TwoWay}">
                <TabItem Header="Declared fields">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DECLARED PAYLOAD FIELDS — offsets only when verified against the data record"
                           Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,5"/>
                <DataGrid x:Name="DiagnosticCatalogFieldsGrid" AutomationProperties.AutomationId="diagnostics.fieldsGrid" ItemsSource="{Binding CatalogExplorer.Fields}"
                          SelectedItem="{Binding CatalogExplorer.SelectedField}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                          FontSize="11.5" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="105"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="160" MinWidth="110"/>
                    <DataGridTextColumn Header="Bit offset" Binding="{Binding BitOffsetText}" Width="75" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Bits" Binding="{Binding BitLengthText}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding RawType}" Width="100"/>
                    <DataGridTextColumn Header="Endian" Binding="{Binding ByteOrder}" Width="120" MinWidth="120"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Enums" Binding="{Binding EnumCount}" Width="55"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
                </TabItem>
                <TabItem Header="Engineering PARs">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                      <TextBlock Text="SOURCE ENGINEERING PARAMETERS — nested source definitions, not verified CAN payload positions"
                                 Style="{StaticResource MutedText}" FontSize="10.5"
                                 TextWrapping="Wrap" Margin="0,0,0,5"/>
                      <TextBox x:Name="DiagnosticEngineeringParametersFilter"
                               Text="{Binding CatalogExplorer.EngineeringFilterText, UpdateSourceTrigger=PropertyChanged}"
                               common:PlaceholderService.Text="Filter this DID's engineering PARs: name, ID, type, service…"
                               AutomationProperties.Name="Filter engineering parameters in selected DID"
                               ToolTip="Filter only the rows in this DID; catalog-wide search and exported completeness remain unchanged."/>
                    </StackPanel>
                    <DataGrid x:Name="DiagnosticEngineeringParametersGrid"
                              ItemsSource="{Binding CatalogExplorer.EngineeringRows}"
                              SelectedItem="{Binding CatalogExplorer.SelectedEngineeringParameter}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" FontSize="11.5"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Engineering parameters and nested subparameters">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Engineering PAR / Sub-PAR"
                                            Binding="{Binding IndentedName}"
                                            Width="2*" MinWidth="175"/>
                        <DataGridTextColumn Header="PAR code"
                                            Binding="{Binding ParCode}"
                                            Width="82"/>
                        <DataGridTextColumn Header="Source coordinates"
                                            Binding="{Binding SourcePositionText}"
                                            Width="165"/>
                        <DataGridTextColumn Header="Source ID"
                                            Binding="{Binding SourceId}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Level"
                                            Binding="{Binding Depth}"
                                            Width="55"/>
                        <DataGridTextColumn Header="Source service"
                                            Binding="{Binding Origin}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Reference status"
                                            Binding="{Binding ReferenceStatus}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Value meanings"
                                            Binding="{Binding ValueMeaningCount}"
                                            Width="105"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </TabItem>
              </TabControl>
              <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
              <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <ScrollViewer x:Name="DiagnosticInspectorDetailsScroller"
                                MaxHeight="96" Margin="0,0,0,5"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                ToolTip="{Binding CatalogExplorer.InspectorDetails}"
                                AutomationProperties.Name="Scrollable diagnostic definition and source coordinate details">
                    <TextBlock Text="{Binding CatalogExplorer.InspectorDetails}"
                               TextWrapping="Wrap" FontSize="11"/>
                  </ScrollViewer>
                  <TabControl Grid.Row="1"
                              SelectedIndex="{Binding CatalogExplorer.ValueInspectorTabIndex, Mode=TwoWay}">
                    <TabItem Header="Decoded field values">
                  <DataGrid ItemsSource="{Binding CatalogExplorer.EnumValues}"
                            AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                            EnableRowVirtualization="True" FontSize="11.5">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Raw code" Binding="{Binding Value}" Width="85" FontFamily="Consolas"/>
                      <DataGridTextColumn Header="Meaning from CDD / ODX" Binding="{Binding Text}" Width="190"/>
                      <DataGridTextColumn Header="Explanation" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                    </TabItem>
                    <TabItem Header="Engineering PAR meanings">
                      <DataGrid x:Name="EngineeringValueMeaningsGrid" AutomationProperties.AutomationId="diagnostics.meaningsGrid"
                                ItemsSource="{Binding CatalogExplorer.EngineeringValues}"
                                AutoGenerateColumns="False" IsReadOnly="True"
                                CanUserSortColumns="True" EnableRowVirtualization="True"
                                FontSize="11.5"
                                AutomationProperties.Name="Source declared engineering parameter exact codes and ranges">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Raw from" Binding="{Binding LowerRaw}" Width="90"/>
                          <DataGridTextColumn Header="Raw to" Binding="{Binding UpperRaw}" Width="90"/>
                          <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="150"/>
                          <DataGridTextColumn Header="Boundary" Binding="{Binding Status}" Width="125"/>
                          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}">
          <ProgressBar Width="120" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       IsIndeterminate="{Binding BusyProgressPercent, Converter={StaticResource IsNull}}"
                       Value="{Binding BusyProgressPercent, Mode=OneWay, TargetNullValue=0}" />
          <TextBlock Text="{Binding BusyText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" AutomationProperties.AutomationId="app.status" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
