<Window x:Class="RbgCanInsight.App.QueryBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:RbgCanInsight.App.Common"
        Title="Query builder"
        Width="860" Height="620"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <Window.Resources>
    <common:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Query builder" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="Combine conditions to filter the Trace. All conditions must match unless a row is ticked OR (it then starts an alternative); tick Exclude to remove matching frames instead (noise suppression). The result is ordinary filter text, so you can also edit it in the Trace search box." />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="ApplyButton" AutomationProperties.AutomationId="query.apply" Content="Apply to Trace" Command="{Binding ApplyCommand}" Click="OnApplyClick"
              Style="{StaticResource AccentButton}" Margin="0,0,8,0" AutomationProperties.Name="Apply query to Trace" />
      <Button Content="Close" Click="OnCloseClick" AutomationProperties.Name="Close query builder" AutomationProperties.AutomationId="query.close" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="CONDITIONS" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Add condition" Command="{Binding AddConditionCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Add condition" AutomationProperties.AutomationId="query.addCondition" />
          <Button Content="Clear all" Command="{Binding ClearCommand}" AutomationProperties.Name="Clear all conditions" AutomationProperties.AutomationId="query.clear" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="FILTER TEXT" Style="{StaticResource MutedText}" FontWeight="Bold" />
            <TextBox x:Name="QueryPreviewBox" AutomationProperties.AutomationId="query.preview" Text="{Binding QueryText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" Margin="0,4,0,6" AutomationProperties.Name="Resulting filter text" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessagesText" Text="{Binding Messages}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource WarningBrush}" />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ConditionList" ItemsSource="{Binding Conditions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" Content="OR" IsChecked="{Binding OrWithPrevious}" VerticalAlignment="Center"
                            Margin="0,0,10,0" ToolTip="Start a new alternative: this condition and the ones after it are an OR-branch of the earlier ones"
                            AutomationProperties.Name="OR with previous condition" />
                  <CheckBox Grid.Column="1" Content="Exclude" IsChecked="{Binding Exclude}" VerticalAlignment="Center"
                            Margin="0,0,10,0" ToolTip="Remove frames that match this condition instead of requiring it"
                            AutomationProperties.Name="Exclude matching frames" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.FieldChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding Field}" DisplayMemberPath="Label" Margin="0,0,8,0"
                            AutomationProperties.Name="Condition field" />
                  <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           Visibility="{Binding IsFreeText, Converter={StaticResource VisibleWhenTrue}}"
                           AutomationProperties.Name="Condition value" />
                  <ComboBox Grid.Column="3" ItemsSource="{Binding FrameKinds}" SelectedItem="{Binding Value}"
                            Visibility="{Binding IsFrameKind, Converter={StaticResource VisibleWhenTrue}}"
                            AutomationProperties.Name="Frame kind" />
                  <Button Grid.Column="4" Content="Remove" Margin="8,0,0,0" Padding="8,2"
                          Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Remove condition" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SAVED QUERIES" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,0,0,6" />
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                     ToolTip="Name for the current query" AutomationProperties.Name="Saved query name" />
            <TextBlock Text="Row colour in Trace" Style="{StaticResource MutedText}" Margin="0,0,0,2" />
            <ComboBox ItemsSource="{Binding ColourChoices}" SelectedItem="{Binding SaveColourName}" Margin="0,0,0,6"
                      ToolTip="Trace rows matching this saved query are tinted in this colour (first matching saved query wins)"
                      AutomationProperties.Name="Row colour for saved query" />
            <Button Content="Save current query" Command="{Binding SaveCommand}" Margin="0,0,0,6"
                    AutomationProperties.Name="Save current query" />
            <Button Content="Delete selected" Command="{Binding DeleteSavedCommand}"
                    AutomationProperties.Name="Delete selected saved query" />
          </StackPanel>
          <ListBox x:Name="SavedList" ItemsSource="{Binding SavedQueries}" SelectedItem="{Binding SelectedSaved}"
                   DisplayMemberPath="Name" AutomationProperties.Name="Saved queries" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
