<Window x:Class="RbgCanInsight.App.FrameDifferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame difference"
        Width="900" Height="620"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Frame difference" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Close" Click="OnCloseClick" VerticalAlignment="Top"
                AutomationProperties.Name="Close frame difference" />
      </Grid>
    </Border>
    <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontFamily="Consolas"
              AutomationProperties.Name="Frame difference table" AutomationProperties.AutomationId="frameDiff.grid">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Differs}" Value="True">
              <Setter Property="Background" Value="{DynamicResource ChangedRowHighlightBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSection}" Value="True">
              <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>
  </DockPanel>
</Window>
