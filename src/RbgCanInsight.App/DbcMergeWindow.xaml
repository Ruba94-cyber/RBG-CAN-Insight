<Window x:Class="RbgCanInsight.App.DbcMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge DBC versions"
        Width="1080" Height="640"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="dbcMerge.window">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Merge DBC versions" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="Non-destructive: the merged result is written to a new file and validated by re-parsing. Neither source DBC is modified, and nothing is ever deleted." />
          <TextBlock Margin="0,8,0,0">
            <Run Text="Base:" FontWeight="SemiBold" />
            <Run Text="{Binding BaseFileName, Mode=OneWay}" AutomationProperties.AutomationId="dbcMerge.basePath" />
          </TextBlock>
          <TextBlock>
            <Run Text="Incoming:" FontWeight="SemiBold" />
            <Run Text="{Binding IncomingFileName, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Choose base…" Command="{Binding ChooseBaseCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Choose the base DBC" AutomationProperties.AutomationId="dbcMerge.chooseBase" />
          <Button Content="Choose incoming…" Command="{Binding ChooseIncomingCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Choose the incoming DBC version" AutomationProperties.AutomationId="dbcMerge.chooseIncoming" />
          <Button Content="Close" Click="OnCloseClick" AutomationProperties.AutomationId="dbcMerge.close" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Save merged DBC…" Style="{StaticResource AccentButton}"
              Command="{Binding SaveCommand}" Margin="8,0,0,0"
              AutomationProperties.Name="Save the merged DBC as a new file" AutomationProperties.AutomationId="dbcMerge.save" />
      <Button DockPanel.Dock="Right" Content="Take every difference" Command="{Binding TakeIncomingForAllCommand}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="dbcMerge.takeAll"
              ToolTip="Also replace base definitions with the incoming version" />
      <Button DockPanel.Dock="Right" Content="Keep base for all" Command="{Binding KeepBaseForAllCommand}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="dbcMerge.keepAll" />
      <Button DockPanel.Dock="Right" Content="Additions only" Command="{Binding AcceptAdditionsCommand}" Margin="8,0,0,0"
              AutomationProperties.Name="Select additions only" AutomationProperties.AutomationId="dbcMerge.additionsOnly"
              ToolTip="Select every addition; conflicting changes keep the base definition" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 AutomationProperties.AutomationId="dbcMerge.status" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" Text="{Binding PlanSummary}" Style="{StaticResource MutedText}"
               Margin="2,0,0,6" AutomationProperties.AutomationId="dbcMerge.summary" />

    <DataGrid x:Name="MergeGrid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              CanUserAddRows="False"
              SelectionMode="Single"
              FontSize="12.5"
              AutomationProperties.AutomationId="dbcMerge.grid"
              AutomationProperties.Name="DBC merge differences">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Take incoming" Binding="{Binding TakeIncoming, UpdateSourceTrigger=PropertyChanged}" Width="110" />
        <DataGridTextColumn Header="Action" Binding="{Binding KindText}" IsReadOnly="True" Width="120" />
        <DataGridTextColumn Header="Frame" Binding="{Binding Frame}" IsReadOnly="True" Width="130" />
        <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" IsReadOnly="True" Width="150" />
        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" IsReadOnly="True" Width="140" />
        <DataGridTextColumn Header="What changes" Binding="{Binding Summary}" IsReadOnly="True" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
