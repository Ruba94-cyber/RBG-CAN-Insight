<Window x:Class="RbgCanInsight.App.TraceHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        Title="Trace health"
        Width="980" Height="600"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Trace health" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TraceHealthSummary}" Style="{StaticResource MutedText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Open selected" Click="OnOpenLargestGapClick" Margin="0,0,8,0"
                  ToolTip="Jump to the frame where the selected timing incident happened" />
          <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10" Height="70">
      <StackPanel>
        <TextBlock Text="Timing incidents over the trace timeline — height and color mark severity"
                   Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4" />
        <controls:TraceHealthTimelineControl
            ItemsSource="{Binding TraceHealthRows}"
            TraceStartNanoseconds="{Binding TraceHealthTimelineStartNanoseconds}"
            TraceEndNanoseconds="{Binding TraceHealthTimelineEndNanoseconds}"
            Height="42" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="Every incident below, in the order it happened — not grouped by signal"
               Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,6" />

    <DataGrid x:Name="HealthGrid"
              ItemsSource="{Binding TraceHealthRows}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              SelectionMode="Single"
              MouseDoubleClick="OnHealthRowDoubleClick"
              FontFamily="Consolas"
              FontSize="12.5">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="60" MinWidth="60" />
        <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="45" MinWidth="45" />
        <DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="ECU/TX" Binding="{Binding Ecu}" Width="105" MinWidth="105" />
        <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="1.1*" MinWidth="150" />
        <DataGridTextColumn Header="Gap ms" Binding="{Binding GapText}" Width="85" MinWidth="85" />
        <DataGridTextColumn Header="Avg ms" Binding="{Binding AveragePeriodText}" Width="85" MinWidth="85" />
        <DataGridTextColumn Header="Ratio" Binding="{Binding GapRatioText}" Width="70" MinWidth="70" />
        <DataGridTextColumn Header="Missing" Binding="{Binding EstimatedMissingFrames}" Width="70" MinWidth="70" />
        <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="1.7*" MinWidth="320" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
