<Window x:Class="RbgCanInsight.App.SignalOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        Title="Signal overlay"
        Width="1100" Height="700"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="overlay.window">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Signal overlay" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Header}" Style="{StaticResource MutedText}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Signal" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal}" DisplayMemberPath="Display"
                      MinWidth="320" AutomationProperties.AutomationId="overlay.signal" AutomationProperties.Name="Signal to overlay" />
            <TextBlock Text="Tolerance" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Text="{Binding ToleranceText, UpdateSourceTrigger=LostFocus}" Width="80"
                     AutomationProperties.AutomationId="overlay.tolerance" AutomationProperties.Name="Value tolerance" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Open frame in Trace" Command="{Binding OpenFrameCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Open the selected loaded-trace frame in the Trace view"
                  AutomationProperties.AutomationId="overlay.openFrame" />
          <Button Content="Close" Click="OnCloseClick" AutomationProperties.AutomationId="overlay.close" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="2,0,0,4"
               AutomationProperties.AutomationId="overlay.summary" AutomationProperties.LiveSetting="Polite" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Alignment}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
               FontSize="11" Margin="2,0,0,8" AutomationProperties.AutomationId="overlay.alignment" />

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="8" Height="240" Margin="0,0,0,10">
      <controls:SignalOverlayPlotControl Result="{Binding Result}" AutomationProperties.AutomationId="overlay.plot"
                                         AutomationProperties.Name="Reference and loaded trace signal plot" />
    </Border>

    <DataGrid ItemsSource="{Binding Differences}" SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" SelectionMode="Single"
              MouseDoubleClick="OnRowDoubleClick" FontSize="12.5"
              AutomationProperties.AutomationId="overlay.grid" AutomationProperties.Name="Largest differences">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time [s]" Binding="{Binding TimeText}" Width="120" />
        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceText}" Width="140" />
        <DataGridTextColumn Header="Loaded" Binding="{Binding LoadedText}" Width="140" />
        <DataGridTextColumn Header="Δ (loaded − reference)" Binding="{Binding DeltaText}" Width="180" />
        <DataGridTextColumn Header="Frame in loaded trace" Binding="{Binding FrameText}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
