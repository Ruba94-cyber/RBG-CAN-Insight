<Window x:Class="RbgCanInsight.App.SpecTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spec vs trace"
        Width="1120" Height="620"
        MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="specTrace.window">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Spec vs trace" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="specTrace.summary" />
          <TextBlock Text="{Binding Limitations}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     FontSize="11" Margin="0,6,0,0" AutomationProperties.AutomationId="specTrace.limitations" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Open frame in Trace" Command="{Binding OpenFrameCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Open the first proving frame in the Trace view"
                  AutomationProperties.AutomationId="specTrace.openFrame" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="specTrace.refresh" />
          <Button Content="Close" Click="OnCloseClick" AutomationProperties.AutomationId="specTrace.close" />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="FindingsGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              SelectionMode="Single"
              MouseDoubleClick="OnRowDoubleClick"
              FontSize="12.5"
              AutomationProperties.AutomationId="specTrace.grid"
              AutomationProperties.Name="Declared versus observed diagnostic findings">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Finding" Binding="{Binding KindText}" Width="210" />
        <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="170" />
        <DataGridTextColumn Header="Count" Binding="{Binding CountText}" Width="70" />
        <DataGridTextColumn Header="Source frames" Binding="{Binding FramesText}" Width="170" />
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
        <DataGridTextColumn Header="Caveat" Binding="{Binding Caveat}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
