<Window x:Class="RbgCanInsight.App.CatalogCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalog consistency check"
        Width="1080" Height="600"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="catalogCheck.window">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Catalog consistency check" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="catalogCheck.summary" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                     Text="Checks the loaded CDD / ODX / PDX descriptions with the documented CAT-0xx rules. It reviews the description file only: no ECU access, and a clean result is not a schema validation." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Run again" Click="OnRunClick" Margin="0,0,8,0" Padding="10,3"
                  AutomationProperties.AutomationId="catalogCheck.run" />
          <Button x:Name="ExportButton" Content="Export CSV" Click="OnExportClick" Margin="0,0,8,0" Padding="10,3"
                  IsEnabled="False" AutomationProperties.AutomationId="catalogCheck.export" />
          <Button Content="Close" Click="OnCloseClick" Padding="10,3" AutomationProperties.AutomationId="catalogCheck.close" />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="FindingsGrid"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              SelectionMode="Single"
              EnableRowVirtualization="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              FontSize="12.5"
              AutomationProperties.AutomationId="catalogCheck.grid"
              AutomationProperties.Name="Catalog consistency check findings">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75" />
        <DataGridTextColumn Header="Rule" Binding="{Binding Rule.Id}" Width="70" />
        <DataGridTextColumn Header="Check" Binding="{Binding Rule.Title}" Width="210" />
        <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="100" />
        <DataGridTextColumn Header="Object" Binding="{Binding Subject}" Width="230" />
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
