<Window x:Class="RbgCanInsight.App.DerivedSignalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RbgCanInsight.App.Controls"
        Title="Derived signals"
        Width="980" Height="760"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="derived.window"
        AutomationProperties.Name="Derived signals">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Derived signals" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding OfflineNoteText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="derived.offlineNote" />
        <TextBlock Text="Expression" FontWeight="SemiBold" Margin="0,10,0,4" />
        <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14"
                 AutomationProperties.AutomationId="derived.expression"
                 AutomationProperties.Name="Derived signal expression" />
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="derived.error"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding CheatSheetText}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="derived.cheatsheet" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Examples:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ItemsControl ItemsSource="{Binding Examples}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}" Margin="0,0,6,0" Padding="8,2" FontFamily="Consolas"
                        Command="{Binding DataContext.ExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.AutomationId="{Binding StringFormat=derived.example.{0}}"
                        AutomationProperties.Name="{Binding StringFormat=Use example expression {0}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Variables: pick the recorded signal behind each name" FontWeight="SemiBold" />
        <TextBlock Text="Type in a box to search by message, signal, channel or DBC name."
                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Variables}" MaxHeight="150"
                      AutomationProperties.AutomationId="derived.variables" AutomationProperties.Name="Expression variables">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          ItemsSource="{Binding FilteredChoices}" DisplayMemberPath="Display"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding AutomationName}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Add to main chart" Click="OnAddToMainChart" Margin="0,0,8,0" Padding="10,4"
                AutomationProperties.AutomationId="derived.addToChart"
                AutomationProperties.Name="Add the derived signal to the main chart (computed, not recorded)" />
        <Button Content="Open in Quick Plot" Click="OnOpenQuickPlot" Margin="0,0,8,0" Padding="10,4"
                AutomationProperties.AutomationId="derived.quickplot"
                AutomationProperties.Name="Open the derived signal in Quick Plot (not recorded)" />
        <Button Content="Export CSV…" Click="OnExportCsv" Margin="0,0,8,0" Padding="10,4"
                AutomationProperties.AutomationId="derived.export"
                AutomationProperties.Name="Export the derived signal as CSV" />
        <Button Content="Close" Click="OnCloseClick" Padding="10,4"
                AutomationProperties.AutomationId="derived.close" AutomationProperties.Name="Close the derived signals window" />
      </StackPanel>
      <Button Content="Preview" Command="{Binding PreviewCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
              Padding="14,4" Margin="0,0,12,0"
              AutomationProperties.AutomationId="derived.preview" AutomationProperties.Name="Preview the derived signal" />
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                 AutomationProperties.AutomationId="derived.status" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatsText}" FontWeight="SemiBold" Margin="2,8,0,0" TextWrapping="Wrap"
               AutomationProperties.AutomationId="derived.stats"
               AutomationProperties.LiveSetting="Polite" />
    <Border Style="{StaticResource Card}" Padding="8">
      <controls:DerivedPreviewChart Series="{Binding Result}" MinHeight="180"
                                    AutomationProperties.AutomationId="derived.chart"
                                    AutomationProperties.Name="Derived signal preview chart" />
    </Border>
  </DockPanel>
</Window>
