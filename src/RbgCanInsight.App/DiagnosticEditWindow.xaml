<Window x:Class="RbgCanInsight.App.DiagnosticEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit diagnostic text"
        Width="760" Height="470"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png"
        AutomationProperties.AutomationId="diagnosticEdit.window">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Edit diagnostic text" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Header}" Style="{StaticResource MutedText}" AutomationProperties.AutomationId="diagnosticEdit.header" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Only the display name and description of this definition can change. The result is written to a new file, reloaded and compared with the original; unknown vendor content is kept and the source file is never modified." />
      </StackPanel>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick" Margin="8,0,0,0" AutomationProperties.AutomationId="diagnosticEdit.close" />
      <Button DockPanel.Dock="Right" Content="Save edited copy…" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
              AutomationProperties.Name="Save the edited description as a new file" AutomationProperties.AutomationId="diagnosticEdit.save" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 AutomationProperties.AutomationId="diagnosticEdit.status" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>

    <StackPanel>
      <TextBlock Text="Display name (long name)" Margin="0,0,0,4" />
      <TextBox Text="{Binding LongName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFile}"
               AutomationProperties.Name="Display name" AutomationProperties.AutomationId="diagnosticEdit.longName" />
      <TextBlock Text="Description" Margin="0,12,0,4" />
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFile}"
               AcceptsReturn="False" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Description" AutomationProperties.AutomationId="diagnosticEdit.description" />
    </StackPanel>
  </DockPanel>
</Window>
