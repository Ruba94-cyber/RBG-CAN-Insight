<Window x:Class="RbgCanInsight.App.PresetLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:RbgCanInsight.App.Common"
        Title="Load workspace preset"
        Width="680" Height="440"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/RbgCanInsight.png">
  <Window.Resources>
    <common:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <common:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Load workspace preset" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Presets you've saved before, most recent first. UI state only — no files are loaded. Double-click a name to rename it." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Browse for file..." Click="OnBrowseClick" Margin="0,0,8,0"
              ToolTip="Load a .rbgpreset file that isn't in this list yet" />
      <Button Content="Close" Click="OnCloseClick" />
    </StackPanel>

    <Grid>
      <TextBlock Text="No saved presets yet. Use &quot;Save preset&quot; in the sidebar, or Browse for an existing file."
                 Style="{StaticResource MutedText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding HasPresetLibraryEntries, Converter={StaticResource VisibleWhenFalse}, FallbackValue=Collapsed}" />
      <DataGrid x:Name="LibraryGrid" ItemsSource="{Binding PresetLibraryEntries}"
                AutoGenerateColumns="False" CanUserSortColumns="True" SelectionMode="Single"
                FontSize="12.5"
                Visibility="{Binding HasPresetLibraryEntries, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="*" MinWidth="200" />
          <DataGridTextColumn Header="Saved" Binding="{Binding SavedAtText}" Width="150" MinWidth="150" IsReadOnly="True" />
          <DataGridTemplateColumn Header="" Width="150" MinWidth="150" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Load" Click="OnLoadClick" Padding="10,2" Margin="0,0,6,0" />
                  <Button Content="Remove" Click="OnRemoveClick" Padding="10,2" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
